---
const links = [
  { href: "/", label: "Work" },
  { href: "/about", label: "About" },
];
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-border bg-background/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="font-medium tracking-tight">Hum Rashid</a>
    <ul class="flex items-center gap-6">
      {
        links.map((link) => {
          const isActive =
            link.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={isActive ? "page" : undefined}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
