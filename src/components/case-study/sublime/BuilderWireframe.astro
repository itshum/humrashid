---
// Early builder layout study. All content is dummy.
const templateRows = [68, 52, 60];
---

<div class="bw-stage" role="img" aria-label="Low-fidelity builder wireframe with campaign details, audience, and simulation training on the left, and a simple template list on the right">
  <div class="bw-window" aria-hidden="true">
    <div class="bw-head"><span>Campaign builder</span><span class="bw-head-actions"><i></i><i></i></span></div>
    <div class="bw-body">
      <div class="bw-form">
        <div class="bw-section">
          <span class="bw-section-title">Campaign details</span>
          <div class="bw-field"><span class="bw-label">Name</span><span class="bw-input"></span></div>
          <div class="bw-row">
            <div class="bw-field"><span class="bw-label">Start</span><span class="bw-input"></span></div>
            <div class="bw-field"><span class="bw-label">Duration</span><span class="bw-input"></span></div>
          </div>
        </div>
        <div class="bw-section">
          <span class="bw-section-title">Audience</span>
          <div class="bw-field"><span class="bw-label">Audience type</span><span class="bw-input"></span></div>
          <div class="bw-field"><span class="bw-label">Lists</span><span class="bw-input bw-input--chips"><i></i><i></i><i></i></span></div>
        </div>
        <div class="bw-section">
          <span class="bw-section-title">Simulation training</span>
          <div class="bw-field"><span class="bw-label">Notice page</span><span class="bw-input"></span></div>
          <div class="bw-training-row" style="display:flex;align-items:center;justify-content:space-between;font-size:max(6px,1.75cqw);color:#72726f"><span>Assign training</span><span class="bw-toggle" style="display:block;width:5cqw;height:2.8cqw;border:1.5px dashed #a8a8a3;border-radius:99px;background:#fff"></span></div>
        </div>
      </div>
      <div class="bw-list">
        <div class="bw-list-head"><span>Template list</span><span class="bw-plus">＋</span></div>
        {templateRows.map((width) => (
          <div class="bw-template-row">
            <span class="bw-box"></span>
            <span class="bw-template-lines"><i style={`width: ${width}%`}></i><i style={`width: ${width - 24}%`}></i></span>
          </div>
        ))}
        <div class="bw-add"><span>＋</span><i></i></div>
      </div>
    </div>
  </div>
</div>

<style>
  .bw-stage {
    container-type: inline-size;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 5cqw;
    overflow: hidden;
    border-radius: 4px;
    background: #e9e9e7;
    color: #4c4c4a;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    color-scheme: light;
  }

  .bw-window {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1.5px solid #777774;
    border-radius: 1cqw;
    background: #fdfdfc;
    box-shadow: 0 0.5cqw 1.2cqw #00000010;
  }

  .bw-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 8cqw;
    padding: 0 2cqw;
    border-bottom: 1.5px dashed #9d9d99;
    font-size: max(8px, 2.5cqw);
    font-weight: 500;
  }

  .bw-head-actions { display: flex; gap: 1cqw; }
  .bw-head-actions i { width: 3.5cqw; height: 1.5cqw; border: 1px dashed #9d9d99; border-radius: 0.4cqw; }

  .bw-body { display: grid; grid-template-columns: 46% 54%; height: calc(100% - 8cqw); }

  .bw-form { padding: 2.5cqw; border-right: 1.5px dashed #a9a9a5; }

  .bw-section + .bw-section { margin-top: 3cqw; padding-top: 2.5cqw; border-top: 1px dashed #b6b6b2; }

  .bw-section-title {
    display: block;
    margin-bottom: 2cqw;
    font-size: max(7px, 2.2cqw);
    font-weight: 600;
  }

  .bw-field { display: flex; flex-direction: column; gap: 0.8cqw; min-width: 0; margin-bottom: 1.8cqw; }
  .bw-label { font-size: max(6px, 1.75cqw); color: #72726f; }

  .bw-input {
    display: block;
    height: 5cqw;
    border: 1.5px dashed #a8a8a3;
    border-radius: 0.6cqw;
    background: #fff;
  }

  .bw-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4cqw; }

  .bw-input--chips { display: flex; align-items: center; gap: 0.8cqw; padding: 0 1cqw; }
  .bw-input--chips i { width: 24%; height: 2.2cqw; border-radius: 0.4cqw; background: #d6d6d2; }
  .bw-input--chips i:nth-child(2) { width: 19%; }
  .bw-input--chips i:nth-child(3) { width: 22%; }


  .bw-list { padding: 2.5cqw; }

  .bw-list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.8cqw; font-size: max(7px, 2.2cqw); font-weight: 600; }
  .bw-plus { font-size: 3.3cqw; font-weight: 400; line-height: 0.7; }

  .bw-template-row {
    display: flex;
    align-items: center;
    gap: 1.7cqw;
    height: 10.2cqw;
    margin-bottom: 1.3cqw;
    padding: 0 2cqw;
    border: 1.5px dashed #b0b0ac;
    border-radius: 0.6cqw;
    background: #fff;
  }

  .bw-box { flex: none; width: 5cqw; height: 5cqw; border: 1.5px dashed #b0b0ac; border-radius: 0.4cqw; }
  .bw-template-lines { display: flex; flex: 1; flex-direction: column; gap: 1cqw; }
  .bw-template-lines i { display: block; height: 1.3cqw; border-radius: 99px; background: #a4a4a0; }
  .bw-template-lines i + i { height: 1cqw; background: #d6d6d2; }

  .bw-add { display: flex; align-items: center; gap: 1.5cqw; height: 6cqw; padding: 0 2cqw; border: 1.5px dashed #b0b0ac; border-radius: 0.6cqw; }
  .bw-add span { font-size: 3cqw; line-height: 1; color: #92928e; }
  .bw-add i { width: 30%; height: 1.1cqw; border-radius: 99px; background: #d6d6d2; }
</style>
