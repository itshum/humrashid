---
interface Slide {
  src: string;
  alt: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const uid = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="carousel" id={uid} data-reveal>
  <div class="carousel-viewport">
    <div class="carousel-track">
      {
        slides.map((slide) => (
          <div class="carousel-slide">
            <img src={slide.src} alt={slide.alt} draggable="false" />
          </div>
        ))
      }
    </div>
  </div>

  <div class="carousel-nav">
    <button type="button" class="carousel-btn carousel-prev" aria-label="Previous image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5" />
        <path d="M11 18l-6-6 6-6" />
      </svg>
    </button>
    <button type="button" class="carousel-btn carousel-next" aria-label="Next image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="M13 18l6-6-6-6" />
      </svg>
    </button>
  </div>
</div>

<style is:global>
  /* Full width, padded to the topbar's gutter - same footprint as
     .hero-media so a carousel and a static cover image read as the
     same size on the page. */
  .carousel {
    margin-top: 4rem;
    padding: 0 2rem;
  }

  .carousel-viewport {
    position: relative;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: 20px;
    cursor: grab;
    touch-action: pan-y;
  }

  .carousel-track.dragging {
    cursor: grabbing;
  }

  /* 2/3 preview of the current slide, 1/3 peek of the next one. */
  .carousel-slide {
    flex: 0 0 calc((100% - 20px) * 2 / 3);
    user-select: none;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    border-radius: 4px;
    pointer-events: none;
  }

  .carousel-nav {
    display: flex;
    gap: 10px;
    margin-top: 1rem;
  }

  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 100px;
    border: 1px solid var(--border, #e2e0da);
    background: transparent;
    color: var(--text, #262626);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .carousel-btn:hover {
    background: var(--hover-bg, #eae9e5);
    border-color: var(--icon, #d8d6d0);
  }

  .carousel-btn svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 640px) {
    .carousel-slide {
      flex-basis: calc(100% - 40px);
    }
  }
</style>

<script>
  class CarouselController {
    root: HTMLElement;
    track: HTMLElement;
    slides: HTMLElement[];
    prevBtn: HTMLButtonElement;
    nextBtn: HTMLButtonElement;
    realCount: number;
    index = 1;
    dragStartX = 0;
    dragCurrentX = 0;
    baseOffset = 0;
    dragging = false;
    pointerId: number | null = null;

    constructor(root: HTMLElement) {
      this.root = root;
      this.track = root.querySelector(".carousel-track")!;
      this.prevBtn = root.querySelector(".carousel-prev")!;
      this.nextBtn = root.querySelector(".carousel-next")!;

      // Clone the first and last real slides onto the opposite ends of
      // the track so advancing past either edge keeps sliding into a
      // (visually identical) clone instead of snapping backward - once
      // its transition finishes we jump to the real slide with no
      // animation, invisibly to the viewer.
      const originals = [...root.querySelectorAll<HTMLElement>(".carousel-slide")];
      this.realCount = originals.length;

      const firstClone = originals[0].cloneNode(true) as HTMLElement;
      const lastClone = originals[originals.length - 1].cloneNode(true) as HTMLElement;
      firstClone.setAttribute("aria-hidden", "true");
      lastClone.setAttribute("aria-hidden", "true");

      this.track.insertBefore(lastClone, originals[0]);
      this.track.appendChild(firstClone);

      this.slides = [...root.querySelectorAll<HTMLElement>(".carousel-slide")];

      this.prevBtn.addEventListener("click", () => this.go(-1));
      this.nextBtn.addEventListener("click", () => this.go(1));

      this.track.addEventListener("pointerdown", this.onPointerDown);
      this.track.addEventListener("pointermove", this.onPointerMove);
      this.track.addEventListener("pointerup", this.onPointerUp);
      this.track.addEventListener("pointercancel", this.onPointerUp);
      this.track.addEventListener("transitionend", this.onTransitionEnd);

      window.addEventListener("resize", () => this.setTransform(false));

      this.setTransform(false);
    }

    slideStep() {
      const slide = this.slides[0];
      const gap = 20;
      return slide.getBoundingClientRect().width + gap;
    }

    // Guards against rapid clicks outrunning the async transitionend
    // correction below: if we're still sitting on a clone when a new
    // move is requested, resolve that jump instantly (with a forced
    // reflow) before animating the new one, so the index never drifts
    // outside the real+clone range.
    snapIfOnClone() {
      if (this.index === this.realCount + 1) {
        this.index = 1;
        this.setTransform(false);
        this.track.offsetHeight;
      } else if (this.index === 0) {
        this.index = this.realCount;
        this.setTransform(false);
        this.track.offsetHeight;
      }
    }

    go(direction: number) {
      this.snapIfOnClone();
      this.index += direction;
      this.setTransform(true);
    }

    onTransitionEnd = () => {
      this.snapIfOnClone();
    };

    setTransform(animate: boolean) {
      this.baseOffset = -this.index * this.slideStep();
      this.track.style.transition = animate ? "transform 0.35s ease" : "none";
      this.track.style.transform = `translateX(${this.baseOffset}px)`;
    }

    onPointerDown = (e: PointerEvent) => {
      this.dragging = true;
      this.pointerId = e.pointerId;
      this.track.setPointerCapture(e.pointerId);
      this.dragStartX = e.clientX;
      this.dragCurrentX = e.clientX;
      this.track.style.transition = "none";
      this.track.classList.add("dragging");
    };

    onPointerMove = (e: PointerEvent) => {
      if (!this.dragging || e.pointerId !== this.pointerId) return;
      this.dragCurrentX = e.clientX;
      const delta = this.dragCurrentX - this.dragStartX;
      this.track.style.transform = `translateX(${this.baseOffset + delta}px)`;
    };

    onPointerUp = (e: PointerEvent) => {
      if (!this.dragging || e.pointerId !== this.pointerId) return;
      this.dragging = false;
      this.track.classList.remove("dragging");

      const delta = this.dragCurrentX - this.dragStartX;
      const threshold = this.slideStep() * 0.2;

      if (delta < -threshold) {
        this.go(1);
      } else if (delta > threshold) {
        this.go(-1);
      } else {
        this.setTransform(true);
      }
    };
  }

  document.querySelectorAll<HTMLElement>(".carousel").forEach((el) => new CarouselController(el));
</script>
