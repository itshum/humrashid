---
interface Props {
  showBack?: boolean;
}

const { showBack = false } = Astro.props;
---

<div class="topbar">
  <span class="logo-mark" id="logo-mark" aria-hidden="true"></span>
  {
    showBack && (
      <a class="back-link" href="/">
        <span class="arrow">←</span>
        Back
      </a>
    )
  }
</div>

<style is:global>
  /* Full-width bar, independent of any centered column below it, so the
     logo mark sits flush against the real page edge on every page - and
     the back link, when present, mirrors it flush on the right. */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem 2rem 0;
  }

  .logo-mark {
    display: inline-grid;
    grid-template-columns: repeat(4, 8.5px);
    grid-template-rows: repeat(4, 8.5px);
    gap: 4px;
  }

  .logo-mark .px {
    width: 5.5px;
    height: 5.5px;
    opacity: 0;
    transform: scale(0.3);
    transition: opacity 0.25s ease, transform 0.25s ease, background 0.2s ease;
  }

  .logo-mark .px.in {
    opacity: 1;
    transform: scale(1);
  }

  /* Ghost button - transparent until hover, then fills in with the same
     highlight used by the homepage's work-row hover state. */
  .topbar .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #8a8a8a;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .topbar .back-link:hover {
    background: #eae9e5;
    color: #262626;
  }

  .topbar .back-link .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .topbar .back-link:hover .arrow {
    transform: translateX(-2px);
  }
</style>

<script>
  // 4x4 grid, freshly randomized on every load - no fixed pattern, no
  // session gating. Grey filler cells are just there, already in place;
  // only the dark green letterform cells animate in, staggered pixel by
  // pixel. Cells also reroll as the cursor moves around the topbar.
  const LETTER_COLOR = "#1f3d2e";
  const FILLER_COLOR = "#dcdcd8";
  const LETTER_CHANCE = 0.45;
  const CELL_COUNT = 16;
  const TOTAL_DURATION_MS = 1200;

  const logoEl = document.getElementById("logo-mark");
  const perCellDelay = TOTAL_DURATION_MS / CELL_COUNT;

  if (logoEl) {
    for (let i = 0; i < CELL_COUNT; i++) {
      const px = document.createElement("span");
      px.className = "px";
      const isLetter = Math.random() < LETTER_CHANCE;
      px.style.background = isLetter ? LETTER_COLOR : FILLER_COLOR;
      if (!isLetter) px.classList.add("in");
      logoEl.appendChild(px);
      if (isLetter) setTimeout(() => px.classList.add("in"), i * perCellDelay);
    }

    const topbarEl = document.querySelector(".topbar");
    let lastShuffle = 0;
    const SHUFFLE_INTERVAL_MS = 90;

    topbarEl?.addEventListener("mousemove", () => {
      const now = performance.now();
      if (now - lastShuffle < SHUFFLE_INTERVAL_MS) return;
      lastShuffle = now;

      const cells = logoEl.children;
      const shuffleCount = 1 + Math.floor(Math.random() * 2);
      for (let n = 0; n < shuffleCount; n++) {
        const cell = cells[Math.floor(Math.random() * cells.length)];
        cell.style.background = Math.random() < LETTER_CHANCE ? LETTER_COLOR : FILLER_COLOR;
      }
    });
  }
</script>
