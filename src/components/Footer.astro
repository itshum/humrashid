<style is:global>
  /* Self-contained width/centering so this drops into any page - case
     study or otherwise -
     without depending on that page's particular .col variant. Colors
     fall back to the homepage's light-mode values for pages that
     don't define the --label/--title/--border theme variables. */
  .site-footer {
    position: relative;
    width: 100%;
    max-width: 718px;
    margin: 0 auto;
    padding: 1.75rem 1.5rem;
    /* Name and copyright on the left, the NYC clock centered, social
       icons on the right. */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-size: 0.85rem;
    color: var(--label, #8a8a8a);
    gap: 1rem;
  }

  /* Matches .col's own mobile-only bump from 1.5rem to 2rem (see
     index.astro/[slug].astro), which exists so page content lines up
     with the topbar's 2rem gutter on narrow viewports. Without this,
     the footer's text sits 8px further left than everything above it
     on mobile specifically - desktop never needed this override since
     .col and the footer both already use 1.5rem there. The matching
     ::before (shimmer line) override lives further down, after the
     base ::before rule it needs to win against - same selector
     specificity, so source order decides, and a media query earlier
     in the file loses to a plain rule later in the file regardless of
     which one actually matches the viewport. */
  @media (max-width: 600px) {
    .site-footer {
      padding: 1.75rem 2rem;
    }
  }

  /* Pearlescent shimmer line, in place of a plain border-top - a soft
     iridescent gradient (borrowed from Nessa's own footer) drifting
     slowly across the top edge instead of a static border color. */
  .site-footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 1px;
    background: repeating-linear-gradient(
      100deg,
      var(--border, #e2e0da) 0%,
      rgba(150, 130, 210, 0.55) 5%,
      rgba(120, 190, 200, 0.55) 10%,
      rgba(200, 190, 130, 0.5) 15%,
      rgba(210, 140, 180, 0.55) 20%,
      rgba(130, 170, 220, 0.55) 25%,
      var(--border, #e2e0da) 32%
    );
    background-size: 260% 100%;
    animation: site-footer-shimmer 9s linear infinite;
    opacity: 0.8;
  }

  @media (max-width: 600px) {
    .site-footer::before {
      left: 2rem;
      right: 2rem;
    }
  }

  @keyframes site-footer-shimmer {
    0% {
      background-position: 0% 0%;
    }
    100% {
      background-position: 100% 0%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer::before {
      animation: none;
    }
  }

  .site-footer .who {
    justify-self: start;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .site-footer .who .name {
    color: var(--title, #262626);
    font-weight: 500;
  }

  .site-footer .who .copyright {
    color: var(--year, #8a8a86);
  }

  .site-footer .tz {
    justify-self: center;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  /* Crossfades with the same --theme-progress the page background's
     dawn/dusk sweep uses (see Topbar.astro), so the footer carries a
     small, always-visible readout of the same transition rather than
     just the clock ticking underneath it. Falls back to a static
     light/dark swap (via :root[data-theme]) before that script runs,
     or permanently under prefers-reduced-motion. */
  .site-footer .sun-moon {
    position: relative;
    align-self: center;
    width: 13px;
    height: 13px;
  }

  .site-footer .sun-moon svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--label, #8a8a8a);
    transition: opacity 0.3s ease;
  }

  .site-footer .sun-moon .icon-sun {
    opacity: var(--theme-progress, 1);
  }

  .site-footer .sun-moon .icon-moon {
    opacity: calc(1 - var(--theme-progress, 1));
  }

  .site-footer .blink {
    animation: site-footer-blink 1s steps(1) infinite;
  }

  @keyframes site-footer-blink {
    50%,
    100% {
      opacity: 0;
    }
  }

  /* Official marks for X, GitHub and LinkedIn, plus a plain envelope
     for email, in the footer's gray and evenly spaced. */
  .site-footer .social {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .site-footer .social a {
    display: grid;
    place-items: center;
    color: var(--label, #8a8a8a);
    transition: color 0.2s ease;
  }

  .site-footer .social a:hover,
  .site-footer .social a:focus-visible {
    color: var(--title, #262626);
  }

  .site-footer .social svg {
    display: block;
    width: 15px;
    height: 15px;
  }

  /* Phones: name and icons share the top row, the clock sits below. */
  @media (max-width: 600px) {
    .site-footer {
      grid-template-columns: 1fr auto;
      row-gap: 0.85rem;
    }

    .site-footer .social {
      grid-column: 2;
      grid-row: 1;
    }

    .site-footer .tz {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: start;
    }
  }
</style>

<script>
  function initFooterClock(el: HTMLElement) {
    function updateClock() {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/New_York",
        hour: "numeric",
        minute: "2-digit",
        hour12: true,
      }).formatToParts(new Date());
      const hour = parts.find((p) => p.type === "hour")?.value ?? "-";
      const minute = parts.find((p) => p.type === "minute")?.value ?? "--";
      const period = parts.find((p) => p.type === "dayPeriod")?.value ?? "";
      el.innerHTML = `${hour}<span class="blink">:</span>${minute} ${period}`;
    }
    updateClock();
    setInterval(updateClock, 1000);
  }

  document.querySelectorAll<HTMLElement>("#nyc-time").forEach(initFooterClock);

  document.querySelectorAll<HTMLAnchorElement>(".site-footer a[data-user]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      window.location.href = `mailto:${link.dataset.user}@${link.dataset.domain}`;
    });
  });
</script>
