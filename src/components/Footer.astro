<footer class="site-footer">
  <span class="who">
    <span class="name">Humayun Rashid</span>
    <span class="copyright">© 2026</span>
  </span>
  <span class="tz">
    <span>NYC</span>
    <span id="nyc-time">—:— —</span>
  </span>
  <span class="links">
    <a href="https://www.linkedin.com/in/humayunrashid/" target="_blank" rel="noopener">LinkedIn</a>
    <a href="https://github.com/itshum" target="_blank" rel="noopener">Github</a>
    <a href="https://mail.google.com/mail/?view=cm&fs=1&to=hum@nessalab.com" target="_blank" rel="noopener">Email</a>
    <a href="/humayun-rashid-resume.pdf" target="_blank" rel="noopener" type="application/pdf">CV</a>
  </span>
</footer>

<style is:global>
  /* Self-contained width/centering (matching the homepage's own .col
     measure) so this drops into any page - case study or otherwise -
     without depending on that page's particular .col variant. Colors
     fall back to the homepage's light-mode values for pages that
     don't define the --label/--title/--border theme variables. */
  .site-footer {
    position: relative;
    max-width: 718px;
    margin: 0 auto;
    padding: 1.75rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-size: 0.85rem;
    color: var(--label, #8a8a8a);
    gap: 1rem;
  }

  /* Matches .col's own mobile-only bump from 1.5rem to 2rem (see
     index.astro/[slug].astro), which exists so page content lines up
     with the topbar's 2rem gutter on narrow viewports. Without this,
     the footer's text sits 8px further left than everything above it
     on mobile specifically - desktop never needed this override since
     .col and the footer both already use 1.5rem there. The matching
     ::before (shimmer line) override lives further down, after the
     base ::before rule it needs to win against - same selector
     specificity, so source order decides, and a media query earlier
     in the file loses to a plain rule later in the file regardless of
     which one actually matches the viewport. */
  @media (max-width: 600px) {
    .site-footer {
      padding: 1.75rem 2rem;
    }
  }

  /* Pearlescent shimmer line, in place of a plain border-top - a soft
     iridescent gradient (borrowed from Nessa's own footer) drifting
     slowly across the top edge instead of a static border color. */
  .site-footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 1px;
    background: repeating-linear-gradient(
      100deg,
      var(--border, #e2e0da) 0%,
      rgba(150, 130, 210, 0.55) 5%,
      rgba(120, 190, 200, 0.55) 10%,
      rgba(200, 190, 130, 0.5) 15%,
      rgba(210, 140, 180, 0.55) 20%,
      rgba(130, 170, 220, 0.55) 25%,
      var(--border, #e2e0da) 32%
    );
    background-size: 260% 100%;
    animation: site-footer-shimmer 9s linear infinite;
    opacity: 0.8;
  }

  @media (max-width: 600px) {
    .site-footer::before {
      left: 2rem;
      right: 2rem;
    }
  }

  @keyframes site-footer-shimmer {
    0% {
      background-position: 0% 0%;
    }
    100% {
      background-position: 100% 0%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer::before {
      animation: none;
    }
  }

  .site-footer .who {
    justify-self: start;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .site-footer .who .name {
    color: var(--title, #262626);
    font-weight: 500;
  }

  .site-footer .who .copyright {
    color: var(--year, #8a8984);
  }

  .site-footer .tz {
    justify-self: center;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .site-footer .blink {
    animation: site-footer-blink 1s steps(1) infinite;
  }

  @keyframes site-footer-blink {
    50%,
    100% {
      opacity: 0;
    }
  }

  .site-footer .links {
    justify-self: end;
    display: flex;
    gap: 0.9rem;
  }

  .site-footer a {
    text-decoration: none;
    color: inherit;
  }

  .site-footer a:hover {
    color: var(--title, #262626);
  }

  /* Placed after the .who/.tz/.links justify-self rules above (same
     specificity, so source order decides) rather than near the top
     of the file, or it would lose to those later desktop rules at
     every viewport width the media query also matches. */
  /* Two rows instead of three: name+copyright and the clock share a
     row (name pinned left, clock pinned right via the 1fr/auto
     columns), links get their own full-width row below, left-aligned
     under the name rather than centered under the whole footer. */
  @media (max-width: 600px) {
    .site-footer {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      justify-items: start;
      row-gap: 0.85rem;
      column-gap: 1rem;
    }

    .site-footer .who {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }

    .site-footer .tz {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .site-footer .links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: start;
    }
  }
</style>

<script>
  function initFooterClock(el: HTMLElement) {
    function updateClock() {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/New_York",
        hour: "numeric",
        minute: "2-digit",
        hour12: true,
      }).formatToParts(new Date());
      const hour = parts.find((p) => p.type === "hour")?.value ?? "-";
      const minute = parts.find((p) => p.type === "minute")?.value ?? "--";
      const period = parts.find((p) => p.type === "dayPeriod")?.value ?? "";
      el.innerHTML = `${hour}<span class="blink">:</span>${minute} ${period}`;
    }
    updateClock();
    setInterval(updateClock, 1000);
  }

  document.querySelectorAll<HTMLElement>("#nyc-time").forEach(initFooterClock);
</script>
