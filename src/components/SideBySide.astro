---
interface Slide {
  src: string;
  alt: string;
}

interface Props {
  left: Slide;
  right: Slide;
}

const { left, right } = Astro.props;
---

<div class="side-by-side" data-reveal>
  <div class="side-by-side-item">
    <img src={left.src} alt={left.alt} />
  </div>
  <div class="side-by-side-item">
    <img src={right.src} alt={right.alt} />
  </div>
</div>

<style is:global>
  /* Narrower than the full-bleed cover image on purpose - these tend
     to be tall phone screenshots, so a narrower column keeps their
     height in check rather than stretching them across the full
     gutter width. */
  .side-by-side {
    max-width: 700px;
    margin: 4rem auto 0;
    padding: 0 1.5rem;
    display: flex;
    gap: 40px;
  }

  .side-by-side-item {
    flex: 1 1 0;
    min-width: 0;
  }

  .side-by-side-item img {
    display: block;
    width: 100%;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .side-by-side {
      flex-direction: column;
      gap: 24px;
    }
  }
</style>
