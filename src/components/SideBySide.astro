---
interface Slide {
  src: string;
  alt: string;
}

interface Props {
  left: Slide;
  right: Slide;
}

const { left, right } = Astro.props;
---

<div class="side-by-side">
  <div class="side-by-side-item">
    <img src={left.src} alt={left.alt} />
  </div>
  <div class="side-by-side-item">
    <img src={right.src} alt={right.alt} />
  </div>
</div>

<style is:global>
  /* Full width, padded to the topbar's gutter - same footprint as
     .hero-media/.carousel so every media block on the page reads as
     the same size regardless of layout. */
  .side-by-side {
    margin-top: 4rem;
    padding: 0 2rem;
    display: flex;
    gap: 20px;
  }

  .side-by-side-item {
    flex: 1 1 0;
    min-width: 0;
  }

  .side-by-side-item img {
    display: block;
    width: 100%;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .side-by-side {
      flex-direction: column;
    }
  }
</style>
