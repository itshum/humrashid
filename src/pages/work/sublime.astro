---
// Sublime Security: Phishing Simulations. Standalone rather than a
// content collection entry because its phase sections and interactive
// pieces don't fit the fixed slots in [slug].astro. Styles mirror that
// template so the two read as one system.
//
// Not published yet: noindex, excluded from the sitemap, and not linked
// from anywhere. Content lives inside #case-study so a password gate
// can wrap or replace it later without restructuring the page.
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/Footer.astro";
import MediaSlot from "../../components/case-study/sublime/MediaSlot.astro";
import FeatureEvolutionGrid from "../../components/case-study/sublime/FeatureEvolutionGrid.tsx";
import TtpDiagram from "../../components/case-study/sublime/TtpDiagram.astro";
import TrainingToggle from "../../components/case-study/sublime/TrainingToggle.tsx";
import RepeatClicks from "../../components/case-study/sublime/RepeatClicks.tsx";
import CampaignBuilder from "../../components/case-study/sublime/CampaignBuilder.tsx";
import AiGenerateStepper from "../../components/case-study/sublime/AiGenerateStepper.tsx";
import ExecutiveDashboard from "../../components/case-study/sublime/ExecutiveDashboard.tsx";
import Analytics from "@vercel/analytics/astro";
import { getCollection } from "astro:content";

const IMG = "/case-studies/sublime";

const moreWorkOrder = ["pack", "inveterate", "ppvp"];
const moreWork = (await getCollection("caseStudies"))
  .filter((cs) => moreWorkOrder.includes(cs.id))
  .sort((a, b) => moreWorkOrder.indexOf(a.id) - moreWorkOrder.indexOf(b.id));

const title = "Dynamic Phishing Simulations";
const summary =
  "Turning a standalone phishing test into a product grounded in the attacks each customer actually faces.";
---

<!doctype html>
<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/work/sublime" />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <style is:inline>
      html[data-theme="dark"] {
        background: #16171c;
        color: #eeede8;
      }
      html:not([data-theme="dark"]) {
        background: #f6f6f3;
        color: #262626;
      }
    </style>
    <title>{title} · Humayun Rashid</title>
    <meta name="description" content={summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
    />
    <style is:global>
      /* Same tokens as [slug].astro and the homepage. */
      :root {
        --bg: #f6f6f3;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #e8e7e2;
        --title: #262626;
        --year: #8a8984;
        --icon: #c9c7c0;
        --icon-hover: #6b6b6b;
        --border: #e0ded7;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #a1a09a;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --icon: #474641;
        --icon-hover: #b5b4ad;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scrollbar-color: var(--border) var(--bg);
      }

      html::-webkit-scrollbar-track {
        background: var(--bg);
      }

      html::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 8px;
      }

      html::-webkit-scrollbar-thumb:hover {
        background: var(--label);
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col {
          padding: 0 2rem;
        }
      }

      /* Wider than .col for pieces that need more measure (the phase
         grid, the diagram, image pairs) but capped short of full bleed. */
      .wide {
        max-width: 1000px;
        margin: 3.5rem auto;
        padding: 0 2rem;
      }

      @media (max-width: 600px) {
        .wide {
          padding: 0 1.25rem;
        }
      }

      .hero {
        text-align: center;
        padding: 4.2rem 0 3.5rem;
      }

      .hero .eyebrow {
        font-size: 0.8rem;
        color: var(--label);
        margin: 0 0 1.25rem;
      }

      .hero h1 {
        font-size: 2.5rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        margin: 0 0 1.25rem;
        text-wrap: balance;
      }

      @media (max-width: 600px) {
        .hero h1 {
          font-size: 2rem;
        }
      }

      .hero .summary {
        font-size: 1.15rem;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 42ch;
        margin: 0 auto;
      }

      .meta-row {
        display: flex;
        justify-content: center;
        gap: 3.5rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
      }

      @media (max-width: 600px) {
        .meta-row {
          display: grid;
          grid-template-columns: repeat(2, auto);
          justify-content: center;
          gap: 1.75rem 3rem;
        }
      }

      .meta-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 0.35rem;
      }

      .meta-item .meta-label {
        font-size: 0.75rem;
        color: var(--year);
      }

      .meta-item .meta-value {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--label);
      }

      @media (max-width: 1000px) {
        .meta-item .meta-label,
        .meta-item .meta-value {
          font-size: 0.85rem;
        }
      }

      .hero-media {
        margin: 4rem 0;
        padding: 0 2rem;
      }

      /* Interactive product demos sit on a light grey stage sized like
         the full-width case study images: same 2rem gutter, same 4px
         radius, with the demo centered inside. */
      .demo-stage {
        margin: 4rem 0;
        padding: 0 2rem;
      }

      .demo-stage-inner {
        border-radius: 4px;
        background: color-mix(in srgb, var(--hover-bg) 60%, var(--bg));
        padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 5vw, 4rem);
      }

      .demo-stage-inner > * {
        max-width: 1000px;
        margin: 0 auto;
      }

      @media (max-width: 600px) {
        .demo-stage {
          padding: 0 1.25rem;
        }
      }

      .hero-media img {
        display: block;
        width: 100%;
        border-radius: 4px;
      }

      .media-credit {
        margin: 0.75rem 0 0;
        font-size: 0.8rem;
        color: var(--label);
        text-align: center;
      }

      /* Two images side by side (before/after, list/detail). */
      .pair {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(1.25rem, 2.5vw, 2rem);
      }

      .pair img {
        display: block;
        width: 100%;
        border-radius: 4px;
      }

      /* Three frames of the builder's evolution, left to right. */
      .strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1rem, 2vw, 1.5rem);
      }

      .strip img {
        display: block;
        width: 100%;
        border-radius: 4px;
      }

      .pair figure,
      .strip figure {
        margin: 0;
      }

      figcaption {
        margin-top: 0.75rem;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--label);
        text-align: center;
      }

      @media (max-width: 700px) {
        .pair,
        .strip {
          grid-template-columns: 1fr;
        }
      }

      section {
        margin: 4.5rem 0;
        scroll-margin-top: 100px;
      }

      .toc {
        position: fixed;
        top: 112px;
        left: 2rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
        z-index: 15;
      }

      .toc-line {
        width: 18px;
        height: 1.8px;
        background: var(--label);
        border-radius: 1px;
        transition: background 0.2s ease, width 0.2s ease;
      }

      .toc-line:hover {
        background: var(--icon-hover);
      }

      .toc-line.active {
        background: var(--title);
        width: 25px;
      }

      @media (max-width: 1000px) {
        .toc {
          display: none;
        }
      }

      section .label {
        font-size: 0.8rem;
        color: var(--year);
        text-align: center;
        margin: 0 0 1.25rem;
      }

      @media (max-width: 1000px) {
        section .label {
          font-size: 0.85rem;
        }
      }

      section h2 {
        font-size: 1.6rem;
        font-weight: 500;
        text-align: center;
        letter-spacing: -0.01em;
        margin: 0 0 2.5rem;
        text-wrap: balance;
      }

      @media (max-width: 600px) {
        section h2 {
          font-size: 1.4rem;
        }
      }

      /* Subsections within a phase, sized like the template's
         solution item headings. */
      .col h3 {
        font-size: 1.25rem;
        font-weight: 500;
        text-align: center;
        margin: 4rem 0 1.25rem;
        text-wrap: balance;
      }

      .col p,
      .col li {
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--text-secondary);
      }

      .col p {
        margin: 0 0 1.25rem;
      }

      .col p:last-child {
        margin-bottom: 0;
      }

      .col strong {
        font-weight: 600;
        color: var(--title);
      }

      .col ol,
      .col ul {
        margin: 0 0 1.25rem;
        padding-left: 1.4rem;
      }

      .col li {
        margin-bottom: 0.6rem;
        padding-left: 0.25rem;
      }

      .col li::marker {
        color: var(--label);
      }

      .guardrails {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin: 2rem 0;
        padding: 0;
        list-style: none;
      }

      .col .guardrails li {
        margin: 0;
        padding: 1.25rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .guardrails .guardrail-title {
        display: block;
        font-weight: 600;
        color: var(--title);
        margin-bottom: 0.35rem;
      }

      @media (max-width: 600px) {
        .guardrails {
          grid-template-columns: 1fr;
        }
      }

      .quote-section {
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }

      .quote-placeholder {
        text-align: center;
        font-size: 1rem;
        color: var(--label);
        border: 1px dashed color-mix(in srgb, var(--label) 45%, var(--bg));
        border-radius: 4px;
        padding: 2rem 1.5rem;
        margin: 0;
      }

      #more-work {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem 2rem 5rem;
      }

      #more-work .label {
        margin-bottom: 2.25rem;
      }

      .next-work {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 0.75rem;
      }

      .next-work-row {
        position: relative;
        display: block;
        padding: 1.21rem 2.5rem 1.21rem 1.1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      .next-work-row:hover,
      .next-work-row:active {
        background: var(--hover-bg);
      }

      .next-work-row:focus-visible {
        outline: 2px solid var(--label);
        outline-offset: 2px;
      }

      .next-work-row .title {
        display: block;
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--title);
        margin-bottom: 0.3rem;
      }

      .next-work-row .icon {
        position: absolute;
        top: 50%;
        right: 1.1rem;
        transform: translateY(-50%);
        font-size: 0.85rem;
        color: var(--icon);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }

      .next-work-row:hover .icon,
      .next-work-row:active .icon {
        opacity: 1;
        color: var(--icon-hover);
        transform: translateY(-50%) translateX(2px);
      }

      .next-work-row .desc {
        display: block;
        font-size: 0.92rem;
        line-height: 1.5;
        letter-spacing: 0.25px;
        color: var(--label);
      }

      .divider {
        height: 0;
        max-width: 80px;
        margin: 4rem auto 2.5rem;
        border-top: 1px solid var(--border);
      }

      .divider + section,
      .col:has(> .divider) + section {
        margin-top: 0;
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      .lightbox-eligible {
        cursor: zoom-in;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: rgba(10, 10, 9, 0.94);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease;
      }

      .lightbox.is-open {
        opacity: 1;
        visibility: visible;
      }

      .lightbox img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 4px;
        cursor: zoom-out;
      }

      .lightbox-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(248, 248, 246, 0.3);
        border-radius: 100px;
        background: transparent;
        color: #f8f8f6;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .lightbox-close:hover {
        background: rgba(248, 248, 246, 0.12);
        border-color: rgba(248, 248, 246, 0.5);
      }

      .lightbox-close svg {
        width: 18px;
        height: 18px;
      }

      @media (max-width: 600px) {
        .lightbox {
          padding: 1.25rem;
        }
      }
    </style>
  </head>
  <body>
    <Topbar showBack iconOnlyBack hideLogo />

    <main id="case-study">
      <div class="col">
        <div class="hero">
          <p class="eyebrow">Case study</p>
          <h1>{title}</h1>
          <p class="summary">{summary}</p>
          <div class="meta-row">
            <div class="meta-item">
              <span class="meta-label">Company</span>
              <span class="meta-value">Sublime Security</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Role</span>
              <span class="meta-value">Lead Product Designer</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Team</span>
              <span class="meta-value">PM, EM, 2 engineers, ML team</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Year</span>
              <span class="meta-value">2026</span>
            </div>
          </div>
        </div>
      </div>

      <figure class="hero-media" data-reveal>
        <MediaSlot
          src={`${IMG}/hero-dashboard.webp`}
          alt="Simulation overview dashboard with click, failure, and report rates, repeat clickers, and a group leaderboard"
          eager
        />
        {/* TODO: optional credit line, depends on whether Sublime marketing made the graphic.
        <figcaption class="media-credit">Graphic by ...</figcaption> */}
      </figure>

      <nav class="toc" aria-label="Case study sections">
        <a href="#challenge" class="toc-line" data-toc="challenge" aria-label="Challenge"></a>
        <a href="#approach" class="toc-line" data-toc="approach" aria-label="Approach"></a>
        <a href="#phases" class="toc-line" data-toc="phases" aria-label="Three phases, one idea"></a>
        <a href="#phase-1" class="toc-line" data-toc="phase-1" aria-label="Phase 1: Private beta"></a>
        <a href="#phase-2" class="toc-line" data-toc="phase-2" aria-label="Phase 2: Public beta"></a>
        <a href="#phase-3" class="toc-line" data-toc="phase-3" aria-label="Phase 3: GA"></a>
        <a href="#learned" class="toc-line" data-toc="learned" aria-label="What I learned"></a>
        <a href="#outcome" class="toc-line" data-toc="outcome" aria-label="Outcome"></a>
      </nav>

      <!-- Challenge -->
      <div class="col" data-reveal>
        <div class="divider"></div>
        <section id="challenge">
          <p class="label">Challenge</p>
          <h2>Customers were paying for a second tool to test what Sublime already knew</h2>
          <p>
            Phishing simulations let a security team find out whether employees will fall for a phish
            before a real attacker does. The team sends a harmless fake phish to a group of employees,
            then tracks who clicks, who reports it, and who ignores it.
          </p>
          <p>
            Sublime customers were already doing this, just not in Sublime. They paid for a separate
            tool, ran it on a quarterly content calendar, and tested employees against generic
            templates that had little to do with the attacks hitting their inboxes. Simulations were
            one of our most requested features, and the ask was always the same: fewer tools, one
            place to work.
          </p>
          <p>
            Sublime was built on a simple belief: stopping the next attack matters more than cleaning
            up this one. Our detections close gaps in the filter. Simulations could close gaps in
            people. And because Sublime sits inside the email stack, we already knew which attacks
            each customer was facing. A standalone tool has to guess. We didn't.
          </p>
          <p>I led design from the first concept through private beta, public beta, and GA readiness.</p>
        </section>
      </div>

      <!-- Approach -->
      <div class="col">
        <div class="divider"></div>
        <section id="approach" data-reveal>
          <p class="label">Approach</p>
          <h2>A campaign in under a minute</h2>
          <p>
            I started with the PRD and the analyst's jobs to be done, mapping every flow a campaign
            needed. From that came one goal: an analyst should be able to launch a campaign in under a
            minute. The catch was that every campaign still needed several steps, each with its own
            settings. So the rule was simple: cut the flow as far as possible without taking away the
            controls analysts actually need.
          </p>

          <h3>The assumption I got wrong</h3>
          <p>
            I assumed analysts would want deep control, maybe even an editor to redesign the phishing
            email itself. Early concepts and prototypes shown to customers proved otherwise. Analysts
            didn't want to design emails. They wanted to launch fast and get to the part that mattered.
          </p>
          <p>
            That part came after launch: who in my organization is most likely to fall for this, and
            what can I do about it? The builder was step one. The real value was the analysis
            afterward. That reframe shaped everything that followed: keep the builder lean, and put
            the depth into results.
          </p>
        </section>
      </div>

      <!-- Three phases, one idea -->
      <div class="col">
        <div class="divider"></div>
        <section id="phases" data-reveal>
          <h2>Three phases, one idea</h2>
          <p>
            The product grew in three phases, each shaped by what customers told us in the last. The
            thread running through all three: tie every campaign more closely to the real attacks
            Sublime sees.
          </p>
        </section>
      </div>

      <div class="wide" data-reveal>
        <FeatureEvolutionGrid client:visible />
      </div>

      <!-- Phase 1 -->
      <div class="col">
        <div class="divider"></div>
        <section id="phase-1" data-reveal>
          <p class="label">Phase 1: Private beta</p>
          <h2>Start small, test assumptions</h2>
          <p>
            We had a bigger vision, but wanted to test it with a handful of trusted customers before
            building it. Private beta shipped the basics.
          </p>
          <ol>
            <li><strong>Campaign details.</strong> Name, start date and time, and how long it runs.</li>
            <li><strong>Audience.</strong> Email lists customers already had in Sublime.</li>
            <li>
              <strong>Template.</strong> A short list of static templates, like password resets and CEO
              invoice requests, sorted by attack type.
            </li>
          </ol>
          <p>
            After launch, analysts could see every active campaign, and drill into each one to see who
            opened, clicked, replied, forwarded, or reported.
          </p>
        </section>
      </div>

      <div class="wide pair" data-reveal>
        <figure>
          <MediaSlot src={`${IMG}/campaign-list.webp`} alt="Private beta campaign list" todo="campaign-list.webp (data needs fixing)" />
        </figure>
        <figure>
          <MediaSlot src={`${IMG}/campaign-detail.webp`} alt="Private beta campaign detail with per-recipient results" todo="campaign-detail.webp (data needs fixing)" />
        </figure>
      </div>

      <div class="col" data-reveal>
        <p>
          The biggest gap was deliberate. These templates were isolated from the rest of Sublime,
          disconnected from the attack data we already had. Closing that gap became the next phase.
        </p>
      </div>

      <!-- Phase 2 -->
      <div class="col">
        <div class="divider"></div>
        <section id="phase-2" data-reveal>
          <p class="label">Phase 2: Public beta</p>
          <h2>From standalone tool to part of Sublime</h2>
