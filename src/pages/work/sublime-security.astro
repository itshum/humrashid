---
// Sublime Security: Phishing Simulations. Standalone rather than a
// content collection entry because its phase sections and interactive
// pieces don't fit the fixed slots in [slug].astro. Styles mirror that
// template so the two read as one system.
//
// Not published yet: noindex, excluded from the sitemap, and not linked
// from anywhere. Content lives inside #case-study so a password gate
// can wrap or replace it later without restructuring the page.
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/Footer.astro";
import CoreLoop from "../../components/case-study/sublime/CoreLoop.tsx";
import FeatureEvolutionGrid from "../../components/case-study/sublime/FeatureEvolutionGrid.tsx";
import TtpDiagram from "../../components/case-study/sublime/TtpDiagram.astro";
import LibraryWireframe from "../../components/case-study/sublime/LibraryWireframe.astro";
import LibraryFinal from "../../components/case-study/sublime/LibraryFinal.astro";
import BuilderNavVariants from "../../components/case-study/sublime/BuilderNavVariants.astro";
import BuilderWireframe from "../../components/case-study/sublime/BuilderWireframe.astro";
import TrainingToggle from "../../components/case-study/sublime/TrainingToggle.tsx";
import ResultsLeaderboard from "../../components/case-study/sublime/ResultsLeaderboard.tsx";
import CampaignBuilder from "../../components/case-study/sublime/CampaignBuilder.tsx";
import AiGenerateModal from "../../components/case-study/sublime/AiGenerateModal.tsx";
import ExecutiveDashboard from "../../components/case-study/sublime/ExecutiveDashboard.tsx";
import Analytics from "@vercel/analytics/astro";
import { getCollection } from "astro:content";

const moreWorkOrder = ["pack", "inveterate"];
const moreWork = (await getCollection("caseStudies"))
  .filter((cs) => moreWorkOrder.includes(cs.id))
  .sort((a, b) => moreWorkOrder.indexOf(a.id) - moreWorkOrder.indexOf(b.id));

const title = "Dynamic Phishing Simulations";
const summary =
  "Turning a standalone phishing test into a product built on the attacks each customer actually faces.";
---

<!doctype html>
<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/work/sublime-security" />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <style is:inline>
      html[data-theme="dark"] {
        background: #16171c;
        color: #eeede8;
      }
      html:not([data-theme="dark"]) {
        background: #fafaf9;
        color: #262626;
      }
    </style>
    <title>{title} · Humayun Rashid</title>
    <meta name="description" content={summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Instrument+Sans:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
    />
    <style is:global>
      /* Same tokens as [slug].astro and the homepage. */
      :root {
        --bg: #fafaf9;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #efefed;
        --title: #262626;
        --year: #8a8a86;
        --icon: #cacac6;
        --icon-hover: #6b6b6b;
        --border: #e6e6e3;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #a1a09a;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --icon: #474641;
        --icon-hover: #b5b4ad;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scrollbar-color: var(--border) var(--bg);
      }

      html::-webkit-scrollbar-track {
        background: var(--bg);
      }

      html::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 8px;
      }

      html::-webkit-scrollbar-thumb:hover {
        background: var(--label);
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col {
          padding: 0 2rem;
        }
      }

      /* Wider than .col for pieces that need more measure (the phase
         grid, the diagram, image pairs) but capped short of full bleed. */
      .wide {
        max-width: 1000px;
        margin: 3.5rem auto;
        padding: 0 2rem;
      }

      @media (max-width: 600px) {
        .wide {
          padding: 0 1.25rem;
        }
      }

      .hero {
        text-align: center;
        padding: 4.2rem 0 3.5rem;
      }

      .hero .eyebrow {
        font-size: 0.8rem;
        color: var(--label);
        margin: 0 0 1.25rem;
      }

      .hero h1 {
        font-size: 2.5rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        margin: 0 0 1.25rem;
        text-wrap: balance;
      }

      @media (max-width: 600px) {
        .hero h1 {
          font-size: 2rem;
        }
      }

      .hero .summary {
        font-size: 1.15rem;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 42ch;
        margin: 0 auto;
      }

      /* One row above phone width: the gap shrinks before anything wraps,
         so no item is left orphaned on its own line. */
      .meta-row {
        display: flex;
        justify-content: center;
        gap: clamp(1.5rem, 4vw, 3.5rem);
        margin-top: 2.5rem;
      }

      @media (max-width: 600px) {
        .meta-row {
          display: grid;
          grid-template-columns: repeat(2, auto);
          justify-content: center;
          gap: 1.75rem 3rem;
        }
      }

      .meta-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 0.35rem;
      }

      .meta-item .meta-label {
        font-size: 0.75rem;
        color: var(--year);
      }

      .meta-item .meta-value {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--label);
      }

      @media (max-width: 1000px) {
        .meta-item .meta-label,
        .meta-item .meta-value {
          font-size: 0.85rem;
        }
      }

      .hero-media {
        margin: 4rem 0;
        padding: 0 2rem;
      }

      /* Interactive product demos sit on a light grey stage sized like
         the full-width case study images: same 2rem gutter, same 4px
         radius, with the demo centered inside. */
      .demo-stage {
        margin: 4rem 0;
        padding: 0 2rem;
      }

      .demo-stage-inner {
        border-radius: 4px;
        background: color-mix(in srgb, var(--hover-bg) 60%, var(--bg));
        padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 5vw, 4rem);
      }

      .demo-stage-inner > * {
        max-width: 1000px;
        margin: 0 auto;
      }

      .demo-stage--hero .demo-stage-inner > * {
        max-width: 1200px;
      }

      /* One or two sentences on what the demo above does, left-aligned
         to the stage's edge like a figure caption. */
      .demo-caption {
        max-width: 75%;
        margin: 1rem 0 0;
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--label);
        text-wrap: pretty;
      }

      @media (max-width: 600px) {
        .demo-stage {
          padding: 0 1.25rem;
        }

        .demo-caption {
          max-width: none;
        }
      }

      .hero-media img {
        display: block;
        width: 100%;
        border-radius: 4px;
      }

      .media-credit {
        margin: 0.75rem 0 0;
        font-size: 0.8rem;
        color: var(--label);
        text-align: center;
      }

      /* Two images side by side (before/after, list/detail). */
      .pair {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(1.25rem, 2.5vw, 2rem);
      }

      .pair img {
        display: block;
        width: 100%;
        border-radius: 4px;
      }

      .pair figure {
        margin: 0;
      }

      .figure-note {
        margin: 0.75rem 0 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--label);
        text-align: center;
      }

      figcaption {
        margin-top: 0.75rem;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--label);
        text-align: center;
      }

      @media (max-width: 700px) {
        .pair {
          grid-template-columns: 1fr;
        }
      }

      section {
        margin: 4.5rem 0;
        scroll-margin-top: 100px;
      }

      .toc {
        position: fixed;
        top: 112px;
        left: 2rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
        z-index: 15;
      }

      .toc-line {
        width: 18px;
        height: 1.8px;
        background: var(--label);
        border-radius: 1px;
        transition: background 0.2s ease, width 0.2s ease;
      }

      .toc-line:hover {
        background: var(--icon-hover);
      }

      .toc-line.active {
        background: var(--title);
        width: 25px;
      }

      @media (max-width: 1000px) {
        .toc {
          display: none;
        }
      }

      section .label {
        font-size: 0.8rem;
        color: var(--year);
        text-align: center;
        margin: 0 0 1.25rem;
      }

      @media (max-width: 1000px) {
        section .label {
          font-size: 0.85rem;
        }
      }

      section h2 {
        font-size: 1.6rem;
        font-weight: 500;
        text-align: center;
        letter-spacing: -0.01em;
        margin: 0 0 2.5rem;
        text-wrap: balance;
      }

      @media (max-width: 600px) {
        section h2 {
          font-size: 1.4rem;
        }
      }

      /* Subsections within a phase, sized like the template's
         solution item headings. */
      .col h3 {
        font-size: 1.25rem;
        font-weight: 500;
        text-align: center;
        margin: 4rem 0 1.25rem;
        text-wrap: balance;
      }

      .col p,
      .col li {
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--text-secondary);
      }

      .col p {
        margin: 0 0 1.25rem;
      }

      .col p:last-child {
        margin-bottom: 0;
      }

      .col strong {
        font-weight: 600;
        color: var(--title);
      }

      .col ol,
      .col ul {
        margin: 0 0 1.25rem;
        padding-left: 1.4rem;
      }

      .col li {
        margin-bottom: 0.6rem;
        padding-left: 0.25rem;
      }

      .col li::marker {
        color: var(--label);
      }

      .guardrails {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin: 2rem 0;
        padding: 0;
        list-style: none;
      }

      .col .guardrails li {
        margin: 0;
        padding: 1.25rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .guardrails .guardrail-title {
        display: block;
        font-weight: 600;
        color: var(--title);
        margin-bottom: 0.35rem;
      }

      @media (max-width: 600px) {
        .guardrails {
          grid-template-columns: 1fr;
        }
      }

      #more-work {
        max-width: 718px;
        margin: 0 auto;
        padding: 1.5rem 1.5rem 5rem;
      }

      #more-work .label {
        margin-bottom: 2.25rem;
      }

      .next-work {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }

      @media (max-width: 600px) {
        #more-work {
          padding-left: 2rem;
          padding-right: 2rem;
        }

        .next-work {
          grid-template-columns: 1fr;
        }
      }

      .next-work-row {
        position: relative;
        display: block;
        padding: 1.21rem 2.5rem 1.21rem 1.1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      .next-work-row:hover,
      .next-work-row:active {
        background: var(--hover-bg);
      }

      .next-work-row:focus-visible {
        outline: 2px solid var(--label);
        outline-offset: 2px;
      }

      .next-work-row .title {
        display: block;
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--title);
        margin-bottom: 0.3rem;
      }

      .next-work-row .icon {
        position: absolute;
        top: 50%;
        right: 1.1rem;
        transform: translateY(-50%);
        font-size: 0.85rem;
        color: var(--icon);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }

      .next-work-row:hover .icon,
      .next-work-row:active .icon {
        opacity: 1;
        color: var(--icon-hover);
        transform: translateY(-50%) translateX(2px);
      }

      .next-work-row .desc {
        display: block;
        font-size: 0.92rem;
        line-height: 1.5;
        letter-spacing: 0.25px;
        color: var(--label);
      }

      .divider {
        height: 0;
        max-width: 80px;
        margin: 4rem auto 2.5rem;
        border-top: 1px solid var(--border);
      }

      .divider + section,
      .col:has(> .divider) + section {
        margin-top: 0;
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      .lightbox-eligible {
        cursor: zoom-in;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: rgba(10, 10, 9, 0.94);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease;
      }

      .lightbox.is-open {
        opacity: 1;
        visibility: visible;
      }

      .lightbox img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 4px;
        cursor: zoom-out;
      }

      .lightbox-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(248, 248, 246, 0.3);
        border-radius: 100px;
        background: transparent;
        color: #f8f8f6;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .lightbox-close:hover {
        background: rgba(248, 248, 246, 0.12);
        border-color: rgba(248, 248, 246, 0.5);
      }

      .lightbox-close svg {
        width: 18px;
        height: 18px;
      }

      @media (max-width: 600px) {
        .lightbox {
          padding: 1.25rem;
        }
      }
    </style>
  </head>
  <body>
    <Topbar showBack iconOnlyBack hideLogo />

    <main id="case-study">
      <div class="col">
        <div class="hero">
          <p class="eyebrow">Case study</p>
          <h1>{title}</h1>
          <p class="summary">{summary}</p>
          <div class="meta-row">
            <div class="meta-item">
              <span class="meta-label">Company</span>
              <span class="meta-value">Sublime Security</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Role</span>
              <span class="meta-value">Lead Product Designer</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Project</span>
              <span class="meta-value">Phishing Simulations &amp; Training</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Year</span>
              <span class="meta-value">2026</span>
            </div>
          </div>
        </div>
      </div>

      <div class="demo-stage demo-stage--hero" data-reveal>
        <div class="demo-stage-inner">
          <CampaignBuilder client:load fit />
        </div>
      </div>

      <nav class="toc" aria-label="Case study sections">
        <a href="#challenge" class="toc-line" data-toc="challenge" aria-label="Challenge"></a>
        <a href="#approach" class="toc-line" data-toc="approach" aria-label="Approach"></a>
        <a href="#phases" class="toc-line" data-toc="phases" aria-label="Three phases, one idea"></a>
        <a href="#phase-1" class="toc-line" data-toc="phase-1" aria-label="Phase 1: Private beta"></a>
        <a href="#phase-2" class="toc-line" data-toc="phase-2" aria-label="Phase 2: Public beta"></a>
        <a href="#phase-3" class="toc-line" data-toc="phase-3" aria-label="Phase 3: GA"></a>
        <a href="#learned" class="toc-line" data-toc="learned" aria-label="What I learned"></a>
        <a href="#outcome" class="toc-line" data-toc="outcome" aria-label="Outcome"></a>
      </nav>

      <!-- Challenge -->
      <div class="col" data-reveal>
        <div class="divider"></div>
        <section id="challenge">
          <p class="label">Challenge</p>
          <h2>Customers were paying for a second tool to test what Sublime already knew</h2>
          <p>
            Security teams run phishing simulations to learn who will fall for a phish before an
            attacker does. Our customers were already running them, just not in Sublime. They paid for
            a separate tool that sent generic templates on a quarterly calendar, disconnected from the
            attacks actually hitting their inboxes. It was one of our most requested features.
          </p>
          <p>
            The strategic case was clear. Sublime sits inside the email stack, so it already knows
            which attacks each customer faces. A standalone tool has to guess. Our detections close
            gaps in the filter. Simulations could close gaps in people, using the same data.
          </p>
          <p>
            I led design from first concept through private beta, public beta, and GA readiness,
            partnering closely with our PM, engineering, and ML team.
          </p>
        </section>
      </div>

      <!-- Approach -->
      <div class="col">
        <div class="divider"></div>
        <section id="approach" data-reveal>
          <p class="label">Approach</p>
          <h2>Keep the builder lean. Put the depth in the results.</h2>
          <p>
            I set one goal early: an analyst should be able to launch a campaign in under a minute,
            even though every campaign needs several steps with their own settings.
          </p>
          <p>
            I also got an important assumption wrong. I expected analysts to want deep control, even an
            editor to redesign the phishing email. Prototypes with customers proved otherwise. Analysts
            don't want to design emails. They want to know who in their organization is most likely to
            fall for a phish, and what to do about it.
          </p>
          <p>
            That reframe set the strategy for every phase: keep the builder lean, and put the depth into
            results.
          </p>
        </section>
      </div>

      <!-- Three phases, one idea -->
      <div class="col">
        <div class="divider"></div>
        <section id="phases" data-reveal>
          <h2>Three phases, one idea</h2>
          <p>Each phase tied campaigns more closely to the real attacks Sublime sees.</p>
        </section>
      </div>

      <div class="wide" data-reveal>
        <FeatureEvolutionGrid client:visible />
      </div>

      <!-- Phase 1 -->
      <div class="col">
        <div class="divider"></div>
        <section id="phase-1" data-reveal>
          <p class="label">Phase 1: Private beta</p>
          <h2>Validate the core loop</h2>
          <p>
            I scoped private beta deliberately small: a three-step builder (details, audience,
            template), a handful of static templates, and per-recipient reporting, shipped to a few
            trusted customers. The goal was to prove the core loop before building the vision.
          </p>
        </section>
      </div>

      <div class="wide" data-reveal>
        <CoreLoop client:visible />
        <p class="figure-note">The private beta loop: build, send, read results.</p>
      </div>

      <div class="col" data-reveal>
        <p>
          The biggest gap was intentional. Templates were generic and isolated from Sublime's attack
          data. Closing that gap defined the next phase.
        </p>
      </div>

      <!-- Phase 2 -->
      <div class="col">
        <div class="divider"></div>
        <section id="phase-2" data-reveal>
          <p class="label">Phase 2: Public beta</p>
          <h2>Ground it in Sublime</h2>
          <p>
            This is where simulations became Sublime's own. Every template traced back to a detection
            rule, so the picker could lead with the attacks most active in each customer's
            environment.
          </p>
        </section>
      </div>

      <div class="wide" data-reveal>
        <TtpDiagram />
        <p class="figure-note">Every template maps to a detection rule, so prevalence data can rank what to simulate.</p>
      </div>

      <div class="wide pair" data-reveal>
        <figure>
          <LibraryWireframe />
          <figcaption>Before: a flat, generic list</figcaption>
        </figure>
        <figure>
          <LibraryFinal />
          <figcaption>After: grouped by what's active in your environment</figcaption>
        </figure>
      </div>

      <div class="col" data-reveal>
        <p>
          We also shipped what beta customers asked for: staggered sends, so employees can't warn each
          other at the water cooler, plus Google Workspace, Microsoft 365, and CSV audiences.
        </p>
        <p>
          Reporting started answering "so what?" I added repeat clickers, the people who fall for more
          than one simulation, and a leaderboard of the most vulnerable and safest groups. It would
          have been easy to bolt on panels. Instead, customer conversations and prototypes decided
          what earned a spot.
        </p>
      </div>

      <div class="demo-stage" data-reveal>
        <div class="demo-stage-inner">
