---
import Topbar from "../../components/Topbar.astro";
import Carousel from "../../components/Carousel.astro";
import SideBySide from "../../components/SideBySide.astro";
import WideImage from "../../components/WideImage.astro";
import Triptych from "../../components/Triptych.astro";
import Quad from "../../components/Quad.astro";
import CompareReveal from "../../components/CompareReveal.astro";
import DetailSplit from "../../components/DetailSplit.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const caseStudies = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );

  // Up to the next 2 other case studies, cyclic, for the footer's "more
  // work" pair - naturally scales as more case studies are published.
  const nextOthers = (currentId: string, count: number) => {
    const startIndex = caseStudies.findIndex((cs) => cs.id === currentId);
    const result = [];
    for (let step = 1; step <= caseStudies.length && result.length < count; step++) {
      const candidate = caseStudies[(startIndex + step) % caseStudies.length];
      if (candidate.id !== currentId) result.push(candidate);
    }
    return result;
  };

  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, nextCaseStudies: nextOthers(entry.id, 2) },
  }));
}

const { entry, nextCaseStudies } = Astro.props;
const { data } = entry;

const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={`https://www.humrashid.com/work/${entry.id}`} />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>{data.title} · Humayun Rashid</title>
    <meta name="description" content={data.summary} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Humayun Rashid" />
    <meta property="og:title" content={`${data.title} · Humayun Rashid`} />
    <meta property="og:description" content={data.summary} />
    <meta property="og:url" content={`https://www.humrashid.com/work/${entry.id}`} />
    <meta
      property="og:image"
      content={`https://www.humrashid.com${data.coverImage ?? "/og-image.jpg"}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${data.title} · Humayun Rashid`} />
    <meta name="twitter:description" content={data.summary} />
    <meta
      name="twitter:image"
      content={`https://www.humrashid.com${data.coverImage ?? "/og-image.jpg"}`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      /* Time-based dark mode (see the inline head script + Topbar's
         script, both keyed off NYC local time) - same tokens as the
         homepage so the two pages feel like one site. */
      :root {
        --bg: #f8f8f6;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #eae9e5;
        --title: #262626;
        --year: #8a8984;
        --icon: #c9c7c0;
        --icon-hover: #6b6b6b;
        --border: #e2e0da;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #171715;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --hover-bg: #272724;
        --title: #eeede8;
        --year: #73726b;
        --icon: #51504a;
        --icon-hover: #b5b4ad;
        --border: #2f2e2c;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* On mobile .col's padding IS the distance from the viewport
         edge (no centering slack the way there is on wider screens),
         so it has to match the topbar's 2rem horizontal padding
         exactly or text runs wider than the back link/logo above it. */
      @media (max-width: 600px) {
        .col {
          padding: 0 2rem;
        }
      }

      /* Hero — centered, generous, no boxed meta grid */
      .hero {
        text-align: center;
        padding: 4.2rem 0 3.5rem;
      }

      .hero .eyebrow {
        font-size: 0.8rem;
        color: var(--label);
        margin: 0 0 1.25rem;
      }

      .hero h1 {
        font-size: 2.5rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        margin: 0 0 1.25rem;
        text-wrap: balance;
      }

      .hero .summary {
        font-size: 1.15rem;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 42ch;
        margin: 0 auto;
      }

      .meta-row {
        display: flex;
        justify-content: center;
        gap: 3.5rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
      }

      /* Four items in a row don't fit this narrow - a wrapped flex
         row centers each line on its own, which strands the 4th item
         alone and off-center under the first three. A real 2-column
         grid keeps it a deliberate, centered 2x2 block instead. */
      @media (max-width: 600px) {
        .meta-row {
          display: grid;
          grid-template-columns: repeat(2, auto);
          justify-content: center;
          gap: 1.75rem 3rem;
        }
      }

      .meta-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 0.35rem;
      }

      .meta-item .meta-label {
        font-size: 0.75rem;
        color: var(--year);
      }

      .meta-item .meta-value {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--label);
      }

      /* Both read a touch too small on an actual tablet/phone screen
         at their desktop size - bump slightly for legibility. */
      @media (max-width: 1000px) {
        .meta-item .meta-label,
        .meta-item .meta-value {
          font-size: 0.85rem;
        }
      }

      /* Full width, padded to the same gutter as the topbar's logo and
         back link, so the image edges line up with them. */
      .hero-media {
        margin-top: 4rem;
        margin-bottom: 4rem;
        padding: 0 2rem;
      }

      .hero-media img {
        display: block;
        width: 100%;
        border-radius: 4px;
      }

      /* Some source screenshots end in a ragged edge at the very
         bottom - a fixed aspect-ratio crop gives it one plain,
         straight line instead. */
      .hero-media.crop-tight {
        aspect-ratio: 2898 / 1569;
        overflow: hidden;
        border-radius: 4px;
      }

      .hero-media.crop-tight img {
        height: 100%;
        object-fit: cover;
        object-position: top;
      }

      /* This one screenshot's own background is near-white, same as
         the page - without an edge of its own it has no visible
         boundary against --bg. */
      .quad-item img[src*="33-s02-investor-profiles-3"] {
        border: 1px solid var(--border);
      }

      /* Prose sections - generous whitespace, no boxed dividers */
      /* Margin, not padding, so this collapses evenly with whatever
         sits on either side (another section's margin, or a media
         component's own margin) - padding never collapses, which is
         what caused uneven/doubled gaps around section text before. */
      section {
        margin: 4.5rem 0;
        scroll-margin-top: 100px;
      }

      /* Notion-style outline: a stack of short lines mirroring the
         topbar's back link, fixed just below it. Each line jumps to a
         section; the current section's line goes dark and a touch
         wider. Hidden on narrower viewports where it'd collide with
         the centered column. */
      .toc {
        position: fixed;
        top: 96px;
        left: 2rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
        z-index: 15;
      }

      .toc-line {
        width: 18px;
        height: 1.8px;
        background: var(--label);
        border-radius: 1px;
        transition: background 0.2s ease, width 0.2s ease;
      }

      .toc-line:hover {
        background: var(--icon-hover);
      }

      /* Deliberately neutral, not tied to --selection-bg - the page
         already has color (logo cells, footer shimmer, text
         selection), so this stays off-white/dark via --title, which
         already flips per theme, rather than adding another accent. */
      .toc-line.active {
        background: var(--title);
        width: 25px;
      }

      @media (max-width: 1000px) {
        .toc {
          display: none;
        }
      }

      section .label {
        font-size: 0.8rem;
        color: var(--year);
        text-align: center;
        margin: 0 0 1.25rem;
      }

      @media (max-width: 1000px) {
        section .label {
          font-size: 0.85rem;
        }
      }

      section h2 {
        font-size: 1.6rem;
        font-weight: 500;
        text-align: center;
        letter-spacing: -0.01em;
        margin: 0 0 2.5rem;
        text-wrap: balance;
      }

      @media (max-width: 600px) {
        section h2 {
          font-size: 1.4rem;
        }
      }

      /* Numbered "5. ..." alongside the solution items' own "1-4."
         tags, so its heading should read at the same size as theirs
         (.solution-item h3), not the larger generic section h2. */
      #design-system h2 {
        font-size: 1.25rem;
        margin: 0 0 1.25rem;
      }

      section p {
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--text-secondary);
        margin: 0 0 1.25rem;
      }

      section p:last-child {
        margin-bottom: 0;
      }

      .solution-item {
        margin-bottom: 4rem;
      }

      .solution-item:last-child {
        margin-bottom: 0;
      }

      .solution-item .tag {
        display: block;
        text-align: center;
        font-size: 0.8rem;
        color: var(--year);
        margin-bottom: 0.5rem;
      }

      .solution-item h3 {
        font-size: 1.25rem;
        font-weight: 500;
        text-align: center;
        margin: 0 0 1.25rem;
        text-wrap: balance;
      }

      /* The "small" opt-in image size - centered within the text
         column. Default (unset) images instead render full-bleed via
         .hero-media, matching the cover image. */
      .solution-image-small {
        display: block;
        width: 100%;
        border-radius: 4px;
        margin-top: 2rem;
      }

      /* Wider than .col on purpose - the quote needs more measure than
         the 700px prose column gives it, so it breaks out to its own
         centered wrapper instead of inheriting .col's width. */
      .quote-section {
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }

      .quote {
        text-align: center;
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1.55;
        color: var(--title);
        max-width: 68ch;
        margin: 0 auto;
        text-wrap: balance;
      }

      @media (max-width: 600px) {
        .quote {
          font-size: 1.15rem;
          line-height: 1.45;
        }
      }

      .quote .attribution {
        display: block;
        font-size: 0.85rem;
        font-weight: 400;
        color: var(--label);
        margin-top: 1.5rem;
      }

      /* Wider than the narrow .col text measure so the row reads close
         to back-link/logo width, but capped so it doesn't stretch into
         sparse, over-long cards on very wide viewports. */
      #more-work {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem 2rem 5rem;
      }

      #more-work .label {
        margin-bottom: 2.25rem;
      }

      .next-work {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 0.75rem;
      }

      /* Same hover-highlight pattern as the homepage's work list -
         padding lives on the row itself so the highlight bleeds past
         the text measure on both sides. */
      .next-work-row {
        position: relative;
        display: block;
        padding: 1.21rem 2.5rem 1.21rem 1.1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      /* :active alongside :hover - touch devices have no real hover,
         so without this the highlight/arrow only show up through
         iOS's flaky sticky-hover simulation. :active fires the
         instant a finger touches down, giving immediate native-app-
         style press feedback rather than requiring a lucky hover. */
      .next-work-row:hover,
      .next-work-row:active {
        background: var(--hover-bg);
      }

      .next-work-row .title {
        display: block;
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--title);
        margin-bottom: 0.3rem;
      }

      /* Centered against the row's full height (not just the title
         line) and pinned to the right edge, so it reads as a single
         affordance for the whole card rather than sitting next to the
         title specifically. */
      .next-work-row .icon {
        position: absolute;
        top: 50%;
        right: 1.1rem;
        transform: translateY(-50%);
        font-size: 0.85rem;
        color: var(--icon);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }

      .next-work-row:hover .icon,
      .next-work-row:active .icon {
        opacity: 1;
        color: var(--icon-hover);
        transform: translateY(-50%) translateX(2px);
      }

      .next-work-row .desc {
        display: block;
        font-size: 0.92rem;
        line-height: 1.5;
        letter-spacing: 0.25px;
        color: var(--label);
      }

      /* The line is drawn with a real border (not box-shadow), which
         deliberately makes this a non-empty box: that blocks margin
         collapse, so the gap above and below the line is always
         exactly what's set here - never dependent on how deeply the
         divider happens to be nested relative to the section that
         follows it. The section that follows has its own top margin
         zeroed out (below) so this is the single source of spacing
         on both sides of the line, everywhere it's used. */
      .divider {
        height: 0;
        max-width: 80px;
        margin: 4rem auto 2.5rem;
        border-top: 1px solid var(--border);
      }

      /* Divider owns the spacing to whatever follows it, in both the
         "divider + section share a .col" layout (Approach, data
         section, design system) and the "divider sits alone in its
         own .col right before the section" layout (Solution, quote,
         more work) - see the two markup patterns in the body below. */
      .divider + section,
      .col:has(> .divider) + section {
        margin-top: 0;
      }

      /* Subtle fade-up on scroll, applied to every major copy/media
         block via the data-reveal attribute (set in this file and in
         each media component) - same feel as Nessa's own case study
         site: content sits slightly below and transparent until it
         scrolls into view, then settles into place. Fires once. */
      [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* Tap-to-expand lightbox for content screenshots - on mobile
         especially, a full-width screenshot scaled down to a ~340px
         column is too small to read any UI detail inside it. Any
         image in the case study body (see the click-delegation script
         below for the exact scope/exclusions) opens full-screen on
         tap instead of requiring a rotate-to-landscape workaround. */
      .lightbox-eligible {
        cursor: zoom-in;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: rgba(10, 10, 9, 0.94);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease;
      }

      .lightbox.is-open {
        opacity: 1;
        visibility: visible;
      }

      .lightbox img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 4px;
        cursor: zoom-out;
      }

      /* Same outlined-circle style as the carousel's prev/next buttons
         (.carousel-btn in Carousel.astro) - thin border, transparent
         fill, fills in on hover - just with an X instead of an arrow,
         so the site's nav-button language stays consistent. Colors
         are hardcoded rather than pulled from the --text/--border
         theme vars: the lightbox backdrop is always near-black
         regardless of site theme, and those vars flip dark in light
         mode, which would make the button vanish against it. */
      .lightbox-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(248, 248, 246, 0.3);
        border-radius: 100px;
        background: transparent;
        color: #f8f8f6;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .lightbox-close:hover {
        background: rgba(248, 248, 246, 0.12);
        border-color: rgba(248, 248, 246, 0.5);
      }

      .lightbox-close svg {
        width: 18px;
        height: 18px;
      }

      @media (max-width: 600px) {
        .lightbox {
          padding: 1.25rem;
        }
      }
    </style>
  </head>
  <body>
    <Topbar showBack />

    <div class="col">
      <div class="hero">
        <p class="eyebrow">Case Study</p>
        <h1>{data.title}</h1>
        <p class="summary">{data.summary}</p>
        <div class="meta-row">
          <div class="meta-item">
            <span class="meta-label">Company</span>
            <span class="meta-value">{data.company}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Role</span>
            <span class="meta-value">{data.role}</span>
          </div>
          {
            data.teamSize && (
              <div class="meta-item">
                <span class="meta-label">Team</span>
                <span class="meta-value">{data.teamSize}</span>
              </div>
            )
          }
          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{data.timeframe}</span>
          </div>
        </div>
      </div>
    </div>

    {
      data.coverImage && (
        <div class="hero-media" data-reveal>
          <img src={data.coverImage} alt={data.coverImageAlt ?? `${data.title} interface`} />
        </div>
      )
    }

    <nav class="toc" aria-label="Case study sections">
      <a href="#challenge" class="toc-line" data-toc="challenge" aria-label="Challenge"></a>
      <a href="#approach" class="toc-line" data-toc="approach" aria-label="Approach"></a>
      {
        data.solutionItems && data.solutionItems.length > 0 && (
          <a href="#solution" class="toc-line" data-toc="solution" aria-label="Solution" />
        )
      }
      {data.quote && <a href="#quote" class="toc-line" data-toc="quote" aria-label="Quote" />}
    </nav>

    <div class="col" data-reveal>
      <div class="divider"></div>

      <section id="challenge">
        <p class="label">Challenge</p>
        {data.challengeHeading && <h2>{data.challengeHeading}</h2>}
        {paragraphs(data.problem).map((p) => <p>{p}</p>)}
      </section>
    </div>

    {
      data.challengeImage && (
        <div class="hero-media" data-reveal>
          <img
            src={data.challengeImage}
            alt={data.challengeImageAlt ?? `${data.title} interface`}
          />
        </div>
      )
    }

    <div class="col">
      <div class="divider"></div>

      <section id="approach" data-reveal>
        <p class="label">Approach</p>
        {data.approachHeading && <h2>{data.approachHeading}</h2>}
        {paragraphs(data.approach).map((p) => <p>{p}</p>)}
      </section>
    </div>

    {data.approachGrid && data.approachGrid.length > 0 && <Quad images={data.approachGrid} />}

    {
      data.navSystemImage && (
        <div class="hero-media" data-reveal>
          <img src={data.navSystemImage.src} alt={data.navSystemImage.alt} />
        </div>
      )
    }

    {data.wideImage && <WideImage src={data.wideImage.src} alt={data.wideImage.alt} />}

    {
      data.solutionItems && data.solutionItems.length > 0 && (
        <>
          <div class="col">
            <div class="divider" />
          </div>
          <section id="solution">
            <div class="col" data-reveal>
              <p class="label">{data.solutionLabel ?? "Solution"}</p>
              {data.solutionHeading && <h2>{data.solutionHeading}</h2>}
            </div>

            {data.solutionItems.map((item, i) => (
              <>
                <div class="solution-item" data-reveal>
                  <div class="col">
                    <span class="tag">{item.tag}</span>
                    <h3>{item.heading}</h3>
                    {paragraphs(item.body).map((p) => (
                      <p>{p}</p>
                    ))}
                    {item.image && item.imageSize === "small" && (
                      <img
                        class="solution-image-small"
                        src={item.image}
                        alt={item.imageAlt ?? item.heading}
                      />
                    )}
                  </div>
                  {item.image && item.imageSize !== "small" && item.compareWireframe && (
                    <CompareReveal
                      leftSrc={item.compareWireframe.src}
                      leftAlt={item.compareWireframe.alt ?? `${item.heading} wireframe`}
                      rightSrc={item.image}
                      rightAlt={item.imageAlt ?? item.heading}
                    />
                  )}
                  {item.image && item.imageSize !== "small" && !item.compareWireframe && (
                    <div class="hero-media">
                      <img src={item.image} alt={item.imageAlt ?? item.heading} />
                    </div>
                  )}
                </div>
                {i === 0 && data.dashboardImage && (
                  <div class="hero-media" data-reveal>
                    <img
                      src={data.dashboardImage}
                      alt={data.dashboardImageAlt ?? `${data.title} interface`}
                    />
                  </div>
                )}
                {i === 1 && data.item1Image && (
                  <div class="hero-media" data-reveal>
                    <img src={data.item1Image} alt={data.item1ImageAlt ?? item.heading} />
                  </div>
                )}
                {i === 1 && data.devGrid && data.devGrid.length > 0 && <Quad images={data.devGrid} />}
                {i === 1 && data.item1Compare && (
                  <CompareReveal
                    leftSrc={data.item1Compare.wireframe.src}
                    leftAlt={data.item1Compare.wireframe.alt ?? `${item.heading} wireframe`}
                    rightSrc={data.item1Compare.image}
                    rightAlt={data.item1Compare.imageAlt ?? item.heading}
                  />
                )}
                {i === 2 && data.approachGallery && data.approachGallery.length > 0 && (
                  <Carousel slides={data.approachGallery} />
                )}
                {i === 2 && data.item2WideImage && (
                  <WideImage
                    src={data.item2WideImage.src}
                    alt={data.item2WideImage.alt ?? item.heading}
                  />
                )}
                {i === 2 && data.item2Grid && data.item2Grid.length > 0 && <Quad images={data.item2Grid} />}
                {i === 2 && data.dataSectionHeading && (
                  <div class="solution-item" data-reveal>
                    <div class="col" id="data-section">
                      {data.dataSectionLabel && <span class="tag">{data.dataSectionLabel}</span>}
                      <h3>{data.dataSectionHeading}</h3>
                      {data.dataSectionBody &&
                        paragraphs(data.dataSectionBody).map((p) => <p>{p}</p>)}
                    </div>
                  </div>
                )}
                {i === 2 && data.dataGallery && data.dataGallery.length > 0 && (
                  <Carousel slides={data.dataGallery} />
                )}
                {i === 3 && data.item3Image && (
                  <div class="hero-media" data-reveal>
                    <img src={data.item3Image} alt={data.item3ImageAlt ?? item.heading} />
                  </div>
                )}
                {i === 4 && data.item4Grid && data.item4Grid.length > 0 && <Quad images={data.item4Grid} />}
              </>
            ))}
          </section>
        </>
      )
    }

    {data.triptych && <Triptych images={data.triptych} />}

    {
      data.designSystemHeading && (
        <div class="col">
          <div class="divider" />

          <section id="design-system" data-reveal>
            {data.designSystemLabel && <p class="label">{data.designSystemLabel}</p>}
            <h2>{data.designSystemHeading}</h2>
            {data.designSystemBody && paragraphs(data.designSystemBody).map((p) => <p>{p}</p>)}
          </section>
        </div>
      )
    }

    {
      data.designSystemImage && (
        <div class="hero-media" data-reveal>
          <img src={data.designSystemImage.src} alt={data.designSystemImage.alt} />
        </div>
      )
    }

    {
      data.quote && (
        <>
          <div class="col">
            <div class="divider" />
          </div>
          <section id="quote" class="quote-section" data-reveal>
            <blockquote class="quote">
              "{data.quote.text}"
              <span class="attribution">{data.quote.attribution}</span>
            </blockquote>
          </section>
        </>
      )
    }

    {data.postQuoteGrid && data.postQuoteGrid.length === 1 && (
      <div class="hero-media crop-tight" data-reveal>
        <img src={data.postQuoteGrid[0].src} alt={data.postQuoteGrid[0].alt} />
      </div>
    )}
    {data.postQuoteGrid && data.postQuoteGrid.length > 1 && <Quad images={data.postQuoteGrid} />}

    {data.sideBySide && <SideBySide left={data.sideBySide.left} right={data.sideBySide.right} />}

    {
      data.detailSplit && (
        <DetailSplit main={data.detailSplit.main} detail={data.detailSplit.detail} />
      )
    }

    <div class="col">
      <div class="divider"></div>
    </div>

    {
      nextCaseStudies.length > 0 && (
        <section id="more-work">
          <p class="label">More work</p>
          <div class="next-work">
            {nextCaseStudies.map((cs) => (
              <a class="next-work-row" href={`/work/${cs.id}`} data-reveal>
                <span class="icon">→</span>
                <span class="title">{cs.data.title}</span>
                <span class="desc">{cs.data.shortSummary ?? cs.data.summary}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
      <button class="lightbox-close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
      <img src="" alt="" />
    </div>

    <script>
      // Tap-to-expand lightbox: any content image (excluding the
      // interactive compare-reveal slider, which already has its own
      // drag-to-reveal gesture, and anything that's really a link -
      // like the "more work" thumbnails) opens full-screen on click.
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = lightbox?.querySelector("img");
      const lightboxClose = lightbox?.querySelector(".lightbox-close");

      function openLightbox(src: string, alt: string) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.setAttribute("src", src);
        lightboxImg.setAttribute("alt", alt);
        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        if (!lightbox || !lightboxImg) return;
        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      // Mark every eligible image up front (not just after the first
      // click) so the zoom-in cursor is there to hint at the
      // interaction before anyone has tapped anything.
      document.querySelectorAll("img").forEach((img) => {
        if (img.closest(".compare-reveal, .topbar, a, .lightbox")) return;
        img.classList.add("lightbox-eligible");
      });

      document.body.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const img = target.closest("img");
        if (!img || !(img instanceof HTMLImageElement)) return;
        if (!img.classList.contains("lightbox-eligible")) return;
        openLightbox(img.currentSrc || img.src, img.alt);
      });

      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeLightbox();
      });
    </script>

    <script>
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-line");
      const sections = [...tocLinks]
        .map((link) => document.getElementById(link.dataset.toc ?? ""))
        .filter((el): el is HTMLElement => el !== null);

      if (tocLinks.length > 0) {
        tocLinks[0].classList.add("active");
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const link = document.querySelector(`.toc-line[data-toc="${entry.target.id}"]`);
            if (!link) return;
            tocLinks.forEach((l) => l.classList.remove("active"));
            link.classList.add("active");
          });
        },
        { rootMargin: "-40% 0px -50% 0px", threshold: 0 }
      );

      sections.forEach((section) => observer.observe(section));

      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (revealEls.length > 0) {
        if ("IntersectionObserver" in window) {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-revealed");
                revealObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
          );
          revealEls.forEach((el) => revealObserver.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add("is-revealed"));
        }
      }
    </script>
  </body>
</html>
