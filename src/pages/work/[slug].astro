---
import Topbar from "../../components/Topbar.astro";
import Carousel from "../../components/Carousel.astro";
import SideBySide from "../../components/SideBySide.astro";
import WideImage from "../../components/WideImage.astro";
import Triptych from "../../components/Triptych.astro";
import DetailSplit from "../../components/DetailSplit.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const caseStudies = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return caseStudies.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}

const { entry, next } = Astro.props;
const { data } = entry;

const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{data.title} · Humayun Rashid</title>
    <meta name="description" content={data.summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      html,
      body {
        margin: 0;
        background: #f8f8f6;
        color: #262626;
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
      }

      a {
        color: inherit;
      }

      .col {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Hero — centered, generous, no boxed meta grid */
      .hero {
        text-align: center;
        padding: 4.2rem 0 3.5rem;
      }

      .hero .eyebrow {
        font-size: 0.8rem;
        color: #8a8a8a;
        margin: 0 0 1.25rem;
      }

      .hero h1 {
        font-size: 2.5rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        margin: 0 0 1.25rem;
      }

      .hero .summary {
        font-size: 1.15rem;
        color: #5c5c5c;
        line-height: 1.6;
        max-width: 42ch;
        margin: 0 auto;
      }

      .meta-row {
        display: flex;
        justify-content: center;
        gap: 3.5rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
      }

      .meta-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 0.35rem;
      }

      .meta-item .meta-label {
        font-size: 0.75rem;
        color: #b0b0b0;
      }

      .meta-item .meta-value {
        font-size: 0.75rem;
        font-weight: 500;
        color: #8a8a8a;
      }

      /* Full width, padded to the same gutter as the topbar's logo and
         back link, so the image edges line up with them. */
      .hero-media {
        margin-top: 4rem;
        padding: 0 2rem;
      }

      .hero-media img {
        display: block;
        width: 100%;
        border-radius: 4px;
      }

      /* Prose sections - generous whitespace, no boxed dividers */
      section {
        padding: 4.5rem 0;
        scroll-margin-top: 100px;
      }

      /* Notion-style outline: a stack of short lines mirroring the
         topbar's back link, fixed just below it. Each line jumps to a
         section; the current section's line goes dark and a touch
         wider. Hidden on narrower viewports where it'd collide with
         the centered column. */
      .toc {
        position: fixed;
        top: 96px;
        right: 2rem;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 9px;
        z-index: 15;
      }

      .toc-line {
        width: 18px;
        height: 1.8px;
        background: #d8d6d0;
        border-radius: 1px;
        transition: background 0.2s ease, width 0.2s ease;
      }

      .toc-line:hover {
        background: #b0b0b0;
      }

      .toc-line.active {
        background: #1f3d2e;
        width: 25px;
      }

      @media (max-width: 1000px) {
        .toc {
          display: none;
        }
      }

      section .label {
        font-size: 0.8rem;
        color: #b0b0b0;
        text-align: center;
        margin: 0 0 1.25rem;
      }

      section h2 {
        font-size: 1.6rem;
        font-weight: 600;
        text-align: center;
        letter-spacing: -0.01em;
        margin: 0 0 2.5rem;
      }

      section p {
        font-size: 1.05rem;
        line-height: 1.75;
        color: #2b2b2b;
        margin: 0 0 1.25rem;
      }

      section p:last-child {
        margin-bottom: 0;
      }

      .solution-item {
        margin-bottom: 4rem;
      }

      .solution-item:last-child {
        margin-bottom: 0;
      }

      .solution-item .tag {
        display: block;
        text-align: center;
        font-size: 0.8rem;
        color: #b0b0b0;
        margin-bottom: 0.5rem;
      }

      .solution-item h3 {
        font-size: 1.25rem;
        font-weight: 600;
        text-align: center;
        margin: 0 0 1.25rem;
      }

      .solution-item img {
        display: block;
        width: 100%;
        border-radius: 4px;
        margin-top: 2rem;
      }

      .quote {
        text-align: center;
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1.55;
        color: #262626;
        max-width: 44ch;
        margin: 0 auto;
      }

      .quote .attribution {
        display: block;
        font-size: 0.85rem;
        font-weight: 400;
        color: #8a8a8a;
        margin-top: 1.5rem;
      }

      footer {
        text-align: center;
        padding: 3rem 0 6rem;
        font-size: 0.85rem;
        color: #8a8a8a;
      }

      footer a {
        text-decoration: underline;
        text-decoration-color: #c9c7c0;
        text-underline-offset: 3px;
      }

      footer a:hover {
        color: #262626;
      }

      .divider {
        height: 1px;
        background: #efeee9;
        max-width: 80px;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <Topbar showBack />

    <div class="col">
      <div class="hero">
        <p class="eyebrow">Case Study</p>
        <h1>{data.title}</h1>
        <p class="summary">{data.summary}</p>
        <div class="meta-row">
          <div class="meta-item">
            <span class="meta-label">Company</span>
            <span class="meta-value">{data.company}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Role</span>
            <span class="meta-value">{data.role}</span>
          </div>
          {
            data.teamSize && (
              <div class="meta-item">
                <span class="meta-label">Team</span>
                <span class="meta-value">{data.teamSize}</span>
              </div>
            )
          }
          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{data.timeframe}</span>
          </div>
        </div>
      </div>
    </div>

    {
      data.coverImage && (
        <div class="hero-media">
          <img src={data.coverImage} alt={data.coverImageAlt ?? `${data.title} interface`} />
        </div>
      )
    }

    <nav class="toc" aria-label="Case study sections">
      <a href="#challenge" class="toc-line" data-toc="challenge" aria-label="Challenge"></a>
      <a href="#approach" class="toc-line" data-toc="approach" aria-label="Approach"></a>
      {
        data.solutionItems && data.solutionItems.length > 0 && (
          <a href="#solution" class="toc-line" data-toc="solution" aria-label="Solution" />
        )
      }
      {data.quote && <a href="#quote" class="toc-line" data-toc="quote" aria-label="Quote" />}
      <a href="#outcome" class="toc-line" data-toc="outcome" aria-label="Outcome"></a>
    </nav>

    <div class="col">
      <section id="challenge">
        <p class="label">Challenge</p>
        {data.challengeHeading && <h2>{data.challengeHeading}</h2>}
        {paragraphs(data.problem).map((p) => <p>{p}</p>)}
      </section>
    </div>

    {
      data.challengeImage && (
        <div class="hero-media">
          <img
            src={data.challengeImage}
            alt={data.challengeImageAlt ?? `${data.title} interface`}
          />
        </div>
      )
    }

    <div class="col">
      <div class="divider"></div>

      <section id="approach">
        <p class="label">Approach</p>
        {data.approachHeading && <h2>{data.approachHeading}</h2>}
        {paragraphs(data.approach).map((p) => <p>{p}</p>)}
      </section>
    </div>

    {data.approachGallery && data.approachGallery.length > 0 && <Carousel slides={data.approachGallery} />}

    {data.wideImage && <WideImage src={data.wideImage.src} alt={data.wideImage.alt} />}

    <div class="col">
      {
        data.solutionItems && data.solutionItems.length > 0 && (
          <>
            <div class="divider" />
            <section id="solution">
              <p class="label">{data.solutionLabel ?? "Solution"}</p>
              {data.solutionHeading && <h2>{data.solutionHeading}</h2>}

              {data.solutionItems.map((item) => (
                <div class="solution-item">
                  <span class="tag">{item.tag}</span>
                  <h3>{item.heading}</h3>
                  {paragraphs(item.body).map((p) => (
                    <p>{p}</p>
                  ))}
                  {item.image && <img src={item.image} alt={item.imageAlt ?? item.heading} />}
                </div>
              ))}
            </section>
          </>
        )
      }
    </div>

    {data.triptych && <Triptych images={data.triptych} />}

    {data.sideBySide && <SideBySide left={data.sideBySide.left} right={data.sideBySide.right} />}

    <div class="col">
      {
        data.quote && (
          <>
            <div class="divider" />
            <section id="quote">
              <blockquote class="quote">
                "{data.quote.text}"
                <span class="attribution">— {data.quote.attribution}</span>
              </blockquote>
            </section>
          </>
        )
      }
    </div>

    {
      data.detailSplit && (
        <DetailSplit main={data.detailSplit.main} detail={data.detailSplit.detail} />
      )
    }

    <div class="col">
      <div class="divider"></div>

      <section id="outcome">
        <p class="label">Outcome</p>
        {data.outcomeHeading && <h2>{data.outcomeHeading}</h2>}
        {paragraphs(data.outcome).map((p) => <p>{p}</p>)}
      </section>
    </div>

    <footer>
      Next case study — <a href={`/work/${next.id}`}>{next.data.title} →</a>
    </footer>

    <script>
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-line");
      const sections = [...tocLinks]
        .map((link) => document.getElementById(link.dataset.toc ?? ""))
        .filter((el): el is HTMLElement => el !== null);

      if (tocLinks.length > 0) {
        tocLinks[0].classList.add("active");
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const link = document.querySelector(`.toc-line[data-toc="${entry.target.id}"]`);
            if (!link) return;
            tocLinks.forEach((l) => l.classList.remove("active"));
            link.classList.add("active");
          });
        },
        { rootMargin: "-40% 0px -50% 0px", threshold: 0 }
      );

      sections.forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
