<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Concept — Text Heavy</title>
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap"
    />
    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: #f4f4f2;
        color: #1a1a1a;
        font-family: "General Sans", ui-sans-serif, system-ui, sans-serif;
      }

      a {
        color: inherit;
      }

      .frame-label {
        position: fixed;
        top: 16px;
        left: 24px;
        color: #b0afaa;
        font-size: 0.7rem;
        z-index: 5;
      }

      .col {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Full-width bar, independent of .col's centering, so the mark sits
         flush against the real page edge the way Interface Craft's does -
         .col below stays centered on its own narrower measure. */
      .topbar {
        display: flex;
        align-items: center;
        padding: 2.5rem 2rem 0;
      }

      .logo-mark {
        display: inline-grid;
        grid-template-columns: repeat(4, 7px);
        grid-template-rows: repeat(4, 7px);
        gap: 3px;
      }

      .logo-mark .px {
        width: 4px;
        height: 4px;
        opacity: 0;
        transform: scale(0.3);
        transition: opacity 0.25s ease, transform 0.25s ease;
      }

      .logo-mark .px.in {
        opacity: 1;
        transform: scale(1);
      }

      .intro {
        margin-top: 3.5rem;
      }

      .intro p {
        font-size: 1.15rem;
        line-height: 1.75;
        color: #2b2b2b;
        margin: 0 0 1.25rem;
      }

      .intro p:last-child {
        margin-bottom: 0;
      }

      .intro a {
        text-decoration: underline;
        text-decoration-color: #b0afaa;
        text-underline-offset: 3px;
      }

      .intro a:hover {
        text-decoration-color: #1a1a1a;
      }

      section {
        padding: 3.5rem 0;
      }

      .section-heading {
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #8a8a8a;
        margin: 0 0 0.875rem;
      }

      .work-list {
        margin: 0 -0.9rem;
      }

      /* Hover highlight bleeds past the text measure on both sides, which is
         why each row gets its own horizontal padding instead of inheriting
         .col's - the highlight needs to extend beyond where the text sits. */
      .work-row {
        display: block;
        padding: 1.1rem 0.9rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      .work-row:hover {
        background: #eae9e5;
      }

      .work-row .title {
        font-size: 1.05rem;
        font-weight: 500;
        color: #1a1a1a;
        display: block;
        margin-bottom: 0.3rem;
      }

      .work-row .row-bottom {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
      }

      .work-row .desc {
        font-size: 0.92rem;
        color: #8a8a8a;
      }

      .work-row .meta {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        flex-shrink: 0;
      }

      .work-row .year {
        font-size: 0.85rem;
        color: #9a9994;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .work-row .icon {
        font-size: 0.85rem;
        color: #c9c7c0;
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
        display: inline-block;
      }

      .work-row:hover .icon {
        opacity: 1;
        color: #6b6b6b;
      }

      .work-row:hover .icon.external {
        transform: translate(2px, -2px);
      }

      .work-row:hover .icon.internal {
        transform: translateX(2px);
      }

      footer {
        margin-top: 1rem;
        padding: 1.75rem 0 6rem;
        border-top: 1px solid #e2e0da;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #8a8a8a;
        flex-wrap: wrap;
        gap: 1rem;
      }

      footer .who {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      }

      footer .who .name {
        color: #1a1a1a;
        font-weight: 500;
      }

      footer .links {
        display: flex;
        gap: 0.9rem;
      }

      footer a {
        text-decoration: none;
      }

      footer a:hover {
        color: #1a1a1a;
      }
    </style>
  </head>
  <body>
    <div class="frame-label">Concept — Text Heavy</div>

    <div class="topbar">
      <span class="logo-mark" id="logo-mark" aria-hidden="true"></span>
    </div>

    <div class="col">
      <div class="intro">
        <p>
          I'm <a href="/about">Humayun Rashid</a>, a product designer and founder based in New
          York City. Most recently I led design at <a href="/work/sublime-security"
            >Sublime Security</a
          >, working with security teams designing the best in class email security platform
          on the market. Prior, I was the founder and Design Director at Nessa Labs, an early
          stage design studio for ambitious SaaS founders. I've advised and designed countless
          products for founders.
        </p>
        <p>
          I care about the parts of a product that don't show up in a screenshot, the
          onboarding flow nobody notices, the empty state that makes someone feel dumb, the
          setting that should've been a default. That's usually where the real work is.
        </p>
      </div>

      <section>
        <p class="section-heading">Select Work</p>

        <div class="work-list">
          <a class="work-row" href="#" target="_blank" rel="noopener">
            <span class="title">Sublime Security</span>
            <span class="row-bottom">
              <span class="desc">Led product design for security teams to stop malicious threats.</span>
              <span class="meta">
                <span class="year">2026</span>
                <span class="icon external">↗</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="#" target="_blank" rel="noopener">
            <span class="title">Nessa Labs</span>
            <span class="row-bottom">
              <span class="desc">Founder &amp; Design Director of product design studio for early stage startups.</span>
              <span class="meta">
                <span class="year">2021 – 2026</span>
                <span class="icon external">↗</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/pack">
            <span class="title">Pack Platform</span>
            <span class="row-bottom">
              <span class="desc">Product redesign for headless commerce platform.</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/ppvp">
            <span class="title">PPVP</span>
            <span class="row-bottom">
              <span class="desc">Mobile app design for investment platform for early stage funding.</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/inveterate">
            <span class="title">Inveterate</span>
            <span class="row-bottom">
              <span class="desc">Product strategy and design for loyalty and membership platform.</span>
              <span class="meta">
                <span class="year">2022</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="#" target="_blank" rel="noopener">
            <span class="title">Shopping Gives</span>
            <span class="row-bottom">
              <span class="desc">Product strategy and design for donation enablement platform.</span>
              <span class="meta">
                <span class="year">2022</span>
                <span class="icon external">↗</span>
              </span>
            </span>
          </a>
        </div>
      </section>

      <footer>
        <span class="who">
          <span class="name">Humayun Rashid</span>
          <span id="nyc-time">NYC —:— —</span>
        </span>
        <span class="links">
          <a href="#">LinkedIn</a>
          <a href="#">Twitter</a>
          <a href="#">Github</a>
          <a href="#">CV</a>
        </span>
      </footer>
    </div>

    <script>
      // H + R monogram, 9x11 pixels. H's right stroke and R's left stem
      // share column 4, merging both letters into one mark instead of two
      // side by side - a 4x4 grid genuinely can't fit both letterforms
      // legibly, this is the smallest resolution that reads clearly (
      // verified by scaling it up during development). "#" = letterform,
      // always the same dark green. "." = filler, always the same subtle
      // grey - fixed colors now, not randomized, per Hum's spec.
      // Back to a strict 4x4 - stays inside that constraint even though it
      // means H and R can only be gestured at, not spelled out cleanly.
      // Left column = H's stroke, row1 = H's crossbar reaching across,
      // right two columns sketch R's stem + bowl corner + diagonal foot.
      // Obscure is the point here, not legibility.
      const LOGO_MASK = ["#..#", "###.", "#..#", "#.##"];

      const LETTER_COLOR = "#1f3d2e";
      const FILLER_COLOR = "#dcdcd8";
      const TOTAL_DURATION_MS = 1600;

      const cells = LOGO_MASK.join("").split("");
      const logoEl = document.getElementById("logo-mark");
      const seen = sessionStorage.getItem("hr-logo-seen");
      const perCellDelay = TOTAL_DURATION_MS / cells.length;

      cells.forEach((ch, i) => {
        const px = document.createElement("span");
        px.className = "px";
        px.style.background = ch === "#" ? LETTER_COLOR : FILLER_COLOR;
        logoEl.appendChild(px);
        if (seen) {
          // Already played this session - show it immediately, no replay.
          px.classList.add("in");
        } else {
          setTimeout(() => px.classList.add("in"), i * perCellDelay);
        }
      });
      sessionStorage.setItem("hr-logo-seen", "1");

      const el = document.getElementById("nyc-time");
      function updateClock() {
        const time = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          minute: "2-digit",
          hour12: true,
        }).format(new Date());
        el.textContent = `NYC ${time}`;
      }
      updateClock();
      setInterval(updateClock, 1000);
    </script>
  </body>
</html>
