---
import AppShell from "../../components/saas/AppShell.tsx";
import "../../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Humayun Rashid · App</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Caveat:wght@500;600&family=Architects+Daughter&display=swap" rel="stylesheet" />
    <script is:inline>
      // Same rule as the rest of the portfolio (Topbar.astro): dark from
      // 7pm to 6am New York time. Case studies open inside this shell, so
      // the shell and the page in the frame always agree.
      (function () {
        function isNight() {
          var parts = new Intl.DateTimeFormat("en-US", {
            timeZone: "America/New_York",
            hour: "numeric",
            hour12: false,
          }).formatToParts(new Date());
          var hour = Number(
            parts.filter(function (p) {
              return p.type === "hour";
            })[0].value
          );
          return hour >= 19 || hour < 6;
        }
        // A choice made with the sidebar toggle wins over the clock.
        function apply() {
          var saved = null;
          try {
            saved = localStorage.getItem("site-theme");
          } catch (e) {}
          var dark = saved ? saved === "dark" : isNight();
          document.documentElement.classList.toggle("dark", dark);
        }
        apply();
        setInterval(apply, 60000);

        // First visit, or any visit with ?intro: hold the panel's content
        // back for the loader. A first visit in a hidden tab skips it,
        // since nothing could play there.
        try {
          var forced = /[?&]intro\b/.test(location.search);
          if (forced || (!document.hidden && !localStorage.getItem("site3-intro-seen"))) {
            document.documentElement.classList.add("saas-intro");
          }
        } catch (e) {}
      })();
    </script>
    <style is:global>
      /* The shell draws itself once the script has loaded; until then the
         page is the shell's own frame color, light or dark. */
      body {
        margin: 0;
        background: oklch(0.965 0.002 270);
      }
      html.dark body {
        background: oklch(0.215 0.004 270);
      }
    </style>
  </head>
  <body>
    <AppShell client:only="react" />
  </body>
</html>
