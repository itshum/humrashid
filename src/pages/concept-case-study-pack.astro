---
import "../styles/global.css";
import { MediaSlider } from "../components/case-study/MediaSlider";
import MediaHero from "../components/case-study/MediaHero.astro";
import MediaCentered from "../components/case-study/MediaCentered.astro";
import MediaSideBySide from "../components/case-study/MediaSideBySide.astro";
import MediaMasonry from "../components/case-study/MediaMasonry.astro";
import MediaSplit from "../components/case-study/MediaSplit.astro";
import Grid from "../components/layout/Grid.astro";
import { GridOverlay } from "../components/layout/GridOverlay";

const p = (name: string) => `/case-studies/pack/${name}`;

// Reused span patterns.
const prose = "col-span-4 md:col-span-6 lg:col-span-8";
const wide = "col-span-4 md:col-span-8 lg:col-span-12";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Concept — Case Study Layout (Pack)</title>
    <style is:global>
      body {
        font-family: ui-sans-serif, system-ui, sans-serif;
        color: #171717;
      }

      .top-bar {
        position: sticky;
        top: 0;
        background: #fff;
        border-bottom: 1px solid #eee;
        padding: 1rem 2rem;
        font-size: 0.8rem;
        color: #888;
        z-index: 10;
      }

      .hero .eyebrow {
        font-size: 0.8rem;
        color: #888;
        margin: 0 0 0.75rem;
      }

      .hero h1 {
        font-size: 3rem;
        font-weight: 500;
        margin: 0 0 1rem;
        letter-spacing: -0.02em;
      }

      .hero .summary {
        font-size: 1.25rem;
        color: #444;
        max-width: 46ch;
        margin: 0 0 2rem;
      }

      .meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        font-size: 0.85rem;
        padding: 1.5rem 0;
        border-top: 1px solid #eee;
      }

      .meta div span {
        display: block;
        color: #888;
        font-size: 0.75rem;
        margin-bottom: 0.25rem;
      }

      section {
        padding: 4.5rem 0;
      }

      section + section {
        border-top: 1px solid #eee;
      }

      .section-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #888;
        margin: 0 0 1.25rem;
      }

      .component-tag {
        display: inline-block;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #7c3aed;
        background: #f5f3ff;
        border: 1px solid #ddd6fe;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        margin-bottom: 0.75rem;
      }

      section h2 {
        font-size: 1.9rem;
        font-weight: 500;
        margin: 0 0 1.5rem;
        letter-spacing: -0.01em;
      }

      section p {
        margin: 0 0 1.25rem;
        color: #333;
        line-height: 1.6;
      }

      .solution-item {
        margin-bottom: 4.5rem;
      }

      .solution-item:last-child {
        margin-bottom: 0;
      }

      .solution-item h3 {
        font-size: 1.3rem;
        font-weight: 500;
        margin: 0 0 0.75rem;
      }

      .solution-item .tag {
        display: inline-block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #888;
        margin-bottom: 0.5rem;
      }

      .sub-media {
        margin-top: 1.5rem;
      }

      .confirm {
        color: #b45309;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        padding: 0.15rem 0.4rem;
        border-radius: 3px;
        font-size: 0.85em;
      }

      .footer-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 3rem 2rem;
        border-top: 1px solid #eee;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <GridOverlay client:load />

    <div class="top-bar">
      Concept — Case Study Layout (Pack) · real 12-col responsive grid (4 mobile / 8 tablet / 12
      desktop+xl) · press "g" or the button to toggle column guides
    </div>

    <!-- HERO — MediaHero component -->
    <span class="component-tag" style="margin: 1rem 2rem 0; display: inline-block;"
      >Component: MediaHero</span
    >
    <MediaHero src={p("01-hero-a.webp")} alt="Pack platform hero interface" />

    <Grid class="hero" style="padding-top: 3rem;">
      <div class={prose}>
        <p class="eyebrow">Case Study</p>
        <h1>Pack</h1>
        <p class="summary">
          Turning an agency's custom commerce builds into a real product, without losing what
          made those builds good.
        </p>
        <div class="meta">
          <div><span>Company</span>Pack</div>
          <div><span>Role</span>Lead Designer &amp; Design Director, Nessa Labs</div>
          <div><span>Timeframe</span><span class="confirm">confirm dates</span></div>
          <div><span>Team</span>4 at Nessa</div>
        </div>
      </div>
    </Grid>

    <!-- CHALLENGE — MediaCentered component -->
    <section>
      <Grid>
        <div class={prose}>
          <p class="section-label">Challenge</p>
          <h2>From bespoke builds to a real product</h2>
          <p>
            Pack started as an agency, building fully custom headless commerce sites for brands
            like Cuts and Vuori. That work was good precisely because it was custom: a small
            team hand-building one storefront at a time, solving each brand's problems
            directly.
          </p>
          <p>
            After closing their seed round, Pack needed to become a product. The same team, the
            same expertise, but now serving hundreds of merchants instead of a handful of
            clients.
          </p>
          <p>
            I led design on this transition, working directly with Pack's product and
            engineering team, including CEO Cory Cummings, to figure out what "productized"
            actually meant here.
          </p>
        </div>
      </Grid>
      <Grid class="sub-media">
        <div class={prose}>
          <span class="component-tag">Component: MediaCentered (~90% width)</span>
          <MediaCentered
            src={p("03-s01-transition-desktop.webp")}
            alt="Agency to SaaS transition visual"
          />
        </div>
      </Grid>
    </section>

    <!-- APPROACH — text only, no media needed here -->
    <section>
      <Grid>
        <div class={prose}>
          <p class="section-label">Approach</p>
          <h2>Interviews before screens</h2>
          <p>
            We started with interviews, not screens. My team and I talked to merchants who'd
            tried other headless platforms to find out where they actually got stuck, not
            where we assumed they would.
          </p>
          <p>
            That research shaped a hard call early on: build less, but build it right. Rather
            than chase feature parity with every competitor, we prioritized the handful of
            workflows that would make or break someone's first week on the platform.
          </p>
        </div>
      </Grid>
    </section>

    <!-- SOLUTION -->
    <section>
      <Grid>
        <div class={wide}>
          <p class="section-label">Solution</p>
          <h2 style="margin-bottom: 3rem;">Four problems worth solving well</h2>

          <!-- 01 Customizer — MediaSplit + MediaSlider -->
          <div class="solution-item">
            <span class="component-tag">Component: MediaSplit</span>
            <MediaSplit
              src={p("12-s02-customizer-sidebar-desktop.webp")}
              alt="Site customizer sidebar"
            >
              <p class="tag">01 — The site customizer</p>
              <h3>Real editing, not an abstraction of it</h3>
              <p>
                Most WYSIWYG site builders make you choose between flexibility and simplicity,
                usually failing at both. We rebuilt the customizer around a sidebar that slides
                out over a live preview of the actual storefront.
              </p>
            </MediaSplit>
            <div class="sub-media">
              <span class="component-tag">Component: MediaSlider (drag + arrows)</span>
              <MediaSlider
                client:load
                images={[
                  {
                    src: p("13-s02-realtime-editing-desktop.webp"),
                    alt: "Real-time page editing",
                  },
                  {
                    src: p("14-s02-banner-slideshow-desktop.webp"),
                    alt: "Banner slideshow component",
                  },
                  {
                    src: p("15-s02-product-carousel-desktop.webp"),
                    alt: "Product carousel component",
                  },
                  { src: p("16-s02-video-module-desktop.webp"), alt: "Video module component" },
                  { src: p("17-s02-rich-text-desktop.webp"), alt: "Rich text editing component" },
                ]}
              />
            </div>
          </div>

          <!-- 02 Dashboard — MediaSplit reversed -->
          <div class="solution-item">
            <span class="component-tag">Component: MediaSplit (reverse)</span>
            <MediaSplit
              src={p("04-s01-dashboard-customization-desktop.webp")}
              alt="Dashboard customization"
              reverse
            >
              <p class="tag">02 — The dashboard</p>
              <h3>One place to understand the store</h3>
              <p>
                Store owners needed one place to understand how their storefront was actually
                performing: revenue, traffic, conversion, site speed.
              </p>
            </MediaSplit>
          </div>

          <!-- 03 Merchandising — MediaSplit + MediaSideBySide -->
          <div class="solution-item">
            <span class="component-tag">Component: MediaSplit</span>
            <MediaSplit
              src={p("06-s01-merchandising-desktop.webp")}
              alt="Product merchandising interface"
            >
              <p class="tag">03 — Merchandising</p>
              <h3>Bundles in a few clicks, not a spreadsheet</h3>
              <p>
                We redesigned this so merchants could build product bundles and collections
                through intelligent, attribute-based grouping instead of manual, one-by-one
                setup.
              </p>
            </MediaSplit>
            <div class="sub-media">
              <span class="component-tag">Component: MediaSideBySide</span>
              <MediaSideBySide
                left={{ src: p("07-s01-bundling-desktop.webp"), alt: "Product bundling feature" }}
                right={{
                  src: p("08-s01-collection-building-desktop.webp"),
                  alt: "Collection building",
                }}
              />
            </div>
          </div>

          <!-- 04 Developer experience — MediaSplit + MediaSlider -->
          <div class="solution-item">
            <span class="component-tag">Component: MediaSplit (reverse)</span>
            <MediaSplit
              src={p("09-s01-dev-onboarding-desktop.webp")}
              alt="Developer onboarding"
              reverse
            >
              <p class="tag">04 — Developer experience</p>
              <h3>Opinion-free setup, built for developers</h3>
              <p>
                Modern headless builds mean wrangling a pile of apps. We stripped the setup
                down so developers could plug into Git with their own API keys and start
                building without an opinionated workflow forced on them.
              </p>
            </MediaSplit>
            <div class="sub-media">
              <span class="component-tag">Component: MediaSlider (drag + arrows)</span>
              <MediaSlider
                client:load
                images={[
                  { src: p("10-s01-git-integration-desktop.webp"), alt: "Git integration interface" },
                  { src: p("11-s01-deploy-logs-desktop.webp"), alt: "Deploy status logs" },
                ]}
              />
            </div>
          </div>
        </div>
      </Grid>
    </section>

    <!-- SECONDARY — MediaMasonry -->
    <section>
      <Grid>
        <div class={wide}>
          <p class="section-label">Also shipped</p>
          <h2 style="font-size: 1.4rem;">Design system &amp; mobile access</h2>
          <p style="max-width: 65ch;">
            We also shipped a global design system so Pack's team could keep building
            consistently after handoff, and made sure core merchant workflows worked properly
            on mobile.
          </p>
          <div class="sub-media">
            <span class="component-tag">Component: MediaMasonry (4-image asymmetric grid)</span>
            <MediaMasonry
              images={[
                { src: p("20-s04-iconography-desktop.webp"), alt: "Design system iconography" },
                { src: p("21-s04-color-palette-desktop.png"), alt: "Design system color palette" },
                { src: p("22-s04-ui-components-desktop.webp"), alt: "UI components library" },
                {
                  src: p("23-s04-usage-examples-desktop.webp"),
                  alt: "Design system usage examples",
                },
              ]}
            />
          </div>
        </div>
      </Grid>
    </section>

    <!-- QUOTE -->
    <section>
      <Grid>
        <div class={prose}>
          <p class="section-label">Quote (placement to test — wording pending)</p>
          <blockquote
            style="border-left: 2px solid #ddd; padding-left: 1.25rem; font-size: 1.1rem; color: #444; font-style: italic;"
          >
            "The new Pack platform gives brands and agencies powerful front-end tools to
            communicate with customers more easily..."
            <span class="confirm">reattribution pending</span>
            <br />— Cory Cummings, CEO at Pack
          </blockquote>
        </div>
      </Grid>
    </section>

    <!-- OUTCOME -->
    <section style="background: #fafafa;">
      <Grid>
        <div class={prose}>
          <p class="section-label">Outcome</p>
          <h2 style="font-size: 1.4rem;">Qualitative — how merchants received the redesign</h2>
          <p style="color: #888; font-style: italic;">
            Copy pending, direction confirmed 2026-08-30.
          </p>
        </div>
      </Grid>
    </section>

    <div class="footer-nav">
      <span>← Back to Work</span>
      <span>Next case study →</span>
    </div>
  </body>
</html>
