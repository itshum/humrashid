---
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/Footer.astro";

const apps = [
  {
    slug: "rendr",
    name: "rendr",
    desc: "Polished backgrounds for any screenshot.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/apps" />
    <script is:inline>
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>Apps · Humayun Rashid</title>
    <meta
      name="description"
      content="Small standalone tools built by Humayun Rashid."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      :root {
        --bg: #f6f6f3;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #e8e7e2;
        --title: #262626;
        --year: #8a8984;
        --border: #e0ded7;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .col-wide {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col,
        .col-wide {
          padding: 0 2rem;
        }
      }

      .hero {
        padding: 4.2rem 0 2.5rem;
      }

      .hero .eyebrow {
        font-size: 0.8rem;
        color: var(--label);
        margin: 0 0 1.25rem;
      }

      .hero h1 {
        font-size: 1.15rem;
        font-weight: 400;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 46ch;
        margin: 0;
        text-wrap: balance;
      }

      /* --- Card grid --- */
      .app-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        padding: 0 0 8rem;
      }

      @media (max-width: 700px) {
        .app-grid {
          grid-template-columns: 1fr;
        }
      }

      /* Variant E: plain bordered card, one quiet gradient swatch as
         the preview (no nested UI chrome, no composed scene) and a
         faint tint shift into the text footer - restraint over
         illustration. */
      .app-card {
        display: block;
        text-decoration: none;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        background: var(--bg);
        transition: border-color 0.15s ease, transform 0.15s ease;
      }

      .app-card:hover {
        border-color: var(--label);
        transform: translateY(-2px);
      }

      .app-card-body {
        padding: 1.1rem 1.25rem 1.3rem;
        background: var(--hover-bg);
      }

      .app-card .title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .app-card .title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--title);
      }

      .app-card .icon {
        font-size: 0.85rem;
        color: var(--label);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }

      .app-card:hover .icon {
        opacity: 1;
        transform: translateX(2px);
      }

      .app-card .desc {
        display: block;
        font-size: 0.88rem;
        line-height: 1.5;
        color: var(--label);
        margin-top: 0.4rem;
      }

      .app-preview {
        aspect-ratio: 16 / 11;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 30% 30%, #f5b9d6, transparent 65%),
          radial-gradient(circle at 75% 70%, #8c6fd6, transparent 65%), #170f1f;
      }

      /* The one visual metaphor: your image, placed on a background -
         nothing else, no UI chrome. */
      .app-preview .frame {
        width: 32%;
        aspect-ratio: 1;
        background: rgba(255, 255, 255, 0.94);
        border-radius: 6px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      }
    </style>
  </head>
  <body>
    <Topbar showBack />

    <div class="col-wide">
      <div class="hero">
        <p class="eyebrow">Apps</p>
        <h1>Small standalone tools, built and shipped one at a time.</h1>
      </div>

      <div class="app-grid">
        {
          apps.map((app) => (
            <a class="app-card" href={`/apps/${app.slug}/`}>
              <div class="app-preview">
                <div class="frame" />
              </div>
              <div class="app-card-body">
                <span class="title-row">
                  <span class="title">{app.name}</span>
                  <span class="icon" aria-hidden="true">→</span>
                </span>
                <span class="desc">{app.desc}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <Footer />
  </body>
</html>
