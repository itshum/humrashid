---
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";

---

<!doctype html>
<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/apps" />
    <script is:inline>
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>Apps · Humayun Rashid</title>
    <meta
      name="description"
      content="Small standalone tools built by Humayun Rashid."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Space+Grotesk:wght@700&family=Cormorant+Garamond:wght@700&display=swap"
    />
    <style is:global>
      :root {
        --bg: #f6f6f3;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #e8e7e2;
        --title: #262626;
        --year: #8a8984;
        --border: #e0ded7;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
        --theme-progress: 1;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
        --theme-progress: 0;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      /* Sticky footer: with only two cards, content is shorter than
         the viewport, so without this the footer sits mid-page with a
         dead gap of background beneath it instead of anchoring to the
         bottom edge. .col (the main content) takes the flexible share
         of a full-height column; the footer keeps its natural height
         and lands at the bottom whenever content is short, while
         still flowing after longer content normally. */
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      body > .col {
        flex: 1;
      }

      /* As a direct flex child of body, the footer's own centering
         (max-width + margin: 0 auto) shrinks to fit its content
         instead of filling out to that max-width - a flexbox quirk
         with auto margins on a stretched item. width: 100% forces it
         back to the same 718px column every other page uses. */
      body > .site-footer {
        width: 100%;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .col-wide {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col,
        .col-wide {
          padding: 0 2rem;
        }
      }

      .hero {
        padding: 6rem 0 2rem;
      }

      .hero h1 {
        font-size: 1rem;
        font-weight: 400;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
      }

      /* --- Card grid --- */
      /* Two columns within the same measure as the footer beneath it
         (.col, not .col-wide) so the grid's outer edges line up with
         the footer content rather than sitting wider than it. */
      .app-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
        padding: 0 0 8rem;
      }

      @media (max-width: 560px) {
        .app-list {
          grid-template-columns: 1fr;
        }
      }

      /* The image and the text below it are two separate, unboxed
         elements - not one shared bordered container. The preview
         tile carries its own rounded corners; the text sits below it
         with a gap and gets a highlight of its own only on hover. */
      .app-card {
        display: block;
        text-decoration: none;
      }

      .app-card-body {
        margin-top: 0.75rem;
        padding: 0.6rem 0.7rem;
        border-radius: 6px;
        transition: background 0.15s ease;
      }

      /* Hover selects over the logo + subtext + arrow together, as one
         highlighted unit - the image tile above is untouched. */
      .app-card:hover .app-card-body {
        background: var(--hover-bg);
      }

      .app-card .title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .app-card .title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--title);
      }

      .app-card .icon {
        font-size: 0.85rem;
        color: var(--label);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }

      .app-card:hover .icon {
        opacity: 1;
        transform: translateX(2px);
      }

      .app-card .desc {
        display: block;
        font-size: 0.88rem;
        line-height: 1.5;
        color: var(--label);
        margin-top: 0.4rem;
      }

      /* Each preview is a small, simplified sample of the product's
         own real UI structure (see src/pages/apps/rendr/ and
         src/pages/apps/atrium/), in its actual palette - not a
         fabricated icon. Shorter than before (2:1 vs. the old 16:11)
         so the card reads more like a compact tile. */
      .app-preview {
        position: relative;
        aspect-ratio: 2 / 1;
        overflow: hidden;
        border-radius: 8px;
        background: #08090a;
      }

      /* --- rendr: sidebar controls + canvas, like the real app shell --- */
      .rendr-mock {
        display: flex;
        width: 100%;
        height: 100%;
      }

      .rendr-mock-panel {
        flex: none;
        width: 36%;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.6rem 0.7rem;
        background: rgba(255, 255, 255, 0.04);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
      }

      .rendr-mock-label {
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        font-size: 0.5rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(247, 248, 248, 0.45);
      }

      .rendr-mock-track {
        height: 5px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.1);
        overflow: hidden;
      }

      /* Ambient, looping detail animation - like iteration.design's
         tiny UI icons that quietly cycle on their own rather than
         sitting static - gives the impression of someone actually
         adjusting the tool, not a frozen screenshot. Subtle and slow
         on purpose, and switched off entirely under reduced motion. */
      .rendr-mock-fill {
        width: 55%;
        height: 100%;
        background: #ff5a1f;
        animation: rendr-mock-fill-shift 5s ease-in-out infinite;
      }

      @keyframes rendr-mock-fill-shift {
        0%,
        100% {
          width: 40%;
        }
        50% {
          width: 68%;
        }
      }

      .rendr-mock-swatches {
        display: flex;
        gap: 0.3rem;
      }

      .rendr-mock-swatches span {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.18);
        animation: rendr-mock-swatch-pulse 4.5s ease-in-out infinite;
      }

      .rendr-mock-swatches span:nth-child(2) {
        animation-delay: 1.5s;
      }

      .rendr-mock-swatches span:nth-child(3) {
        animation-delay: 3s;
      }

      @keyframes rendr-mock-swatch-pulse {
        0%,
        28% {
          box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.55);
        }
        34%,
        100% {
          box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .rendr-mock-fill,
        .rendr-mock-swatches span {
          animation: none;
        }
      }

      /* Mirrors the real panel's dashed upload dropzone, shrunk down -
         same shape/border treatment, just an icon instead of copy. */
      .rendr-mock-dropzone {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        border: 1px dashed rgba(255, 255, 255, 0.22);
        border-radius: 6px;
        margin-bottom: 0.15rem;
      }

      .rendr-mock-dropzone svg {
        width: 11px;
        height: 11px;
        color: rgba(247, 248, 248, 0.4);
      }

      .rendr-mock-export {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        border-radius: 5px;
        background: #ff5a1f;
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        font-size: 0.55rem;
        font-weight: 600;
        color: #1a0d05;
      }

      .rendr-mock-canvas {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.035) 25%, transparent 25%),
          linear-gradient(-45deg, rgba(255, 255, 255, 0.035) 25%, transparent 25%),
          linear-gradient(45deg, transparent 75%, rgba(255, 255, 255, 0.035) 75%),
          linear-gradient(-45deg, transparent 75%, rgba(255, 255, 255, 0.035) 75%);
        background-size: 12px 12px;
        background-position: 0 0, 0 6px, 6px -6px, -6px 0;
      }

      .rendr-mock-image {
        position: relative;
        width: 58%;
        aspect-ratio: 4 / 3;
        border-radius: 10px;
        background: radial-gradient(circle at 25% 25%, #f5b9d6, transparent 60%),
          radial-gradient(circle at 60% 55%, #f2a56a, transparent 60%), radial-gradient(circle at 90% 90%, #8c6fd6, transparent 60%),
          #170f1f;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
      }

      /* The actual product places an uploaded screenshot on top of a
         generated background - so the mini preview shows that same
         relationship: a small "screenshot" (its own window chrome,
         a title bar dot, a couple of content lines) sitting on the
         gradient, rather than the gradient alone standing in for it. */
      .rendr-mock-shot {
        position: absolute;
        inset: 12% 16%;
        border-radius: 6px;
        background: #f8f7f4;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
        overflow: hidden;
      }

      .rendr-mock-shot-bar {
        height: 16%;
        display: flex;
        align-items: center;
        gap: 3px;
        padding: 0 0.35rem;
        background: #e5e0d5;
      }

      .rendr-mock-shot-bar span {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: rgba(43, 36, 32, 0.25);
      }

      .rendr-mock-shot-lines {
        padding: 0.35rem 0.45rem;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .rendr-mock-shot-lines span {
        display: block;
        height: 4px;
        border-radius: 2px;
        background: rgba(43, 36, 32, 0.16);
      }

      .rendr-mock-shot-lines span:first-child {
        width: 70%;
        background: rgba(255, 90, 31, 0.4);
      }

      .rendr-mock-shot-lines span:nth-child(2) {
        width: 90%;
      }

      .rendr-mock-shot-lines span:nth-child(3) {
        width: 60%;
      }

      /* --- Atrium: a slice of the real book grid, with actual cover
         photography (see src/content/atrium/) instead of flat color
         swatches - same title-scrim + kicker treatment as the real
         cards. */
      .app-preview-atrium {
        background: #f3ead9;
      }

      .atrium-mock {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        width: 100%;
        height: 100%;
        padding: 0 1rem;
      }

      .atrium-mock-card {
        width: 26%;
      }

      .atrium-mock-cover {
        position: relative;
        aspect-ratio: 2 / 3;
        border-radius: 2px;
        margin-bottom: 0.35rem;
        background-size: cover;
        background-position: center;
        box-shadow: 0 6px 14px rgba(43, 36, 32, 0.25);
        /* Same "quietly alive" ambient loop as rendr's mock - a soft
           lift drifts across the three covers in sequence, echoing
           the real grid's own hover-lift instead of holding still. */
        animation: atrium-mock-cover-lift 6s ease-in-out infinite;
        display: flex;
        align-items: flex-end;
        padding: 0.3rem;
        overflow: hidden;
      }

      .atrium-mock-cover::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(20, 14, 10, 0.82), rgba(20, 14, 10, 0) 55%);
      }

      .atrium-mock-cover-title {
        position: relative;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-weight: 600;
        font-size: 0.68rem;
        line-height: 1.15;
        color: rgba(255, 255, 255, 0.94);
      }

      .atrium-mock-line {
        height: 5px;
        border-radius: 2px;
        background: rgba(92, 58, 46, 0.3);
      }

      .atrium-mock-line-title {
        width: 85%;
        margin-bottom: 0.28rem;
      }

      .atrium-mock-line-sub {
        width: 55%;
        background: rgba(92, 58, 46, 0.18);
      }

      .atrium-mock-card:nth-child(2) .atrium-mock-cover {
        animation-delay: 2s;
      }

      .atrium-mock-card:nth-child(3) .atrium-mock-cover {
        animation-delay: 4s;
      }

      @keyframes atrium-mock-cover-lift {
        0%,
        100% {
          transform: translateY(0);
          box-shadow: 0 6px 14px rgba(43, 36, 32, 0.25);
        }
        50% {
          transform: translateY(-3px);
          box-shadow: 0 10px 20px rgba(43, 36, 32, 0.3);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .atrium-mock-cover {
          animation: none;
        }
      }

      .app-preview-atrium .brand-mark {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-weight: 700;
        font-size: 2.1rem;
        letter-spacing: -0.01em;
        color: #5c3a2e;
      }
    </style>
  </head>
  <body>
    <Topbar showBack />

    <div class="col">
      <div class="hero">
        <h1>Standalone tools and apps I'm designing and building as novel software experiments.</h1>
      </div>

      <div class="app-list">
        <a class="app-card" href="/apps/rendr/">
          <div class="app-preview">
            <div class="rendr-mock">
              <div class="rendr-mock-panel">
                <div class="rendr-mock-dropzone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 15V4" />
                    <path d="M7.5 8.5 12 4l4.5 4.5" />
                    <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
                  </svg>
                </div>
                <div class="rendr-mock-label">Radius</div>
                <div class="rendr-mock-track"><div class="rendr-mock-fill" /></div>
                <div class="rendr-mock-label">Background</div>
                <div class="rendr-mock-swatches">
                  <span style="background: #ff5a1f;" />
                  <span style="background: #8c6fd6;" />
                  <span style="background: #2f8f6e;" />
                </div>
                <div class="rendr-mock-export">Export</div>
              </div>
              <div class="rendr-mock-canvas">
                <div class="rendr-mock-image">
                  <div class="rendr-mock-shot">
                    <div class="rendr-mock-shot-bar"><span /><span /><span /></div>
                    <div class="rendr-mock-shot-lines"><span /><span /><span /></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="app-card-body">
            <span class="title-row">
              <span class="title">rendr</span>
              <span class="icon" aria-hidden="true">→</span>
            </span>
            <span class="desc">Polished backgrounds for any image to share across social.</span>
          </div>
        </a>

        <a class="app-card" href="/apps/atrium/">
          <div class="app-preview app-preview-atrium">
            <div class="atrium-mock">
              <div class="atrium-mock-card">
                <div class="atrium-mock-cover" style="background-image: url(/atrium-art/death-of-socrates.jpg);">
                  <span class="atrium-mock-cover-title">Phaedo</span>
                </div>
                <div class="atrium-mock-line atrium-mock-line-title" />
                <div class="atrium-mock-line atrium-mock-line-sub" />
              </div>
              <div class="atrium-mock-card">
                <div class="atrium-mock-cover" style="background-image: url(/atrium-art/school-of-athens.jpg);">
                  <span class="atrium-mock-cover-title">The Republic</span>
                </div>
                <div class="atrium-mock-line atrium-mock-line-title" />
                <div class="atrium-mock-line atrium-mock-line-sub" />
              </div>
              <div class="atrium-mock-card">
                <div class="atrium-mock-cover" style="background-image: url(/atrium-art/oath-of-the-horatii.jpg);">
                  <span class="atrium-mock-cover-title">Meditations</span>
                </div>
                <div class="atrium-mock-line atrium-mock-line-title" />
                <div class="atrium-mock-line atrium-mock-line-sub" />
              </div>
            </div>
          </div>
          <div class="app-card-body">
            <span class="title-row">
              <span class="title">Atrium</span>
              <span class="icon" aria-hidden="true">→</span>
            </span>
            <span class="desc">A curated library of books, articles and sites worth your time.</span>
          </div>
        </a>
      </div>
    </div>

    <Footer />
  </body>
</html>
