---
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/Footer.astro";

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/apps" />
    <script is:inline>
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>Apps · Humayun Rashid</title>
    <meta
      name="description"
      content="Small standalone tools built by Humayun Rashid."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      :root {
        --bg: #f6f6f3;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #e8e7e2;
        --title: #262626;
        --year: #8a8984;
        --border: #e0ded7;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .col-wide {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col,
        .col-wide {
          padding: 0 2rem;
        }
      }

      .hero {
        padding: 4.2rem 0 2.5rem;
      }

      .hero h1 {
        font-size: 1rem;
        font-weight: 400;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
      }

      /* --- Card grid --- */
      /* Two columns within the same measure as the footer beneath it
         (.col, not .col-wide) so the grid's outer edges line up with
         the footer content rather than sitting wider than it. */
      .app-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
        padding: 0 0 14rem;
      }

      @media (max-width: 560px) {
        .app-list {
          grid-template-columns: 1fr;
        }
      }

      /* Plain bordered card. The preview is a real (inert) sample of
         rendr's own control chips - a gradient swatch, a scrub
         slider, a size dropdown - scattered and rotated like an
         exploded-view diagram, rather than a generic icon or a
         decorative gradient standing in for the product. */
      .app-card {
        display: block;
        text-decoration: none;
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
        background: var(--bg);
        transition: border-color 0.15s ease, transform 0.15s ease;
      }

      .app-card:hover {
        border-color: var(--label);
        transform: translateY(-2px);
      }

      .app-card-body {
        padding: 1.1rem 1.25rem 1.3rem;
        background: var(--hover-bg);
      }

      .app-card .title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .app-card .title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--title);
      }

      .app-card .icon {
        font-size: 0.85rem;
        color: var(--label);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }

      .app-card:hover .icon {
        opacity: 1;
        transform: translateX(2px);
      }

      .app-card .desc {
        display: block;
        font-size: 0.88rem;
        line-height: 1.5;
        color: var(--label);
        margin-top: 0.4rem;
      }

      /* rendr's own dark app shell tokens (see src/pages/apps/rendr/
         index.astro) - this preview is a sample of that product's
         actual UI, so it borrows that palette rather than this page's
         light/dark theme variables. */
      .app-preview {
        position: relative;
        aspect-ratio: 16 / 11;
        overflow: hidden;
        background: #08090a;
      }

      .app-preview .chip {
        position: absolute;
        display: flex;
        align-items: center;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: 0.68rem;
        color: #f7f8f8;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
      }

      .app-preview .chip-gradient {
        top: 18%;
        left: 10%;
        width: 25%;
        aspect-ratio: 4 / 3;
        transform: rotate(-9deg);
        background: radial-gradient(circle at 12% 15%, #f5b9d6, transparent 60%),
          radial-gradient(circle at 55% 50%, #f2a56a, transparent 60%), radial-gradient(circle at 88% 85%, #8c6fd6, transparent 60%),
          #170f1f;
      }

      .app-preview .chip-scrub {
        top: 42%;
        left: 36%;
        width: 40%;
        padding: 0.5rem 0.75rem;
        justify-content: space-between;
        gap: 0.6rem;
        transform: rotate(3deg);
        z-index: 2;
      }

      .app-preview .chip-scrub .fill {
        position: absolute;
        inset: 0;
        width: 42%;
        background: #e05a1f;
        border-radius: 8px 0 0 8px;
        z-index: -1;
      }

      .app-preview .chip-dropdown {
        top: 62%;
        left: 52%;
        width: 42%;
        padding: 0.5rem 0.75rem;
        justify-content: space-between;
        gap: 0.6rem;
        transform: rotate(-4deg);
      }

      .app-preview .chip-dropdown .dims {
        color: #8a8f98;
      }

      .app-preview .chip-hex {
        top: 66%;
        left: 8%;
        padding: 0.4rem 0.6rem;
        gap: 0.4rem;
        transform: rotate(6deg);
      }

      .app-preview .chip-hex .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #e5e0d5;
        flex: none;
      }

      /* Atrium's own sepia/serif identity (see src/pages/apps/atrium/)
         - same exploded-sample idea as rendr's chips above, just in
         its own palette: a tilted book cover, a star rating, and a
         small-caps kicker label. */
      .app-preview-atrium {
        background: #f3ead9;
      }

      .app-preview-atrium .chip {
        position: absolute;
        box-shadow: 0 8px 20px rgba(43, 36, 32, 0.25);
      }

      .app-preview-atrium .chip-cover {
        top: 16%;
        left: 12%;
        width: 30%;
        aspect-ratio: 2 / 3;
        border-radius: 2px;
        background: #6b5a45;
        transform: rotate(-8deg);
        display: flex;
        align-items: flex-end;
        padding: 0.5rem;
        font-family: Georgia, "Source Serif 4", serif;
        font-weight: 600;
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.92);
      }

      .app-preview-atrium .chip-kicker {
        top: 26%;
        left: 52%;
        padding: 0.4rem 0.65rem;
        border-radius: 8px;
        background: #ece0c8;
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #8a7a63;
        transform: rotate(4deg);
      }

      .app-preview-atrium .chip-rating {
        top: 62%;
        left: 48%;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        background: #ece0c8;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        color: #a9822f;
        transform: rotate(-5deg);
      }
    </style>
  </head>
  <body>
    <Topbar showBack />

    <div class="col">
      <div class="hero">
        <h1>Standalone tools and apps, small software experiments built and shipped one at a time.</h1>
      </div>

      <div class="app-list">
        <a class="app-card" href="/apps/rendr/">
          <div class="app-preview">
            <div class="chip chip-gradient" />
            <div class="chip chip-scrub">
              <div class="fill" />
              <span>Radius</span>
              <span>16px</span>
            </div>
            <div class="chip chip-dropdown">
              <span>Instagram post</span>
              <span class="dims">1080×1080</span>
            </div>
            <div class="chip chip-hex">
              <span class="dot" />
              <span>#E5E0D5</span>
            </div>
          </div>
          <div class="app-card-body">
            <span class="title-row">
              <span class="title">rendr</span>
              <span class="icon" aria-hidden="true">→</span>
            </span>
            <span class="desc">Polished backgrounds for any screenshot.</span>
          </div>
        </a>

        <a class="app-card" href="/apps/atrium/">
          <div class="app-preview app-preview-atrium">
            <div class="chip chip-cover">Meditations</div>
            <div class="chip chip-kicker">Book · Marcus Aurelius</div>
            <div class="chip chip-rating">★★★★★</div>
          </div>
          <div class="app-card-body">
            <span class="title-row">
              <span class="title">Atrium</span>
              <span class="icon" aria-hidden="true">→</span>
            </span>
            <span class="desc">A growing library of books, articles, and sites.</span>
          </div>
        </a>
      </div>
    </div>

    <Footer />
  </body>
</html>
