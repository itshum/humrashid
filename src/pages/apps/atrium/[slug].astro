---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("atrium", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const yearFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", timeZone: "UTC" });
const monthYearFormatter = new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

let kicker = "";
let ctaLabel = "";
let ctaUrl = "";
let facts = "";
let tag: string | null = null;
let bgSize: "cover" | "contain" = "cover";
let aspect = "16 / 10";

if (data.type === "book") {
  kicker = `Book · ${data.author}`;
  ctaLabel = data.purchaseStore ? `Buy at ${data.purchaseStore}` : "Where to buy";
  ctaUrl = data.purchaseUrl ?? "";
  facts = [data.pageCount ? `${data.pageCount} pages` : null, data.publishDate ? yearFormatter.format(data.publishDate) : null]
    .filter(Boolean)
    .join(" · ");
  tag = data.genre ?? null;
  aspect = "2 / 3";
} else if (data.type === "article") {
  kicker = `Article · ${data.sourceName}`;
  ctaLabel = "Read the article";
  ctaUrl = data.articleUrl;
  facts = [data.articleAuthor, data.datePublished ? monthYearFormatter.format(data.datePublished) : null, data.readTime]
    .filter(Boolean)
    .join(" · ");
} else {
  kicker = `Site · ${data.siteName}`;
  ctaLabel = "Visit the site";
  ctaUrl = data.siteUrl;
  tag = data.category;
  bgSize = "contain";
}

const coverStyle = data.coverImage ? `${data.coverColor} url(${data.coverImage}) center/${bgSize} no-repeat` : data.coverColor;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://www.humrashid.com/apps/atrium/${entry.id}/`} />
    <title>{data.title} · Atrium</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
    />
    <style is:global>
      :root {
        --atrium-bg: #f3ead9;
        --atrium-surface: #ece0c8;
        --atrium-ink: #2b2420;
        --atrium-label: #8a7a63;
        --atrium-border: #ddccac;
        --atrium-accent: #a6402d;
        --atrium-gold: #a9822f;
        --atrium-font-display: "Playfair Display", Georgia, serif;
        --atrium-font-body: "Source Serif 4", Georgia, serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--atrium-bg);
        color: var(--atrium-ink);
        font-family: var(--atrium-font-body);
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--atrium-accent);
        color: var(--atrium-bg);
      }

      .atrium-col {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 2rem 8rem;
      }

      .atrium-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 0;
      }

      .atrium-back {
        text-decoration: none;
        font-size: 0.85rem;
        color: var(--atrium-label);
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .atrium-back:hover {
        color: var(--atrium-ink);
      }

      .atrium-wordmark {
        font-family: var(--atrium-font-display);
        font-weight: 700;
        font-size: 1.3rem;
        color: var(--atrium-accent);
      }

      /* --- Flat 2D cover - a real image when available, with a
         subtle drop shadow for depth and a small hover lift for
         vibrancy, same treatment as the grid card. --- */
      .atrium-cover {
        width: 46%;
        margin: 1.5rem auto 2rem;
        border-radius: 2px;
        box-shadow: 0 10px 24px rgba(43, 36, 32, 0.25);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .atrium-cover:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(43, 36, 32, 0.32);
      }

      .atrium-cover.is-wide {
        width: 100%;
      }

      /* --- Meta + body --- */
      .atrium-kicker {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--atrium-label);
        margin: 0 0 0.6rem;
      }

      .atrium-detail-title {
        font-family: var(--atrium-font-display);
        font-weight: 600;
        font-size: 1.8rem;
        line-height: 1.3;
        margin: 0 0 0.75rem;
      }

      .atrium-tag {
        display: inline-block;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        background: var(--atrium-surface);
        color: var(--atrium-label);
        margin: 0 0 1rem;
      }

      .atrium-stars {
        font-size: 0.95rem;
        color: var(--atrium-border);
        letter-spacing: 0.15em;
        margin: 0 0 1.5rem;
      }

      .atrium-stars .filled {
        color: var(--atrium-gold);
      }

      .atrium-facts {
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: var(--atrium-label);
        margin: 0 0 1rem;
      }

      .atrium-url {
        font-size: 0.78rem;
        color: var(--atrium-label);
        margin: 0 0 1rem;
        word-break: break-all;
      }

      .atrium-blurb {
        font-family: var(--atrium-font-display);
        font-style: italic;
        font-size: 1.15rem;
        line-height: 1.5;
        color: var(--atrium-ink);
        margin: 0 0 1.5rem;
      }

      .atrium-body {
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .atrium-body p:first-child {
        margin-top: 0;
      }

      .atrium-cta {
        display: inline-block;
        margin-top: 2rem;
        padding: 0.6rem 1.1rem;
        background: var(--atrium-accent);
        color: var(--atrium-bg);
        text-decoration: none;
        font-size: 0.85rem;
        border-radius: 2px;
      }

      .atrium-cta:hover {
        opacity: 0.9;
      }
    </style>
  </head>
  <body>
    <div class="atrium-col">
      <div class="atrium-header">
        <a class="atrium-back" href="/apps/atrium/">← Atrium</a>
        <span class="atrium-wordmark">Atrium</span>
      </div>

      <div
        class={`atrium-cover${data.type !== "book" ? " is-wide" : ""}`}
        style={{ background: coverStyle, aspectRatio: aspect }}
      />

      <p class="atrium-kicker">{kicker}</p>
      <h1 class="atrium-detail-title">{data.title}</h1>
      {tag && <span class="atrium-tag">{tag}</span>}
      {data.type !== "site" && (
        <p class="atrium-stars" aria-hidden="true">
          {[1, 2, 3, 4, 5].map((n) => <span class={n <= data.rating ? "filled" : ""}>★</span>)}
        </p>
      )}
      {facts && <p class="atrium-facts">{facts}</p>}
      {data.type === "site" && <p class="atrium-url">{data.siteUrl.replace(/^https?:\/\//, "")}</p>}
      <p class="atrium-blurb">{data.blurb}</p>

      <div class="atrium-body">
        <Content />
      </div>

      {ctaUrl && (
        <a class="atrium-cta" href={ctaUrl} target="_blank" rel="noopener">
          {ctaLabel}
        </a>
      )}
    </div>
  </body>
</html>
