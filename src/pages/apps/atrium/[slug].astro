---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("atrium", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const yearFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", timeZone: "UTC" });
const monthYearFormatter = new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

let kicker = "";
let ctaLabel = "";
let ctaUrl = "";
let facts = "";
let tag: string | null = null;
let aspect = "3 / 2";

if (data.type === "book") {
  kicker = `Book · ${data.author}`;
  ctaLabel = data.purchaseStore ? `Buy at ${data.purchaseStore}` : "Where to buy";
  ctaUrl = data.purchaseUrl ?? "";
  facts = [data.pageCount ? `${data.pageCount} pages` : null, data.publishDate ? yearFormatter.format(data.publishDate) : null]
    .filter(Boolean)
    .join(" · ");
  tag = data.genre ?? null;
  aspect = "2 / 3";
} else if (data.type === "article") {
  kicker = `Article · ${data.sourceName}`;
  ctaLabel = "Read the article";
  ctaUrl = data.articleUrl;
  facts = [data.articleAuthor, data.datePublished ? monthYearFormatter.format(data.datePublished) : null, data.readTime]
    .filter(Boolean)
    .join(" · ");
} else {
  kicker = `Site · ${data.siteName}`;
  ctaLabel = "Visit the site";
  ctaUrl = data.siteUrl;
  tag = data.category;
}

const coverStyle = data.coverImage ? `${data.coverColor} url(${data.coverImage}) center/cover no-repeat` : data.coverColor;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://www.humrashid.com/apps/atrium/${entry.id}/`} />
    <title>{data.title} · Atrium</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Sorts+Mill+Goudy:ital@0;1&family=Inter:wght@400;500;600&display=swap"
    />
    <style is:global>
      :root {
        --atrium-bg: #f3ead9;
        --atrium-surface: #ece0c8;
        --atrium-ink: #2b2420;
        --atrium-label: #8a7a63;
        --atrium-border: #ddccac;
        --atrium-accent: #a6402d;
        --atrium-gold: #a9822f;
        --atrium-font-display: "Sorts Mill Goudy", Georgia, serif;
        --atrium-font-body: "Inter", -apple-system, sans-serif;
        --atrium-font-wordmark: "Cormorant Garamond", Georgia, serif;
        --atrium-wordmark-color: #5c3a2e;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--atrium-bg);
        color: var(--atrium-ink);
        font-family: var(--atrium-font-body);
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--atrium-accent);
        color: var(--atrium-bg);
      }

      .atrium-col {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem 8rem;
      }

      /* Two columns so the whole entry fits without scrolling on a
         normal screen - cover fixed-width on the left, everything
         else filling the rest on the right. Collapses to a single
         stacked column (image on top) once there isn't room for
         both side by side. */
      .atrium-layout {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 5.5rem;
        align-items: start;
      }

      @media (max-width: 760px) {
        .atrium-layout {
          grid-template-columns: 1fr;
        }
      }

      .atrium-content {
        max-width: 560px;
      }

      .atrium-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 0 3rem;
      }

      /* Ghost by default (outlined, transparent) - fills solid on
         hover, same treatment as the grid page's back link. */
      .atrium-back {
        text-decoration: none;
        font-size: 0.85rem;
        color: var(--atrium-label);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.85rem;
        border: 1px solid var(--atrium-border);
        border-radius: 999px;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }

      .atrium-back:hover {
        background: var(--atrium-ink);
        color: var(--atrium-bg);
        border-color: var(--atrium-ink);
      }

      .atrium-wordmark {
        font-family: var(--atrium-font-wordmark);
        font-weight: 700;
        font-size: 2rem;
        letter-spacing: -0.01em;
        color: var(--atrium-wordmark-color);
      }

      /* --- Flat 2D cover - a real image when available, with a
         subtle drop shadow for depth and a small hover lift for
         vibrancy, same treatment as the grid card. --- */
      .atrium-cover {
        width: 100%;
        border-radius: 2px;
        box-shadow: 0 10px 24px rgba(43, 36, 32, 0.25);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .atrium-cover:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(43, 36, 32, 0.32);
      }

      @media (max-width: 760px) {
        .atrium-cover {
          max-width: 340px;
          margin: 0 auto;
        }
      }

      /* --- Meta + body --- */
      .atrium-kicker {
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--atrium-label);
        margin: 0 0 0.5rem;
      }

      .atrium-detail-title {
        font-family: var(--atrium-font-display);
        font-weight: 600;
        font-size: 1.5rem;
        line-height: 1.3;
        margin: 0 0 0.6rem;
      }

      .atrium-tag {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
        background: var(--atrium-surface);
        color: var(--atrium-label);
        margin: 0 0 0.85rem;
      }

      .atrium-stars {
        font-size: 0.85rem;
        color: var(--atrium-border);
        letter-spacing: 0.15em;
        margin: 0 0 1.25rem;
      }

      .atrium-stars .filled {
        color: var(--atrium-gold);
      }

      .atrium-facts {
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--atrium-label);
        margin: 0 0 0.85rem;
      }

      .atrium-url {
        font-size: 0.72rem;
        color: var(--atrium-label);
        margin: 0 0 0.85rem;
        word-break: break-all;
      }

      .atrium-blurb {
        font-family: var(--atrium-font-display);
        font-style: italic;
        font-weight: 500;
        font-size: 1.02rem;
        line-height: 1.5;
        color: var(--atrium-ink);
        margin: 0 0 1.25rem;
      }

      .atrium-body {
        font-size: 0.92rem;
        font-weight: 400;
        line-height: 1.7;
      }

      .atrium-body p:first-child {
        margin-top: 0;
      }

      /* Ghost by default (outlined, transparent) - fills solid on
         hover, same treatment as .atrium-back. */
      .atrium-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1.5rem;
        padding: 0.5rem 0.9rem;
        background: transparent;
        color: var(--atrium-accent);
        border: 1px solid var(--atrium-accent);
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 500;
        border-radius: 2px;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .atrium-cta svg {
        width: 13px;
        height: 13px;
      }

      .atrium-cta:hover {
        background: var(--atrium-accent);
        color: var(--atrium-bg);
      }
    </style>
  </head>
  <body>
    <div class="atrium-col">
      <div class="atrium-header">
        <a class="atrium-back" href="/apps/atrium/">← Back to collection</a>
        <span class="atrium-wordmark">Atrium</span>
      </div>

      <div class="atrium-layout">
        <div class="atrium-cover" style={{ background: coverStyle, aspectRatio: aspect }} />

        <div class="atrium-content">
          <p class="atrium-kicker">{kicker}</p>
          <h1 class="atrium-detail-title">{data.title}</h1>
          {tag && <span class="atrium-tag">{tag}</span>}
          {data.type !== "site" && (
            <p class="atrium-stars" aria-hidden="true">
              {[1, 2, 3, 4, 5].map((n) => <span class={n <= data.rating ? "filled" : ""}>★</span>)}
            </p>
          )}
          {facts && <p class="atrium-facts">{facts}</p>}
          {data.type === "site" && <p class="atrium-url">{data.siteUrl.replace(/^https?:\/\//, "")}</p>}
          <p class="atrium-blurb">{data.blurb}</p>

          <div class="atrium-body">
            <Content />
          </div>

          {ctaUrl && (
            <a class="atrium-cta" href={ctaUrl} target="_blank" rel="noopener">
              {ctaLabel}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </body>
</html>
