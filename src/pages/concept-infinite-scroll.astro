---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Concept — Infinite Scroll</title>
    <style is:global>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
        margin: 0;
        background: #fafaf9;
        font-family: ui-sans-serif, system-ui, sans-serif;
        overflow: hidden;
      }

      .frame-label {
        position: fixed;
        top: 16px;
        left: 24px;
        color: #b5b3ae;
        font-size: 0.7rem;
        z-index: 5;
      }

      .stage {
        position: absolute;
        inset: 0;
        background: #fafaf9;
        overflow: hidden;
      }

      .scroller {
        height: 100%;
        overflow-y: hidden;
        will-change: scroll-position;
      }

      .panel-track {
        padding-top: 6rem;
        padding-bottom: 6rem;
        position: relative;
      }

      /* subtle anchor line — a faint tick marking each floating container
         against the grid, not a heavy divider */
      .anchor {
        width: 1px;
        height: 32px;
        background: rgba(26, 26, 26, 0.12);
        margin-bottom: 1.25rem;
      }

      .media {
        flex-shrink: 0;
        background: #e4e2dd;
        border-radius: 3px;
      }

      .media.tall {
        width: 320px;
        height: 400px;
      }

      .media.wide {
        width: 460px;
        height: 300px;
      }

      .media.phone {
        width: 260px;
        height: 420px;
        border-radius: 8px;
      }

      .media.square {
        width: 360px;
        height: 360px;
      }

      .copy {
        max-width: 300px;
      }

      .copy h2 {
        font-size: 2rem;
        font-weight: 500;
        margin: 0 0 1rem;
        color: #1a1a1a;
      }

      .copy p {
        color: #8a8a8a;
        line-height: 1.5;
        margin: 0 0 1.25rem;
        font-size: 0.95rem;
      }

      .pill {
        display: inline-block;
        padding: 0.6rem 1.4rem;
        background: transparent;
        color: #1a1a1a;
        border: 1px solid rgba(26, 26, 26, 0.14);
        border-radius: 2px;
        font-size: 0.85rem;
        text-decoration: none;
        cursor: pointer;
      }

      /* Hero — full viewport on first load, 1/3 text : 2/3 flagship reel */
      .hero-track {
        height: 100vh;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1.5rem;
        align-items: center;
        padding: 0 5rem;
        max-width: 1600px;
        margin: 0 auto;
      }

      .hero-copy {
        grid-column: span 4;
      }

      .hero-eyebrow {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #8a8a8a;
        margin-bottom: 1.5rem;
      }

      .hero-copy h1 {
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.45;
        color: #1a1a1a;
        margin: 0 0 2rem;
      }

      .hero-media {
        grid-column: span 8;
        height: 78vh;
        border-radius: 3px;
        background: #1a1a1a;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .hero-media::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(155deg, #262626, #171717);
      }

      .hero-media .reel-label {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        letter-spacing: 0.02em;
      }

      .hero-media .reel-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.6);
      }

      .scroll-cue {
        position: absolute;
        bottom: 3rem;
        left: 5rem;
        font-size: 0.72rem;
        color: #b5b3ae;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      /* Floating nav — Palantir-style bordered bar, sharp corners, subtle */
      .float-nav {
        position: absolute;
        left: 50%;
        bottom: 32px;
        transform: translate(-50%, 24px);
        display: flex;
        align-items: stretch;
        border: 2px solid rgba(26, 26, 26, 0.85);
        border-radius: 2px;
        background: rgba(250, 250, 249, 0.82);
        backdrop-filter: blur(16px) saturate(160%);
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        box-shadow: 0 12px 32px rgba(26, 26, 26, 0.06);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 10;
        white-space: nowrap;
      }

      .float-nav.visible {
        opacity: 1;
        transform: translate(-50%, 0);
        pointer-events: auto;
      }

      .float-nav .name {
        display: flex;
        align-items: center;
        font-weight: 600;
        font-size: 0.85rem;
        color: #1a1a1a;
        padding: 0.8rem 1.3rem;
      }

      .float-nav .divider {
        width: 1px;
        background: rgba(26, 26, 26, 0.1);
      }

      .float-nav .links {
        display: flex;
        align-items: center;
      }

      .float-nav .links a {
        display: flex;
        align-items: center;
        padding: 0.8rem 1.1rem;
        font-size: 0.82rem;
        color: #6b6b6b;
        text-decoration: none;
      }

      .float-nav .links a:hover {
        color: #1a1a1a;
      }

      .float-nav .icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        border-left: 2px solid rgba(26, 26, 26, 0.85);
        color: #1a1a1a;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .float-nav .icon-btn:hover {
        background: #1a1a1a;
        color: #fafaf9;
      }

      .float-nav .icon-btn svg {
        width: 16px;
        height: 16px;
      }

      .progress-note {
        position: absolute;
        top: 16px;
        right: 24px;
        font-size: 0.7rem;
        color: #b5b3ae;
        z-index: 5;
      }
    </style>
  </head>
  <body>
    <div class="frame-label">Concept — Infinite Scroll</div>
    <div class="progress-note" id="progress-note">scroll to reveal nav…</div>

    <div class="stage">
      <div class="scroller" id="scroller">
        <div class="hero-track">
          <div class="hero-copy">
            <div class="hero-eyebrow">Hum Rashid — Design Director</div>
            <h1>Positioning statement placeholder — locked during content phase.</h1>
            <a class="pill" href="/about">About</a>
          </div>
          <div class="hero-media">
            <div class="reel-label"><span class="reel-dot"></span>Flagship reel — video loop placeholder</div>
          </div>
        </div>
        <div class="scroll-cue">Scroll to explore ↓</div>
        <div id="feed"></div>
      </div>
      <nav class="float-nav" id="float-nav">
        <span class="name">Hum Rashid</span>
        <span class="divider"></span>
        <span class="links">
          <a href="/about">About</a>
          <a href="/process">Process</a>
        </span>
        <a href="#" class="icon-btn" id="nav-icon-btn" aria-label="Menu">
          <svg id="nav-icon-hamburger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg>
          <svg id="nav-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <path d="M19 12H5" />
            <path d="M11 18l-6-6 6-6" />
          </svg>
        </a>
      </nav>
    </div>

    <script>
      // Same responsive grid as Grid.astro (4/8/12 cols), applied per-panel so
      // case studies stay pinned to grid lines at every breakpoint instead of
      // floating at an arbitrary max-width. Media/copy column spans mirror the
      // MediaSplit pattern used in the case study template (~1.1fr:1fr split,
      // explicit col-start on both sides so reversal never relies on flex
      // basis, which is what caused the earlier MediaSplit collapse bug).
      const GRID = "mx-auto grid w-full max-w-[1440px] items-center grid-cols-4 gap-4 px-5 md:grid-cols-8 md:gap-6 md:px-10 lg:grid-cols-12 lg:px-16 xl:gap-8 xl:px-20";

      // Nav icon: hamburger on the homepage, back-arrow everywhere else.
      // This prototype route stands in for "/" - once wired into the real
      // Nav.astro, swap that check for the real homepage path.
      const isHome = window.location.pathname === "/" || window.location.pathname === "/concept-infinite-scroll";
      const hamburgerIcon = document.getElementById("nav-icon-hamburger");
      const backIcon = document.getElementById("nav-icon-back");
      const navIconBtn = document.getElementById("nav-icon-btn");
      if (!isHome) {
        hamburgerIcon.style.display = "none";
        backIcon.style.display = "block";
        navIconBtn.setAttribute("aria-label", "Back");
      }

      function panelHTML({ align, mediaClass, title, desc, href }) {
        const reverse = align === "right";
        // Media (6 cols) and copy (6 cols) are always contiguous at the lg
        // tier - copy previously started at col-start-8 while media only
        // filled cols 1-6, leaving column 7 empty as an unintended gap.
        const mediaCols = reverse
          ? "col-span-4 md:col-span-4 md:col-start-5 lg:col-span-6 lg:col-start-7"
          : "col-span-4 md:col-span-4 lg:col-span-6";
        const copyCols = reverse
          ? "col-span-4 md:col-span-4 md:col-start-1 lg:col-span-6 lg:col-start-1"
          : "col-span-4 md:col-span-4 lg:col-span-6 lg:col-start-7";
        // Copy renders first in source order when reversed so mobile stacking
        // still reads image-then-text on top; grid placement handles md/lg.
        const mediaBlock = `<div class="${mediaCols}"><div class="anchor"></div><div class="media ${mediaClass}"></div></div>`;
        const copyBlock = `
          <div class="${copyCols}">
            <div class="copy">
              <h2>${title}</h2>
              <p>${desc}</p>
              <a class="pill" href="${href}">Read Case Study</a>
            </div>
          </div>`;
        return `<div class="panel-track ${GRID}">${mediaBlock}${copyBlock}</div>`;
      }

      const caseStudiesMarkup = [
        panelHTML({
          align: "left",
          mediaClass: "wide",
          title: "Pack Digital",
          desc: "Product strategy and UI design for headless infrastructure startup.",
          href: "/work/pack",
        }),
        panelHTML({
          align: "right",
          mediaClass: "square",
          title: "Inveterate",
          desc: "Product strategy and UI design for membership &amp; loyalty startup.",
          href: "/work/inveterate",
        }),
        panelHTML({
          align: "left",
          mediaClass: "phone",
          title: "PPVP",
          desc: "Product strategy and mobile app design for SaaS investment fund.",
          href: "/work/ppvp",
        }),
        panelHTML({
          align: "right",
          mediaClass: "tall",
          title: "Stocked",
          desc: "eCommerce design &amp; product strategy for consumer food startup.",
          href: "/work/stocked",
        }),
      ].join("\n");

      const scroller = document.getElementById("scroller");
      const feed = document.getElementById("feed");
      const nav = document.getElementById("float-nav");
      const progressNote = document.getElementById("progress-note");

      // Hero is static HTML above #feed — it never repeats, so scrollTop 0
      // is a hard ceiling. #feed grows downward as the user approaches the end,
      // so scrolling down never runs out (real infinite scroll, no jump-reset).
      function appendBatch() {
        feed.insertAdjacentHTML("beforeend", caseStudiesMarkup);
      }
      appendBatch();
      appendBatch();
      appendBatch();

      // --- Damped, eased scroll ---------------------------------------------
      // Native wheel scrolling is fully intercepted. Each wheel tick moves the
      // *target* by only a fraction of the raw delta (WHEEL_DAMPING), and the
      // *current* position eases toward that target every frame (EASE). The
      // combination is what makes it feel "heavier" / harder to fling than a
      // normal page — closer to a weighted dial than a native scrollbar.
      const WHEEL_DAMPING = 0.45;
      const EASE = 0.09;
      const APPEND_THRESHOLD = 1500;
      // Reveal the nav once the user has scrolled roughly past the full-height
      // hero, not a fixed pixel guess — the hero itself is 100vh.
      const REVEAL_THRESHOLD = () => window.innerHeight * 0.9;

      let targetY = 0;
      let currentY = 0;
      let navRevealed = false;

      function maxScroll() {
        return Math.max(0, scroller.scrollHeight - scroller.clientHeight);
      }

      function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
      }

      scroller.addEventListener(
        "wheel",
        (e) => {
          e.preventDefault();
          targetY = clamp(targetY + e.deltaY * WHEEL_DAMPING, 0, maxScroll());
        },
        { passive: false }
      );

      let touchStartY = null;
      scroller.addEventListener(
        "touchstart",
        (e) => {
          touchStartY = e.touches[0].clientY;
        },
        { passive: true }
      );
      scroller.addEventListener(
        "touchmove",
        (e) => {
          if (touchStartY === null) return;
          const y = e.touches[0].clientY;
          const delta = touchStartY - y;
          touchStartY = y;
          targetY = clamp(targetY + delta, 0, maxScroll());
          e.preventDefault();
        },
        { passive: false }
      );

      function tick() {
        currentY += (targetY - currentY) * EASE;
        if (Math.abs(targetY - currentY) < 0.05) currentY = targetY;
        scroller.scrollTop = currentY;

        if (targetY > maxScroll() - APPEND_THRESHOLD) {
          appendBatch();
        }

        const threshold = REVEAL_THRESHOLD();
        if (!navRevealed && currentY > threshold) {
          navRevealed = true;
          nav.classList.add("visible");
          progressNote.style.opacity = "0";
        }
        if (progressNote && !navRevealed) {
          const pct = Math.min(100, Math.round((currentY / threshold) * 100));
          progressNote.textContent = `scroll to reveal nav… ${pct}%`;
        }

        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    </script>
  </body>
</html>
