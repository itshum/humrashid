      <section>
        <p class="section-heading" data-load-reveal>Select Work</p>

        <div class="work-list">
          <div class="work-row work-row--gated" data-load-reveal>
            <button type="button" class="gate-trigger" id="sublimeGateTrigger" aria-haspopup="dialog">
              <span class="row-top">
                <span class="title">Sublime Security</span>
                <span class="meta">
                  <span class="year">2026</span>
