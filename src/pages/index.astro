              <path class="amp-glyph" mask="url(#amp-reveal-mask)" d="M223 9 Q162 9 116.0 -17 Q70 -43 44.5 -89 Q19 -135 19 -196 Q19 -255 42.5 -306 Q66 -357 106.5 -394 Q147 -431 198 -447 Q168 -486 168 -545 Q168 -597 191.5 -639 Q215 -681 255.5 -705.5 Q296 -730 346 -730 Q378 -730 407.5 -719.5 Q437 -709 456 -691 Q470 -678 466 -658 L438 -512 Q435 -497 424 -497 Q412 -497 411 -514 L410 -535 Q406 -618 387.0 -652.5 Q368 -687 325 -687 Q289 -687 260.5 -668 Q232 -649 215.0 -616 Q198 -583 198 -541 Q198 -482 230 -454 Q245 -456 260 -456 Q313 -456 313 -430 Q313 -406 275 -406 Q244 -406 218 -426 Q91 -387 91 -218 Q91 -126 131.0 -74.5 Q171 -23 241 -23 Q291 -23 331.5 -48 Q372 -73 396.0 -114.5 Q420 -156 420 -207 Q420 -285 346 -285 Q317 -285 300.5 -273.5 Q284 -262 284 -245 Q284 -230 294.0 -225 Q304 -220 317.0 -217 Q330 -214 340.0 -206.5 Q350 -199 350 -179 Q350 -161 337.0 -150.5 Q324 -140 303 -140 Q276 -140 260.0 -160 Q244 -180 244 -213 Q244 -250 266.0 -277 Q288 -304 325.5 -316 Q363 -328 408 -320 L439 -315 Q504 -305 504 -331 Q504 -343 493.0 -348 Q482 -353 468.0 -357.5 Q454 -362 443.0 -370.5 Q432 -379 432 -397 Q432 -414 444.0 -425 Q456 -436 478 -436 Q507 -436 523.0 -415.5 Q539 -395 539 -361 Q539 -318 512.0 -292 Q485 -266 443 -269 Q450 -246 450 -214 Q450 -150 420.5 -99.5 Q391 -49 340.0 -20 Q289 9 223 9 Z" />
            </svg></span><span class="sr-only">&amp;</span> founder in New York City</h1>
        <p data-load-reveal>
