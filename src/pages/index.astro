---
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
---

<!doctype html>
<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/" />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <style is:inline>
      /* Critical, inline copy of the two colors the theme rule above
         needs to paint correctly on the very first frame - the full
         palette lives in an externally-linked stylesheet below, which
         needs a network round trip before the browser can apply it.
         Without this, the page paints with the browser's own default
         (white) background for however long that fetch takes, then
         snaps to the real color once it arrives - a flash that was
         apparently small enough to miss on the old host, but is
         plainly visible on this one. Same specificity/selector as the
         real rule in the linked stylesheet, so that one silently
         takes over once it's ready - no visible handoff. */
      html[data-theme="dark"] {
        background: #16171c;
        color: #eeede8;
      }
      html:not([data-theme="dark"]) {
        background: #fafaf9;
        color: #262626;
      }
    </style>
    <title>Humayun Rashid · Product Designer</title>
    <meta
      name="description"
      content="Humayun Rashid is a product designer and founder based in New York City with a decade of experience building products that solve real problems."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Humayun Rashid" />
    <meta property="og:title" content="Humayun Rashid · Product Designer" />
    <meta
      property="og:description"
      content="Humayun Rashid is a product designer and founder based in New York City with a decade of experience building products that solve real problems."
    />
    <meta property="og:url" content="https://www.humrashid.com/" />
    <meta property="og:image" content="https://www.humrashid.com/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Humayun Rashid · Product Designer" />
    <meta
      name="twitter:description"
      content="Humayun Rashid is a product designer and founder based in New York City with a decade of experience building products that solve real problems."
    />
    <meta name="twitter:image" content="https://www.humrashid.com/og-image.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Humayun Rashid",
      jobTitle: "Product Designer",
      url: "https://www.humrashid.com/",
      image: "https://www.humrashid.com/og-image.jpg",
      address: {
        "@type": "PostalAddress",
        addressLocality: "New York",
        addressRegion: "NY",
        addressCountry: "US",
      },
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <style is:global>
      /* Time-based dark mode (see the inline head script + Topbar's
         script, both keyed off NYC local time) - an off dark grey,
         never pure black, mirroring the light palette's warmth. */
      :root {
        --bg: #fafaf9;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --label-cool: #76787d;
        --hover-bg: #efefed;
        --title: #262626;
        --year: #8a8a86;
        --icon: #cacac6;
        --icon-hover: #6b6b6b;
        --border: #e6e6e3;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
        --photo-shadow: 0 16px 40px rgba(0, 0, 0, 0.16), 0 2px 8px rgba(0, 0, 0, 0.08);
        /* Drives the footer's sun/moon icon crossfade (see
           Footer.astro) - 1 in light mode, 0 in dark. */
        --theme-progress: 1;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #a1a09a;
        --label-cool: #8f9093;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --icon: #474641;
        --icon-hover: #b5b4ad;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
        /* A black shadow reads as almost nothing against this near-black
           background, so dark mode leans on a soft light-edge glow
           instead of a darker shadow to give the card the same sense
           of lift. */
        --photo-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.06);
        --theme-progress: 0;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      /* On-brand scrollbar in place of the stock OS one - color only,
         no custom width, so it never forces the browser out of
         overlay mode into a reserved-gutter one (that switch shifts
         page content and was a real regression the last time this was
         tried elsewhere on the site). */
      html {
        scrollbar-color: var(--border) var(--bg);
      }

      html::-webkit-scrollbar-track {
        background: var(--bg);
      }

      html::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 8px;
      }

      html::-webkit-scrollbar-thumb:hover {
        background: var(--label);
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* On mobile .col's padding IS the distance from the viewport
         edge (no centering slack the way there is on wider screens),
         so it has to match the topbar's 2rem horizontal padding
         exactly or text runs wider than the logo above it. */
      @media (max-width: 600px) {
        .col {
          padding: 0 2rem;
        }
      }

      /* 25% less top space than the original calc(4.55rem + 100px) -
         applies at every breakpoint since there's no mobile/tablet
         override of this rule. */
      .intro {
        position: relative;
        margin-top: calc(5rem + 90px);
      }

      /* Experimental H1 opener - testing a bolder, explicit name/role
         statement above the existing intro paragraph. Reuses the
         case-study template's h1 treatment (2.5rem/500,
         letter-spacing -0.015em, text-wrap: balance) for a consistent
         "this is a heading" feel across the site. */
      .intro-h1 {
        font-size: 2.625rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        line-height: 1.3;
        color: var(--title);
        margin: 0 0 2.25rem;
        text-wrap: balance;
      }

      .nyc-word {
        display: inline-block;
        min-width: 2.35em;
        cursor: default;
      }

      .nyc-word img {
        display: inline-block;
        width: 1.05em;
        height: 1.05em;
        object-fit: contain;
        vertical-align: -0.13em;
      }

      /* Instrument Serif's italic ampersand specifically - a small,
         deliberate flourish against the otherwise all-Sans page. Sized
         as an inline SVG (the glyph's own outline, extracted from the
         webfont) rather than live text, so it can draw itself in on
         load. Dimensions are the glyph's font-unit bounding box
         (525 x 739 of 1000 units/em) scaled by the old 1.15em flourish
         factor: 0.525*1.15 / 0.739*1.15. */
      .intro-h1 .amp {
        display: inline-block;
        width: 0.604em;
        height: 0.85em;
        margin: 0 0.161em 0 0.023em;
        vertical-align: baseline;
      }

      .amp-glyph {
        fill: var(--title);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* The mask stroke is one continuous walk of the glyph's own
         medial-axis skeleton (computed from the extracted outline via
         skimage, then reduced to a route that's guaranteed - verified
         by rasterizing and diffing against the true glyph fill - to
         fully cover its ink; a hand-eyeballed brush path kept missing
         corners no matter how generous the width). stroke-width 100
         matches the glyph's own measured stroke thickness (max local
         diameter ~82 units) rather than an oversized guess. Revealed
         via stroke-dashoffset on a normalized (pathLength=1) path so
         timing doesn't depend on the route's actual geometric length -
         only the masked glyph fill is ever visible, not the brush. */
      .amp-mask-stroke {
        fill: none;
        stroke: #fff;
        stroke-width: 100;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        transition: stroke-dashoffset 2.2s cubic-bezier(0.45, 0, 0.2, 1);
      }

      .intro-h1.is-in .amp-mask-stroke {
        stroke-dashoffset: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        .amp-mask-stroke {
          transition: none;
          stroke-dashoffset: 0;
        }
      }

      @media (max-width: 600px) {
        .intro-h1 {
          font-size: 2.05rem;
        }
      }

      .intro p {
        font-size: 1.15rem;
        line-height: 1.5;
        color: var(--text-secondary);
        margin: 0 0 1.25rem;
      }

      @media (max-width: 600px) {
        .intro p {
          font-size: 1.05rem;
          line-height: 1.5;
        }
      }

      /* Tablet was inheriting the desktop size unchanged - technically
         the same absolute value that reads fine on desktop, but next
         to the (much larger, unscaled-for-tablet) H1 above it, the
         contrast reads more exaggerated at tablet viewing distance.
         Bumped one step up from the 1.15rem desktop/mobile-fallback
         size rather than left matching desktop. */
      @media (min-width: 601px) and (max-width: 1000px) {
        .intro p {
          font-size: 1.25rem;
          line-height: 1.5;
        }
      }

      .intro p:last-child {
        margin-bottom: 0;
      }

      .intro a {
        text-decoration: none;
      }

      /* Headshot reveal on hovering the name - a small photo card that
         fades/lifts into view. The pixelation is the blur itself: the
         photo is sliced into a 10x10 grid of tiles, each showing its
         own piece of the image (via background-position), each
         individually blurred and staggered so they sharpen into focus
         out of order rather than as one flat crossfade. No color
         overlay - the blur alone reads as "pixelated". */
      .name-trigger {
        position: relative;
        display: inline-block;
        cursor: pointer;
      }

      /* Touch devices have no real :hover, so tapping the name relies
         on iOS's flaky "sticky hover" simulation instead - unreliable
         to trigger and skips the transition entirely. On these
         devices the reveal is driven by a tap-toggled .is-active
         class from the script below instead (see the click handler).
         The tap target is enlarged via an invisible ::before rather
         than real padding, so the hit area grows without changing
         .name-trigger's own box (padding would push the ::after
         underline, positioned bottom: -2px off that same box, down
         with it). */
      @media (hover: none) {
        .name-trigger {
          -webkit-tap-highlight-color: transparent;
        }

        .name-trigger::before {
          content: "";
          position: absolute;
          inset: -0.5rem;
        }
      }

      .name-trigger::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.45s ease;
      }

      .name-trigger:hover::after,
      .name-trigger.is-active::after {
        transform: scaleX(1);
      }

      /* Positioned via JS (top/left set inline, computed from
         .name-trigger's own bounding rect - see the script below),
         not CSS anchored to .name-trigger directly. It used to be a
         DOM descendant of .name-trigger (an inline-block on line 1
         of the paragraph), overflowing 306px down across several of
         the paragraph's own wrapped lines below it. Chromium would
         intermittently paint some of those wrapped sibling lines
         above this card instead of beneath it - reproducible even at
         z-index: 9999, so not a stacking-context/z-index problem at
         all, but something specific to an absolutely positioned
         element overflowing out of an inline-block into its own
         paragraph's wrapped lines. Moving it out to be a plain
         sibling of the paragraphs (still inside position: relative
         .intro) sidesteps that pattern entirely. */
      .name-photo {
        position: absolute;
        /* Fallback only - positionPhoto() in the script below always
           sets explicit width/height matching the underline's width
           (preserving this 263:306 aspect ratio) before the photo can
           ever become visible. */
        width: 263px;
        height: 306px;
        border-radius: 2px;
        overflow: hidden;
        opacity: 0;
        transform: translateY(-6px) scale(0.97);
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 30;
        box-shadow: var(--photo-shadow);
        background: var(--hover-bg);
      }

      .name-photo.is-visible {
        opacity: 1;
      }

      .name-photo-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      section {
        padding: 5.75rem 0 4.55rem;
      }

      .section-heading {
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--label-cool);
        margin: 0 0 0.875rem;
      }

      .work-list {
        margin: 0 -0.9rem;
        position: relative;
      }

      /* Upstatement-style hover preview (same cursor-follow technique
         as .name-photo above, reused for the work list) - one shared
         image, repositioned/re-sourced per row instead of one image
         per row, positioned in the negative space after each row's
         own (short) description text rather than parked far in the
         margin or overlapping the copy; only its y position drifts
         with the cursor. Landscape, never taller than wide (500x350),
         with object-fit: cover to crop in on the actual product
         screen each cover photo shows, instead of the whole lifestyle
         shot (hand, background) at its native proportions. */
      .work-preview {
        position: absolute;
        top: 0;
        left: 0;
        width: 387px;
        aspect-ratio: 43 / 26;
        border-radius: 4px;
        overflow: hidden;
        display: block;
        opacity: 0;
        pointer-events: none;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
        z-index: 5;
        transition: opacity 0.2s ease;
      }

      .work-preview.is-visible {
        opacity: 1;
        pointer-events: auto;
      }

      .work-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* The preview sits in the margin outside .col, so it only fits
         at wider viewports - narrower than that there isn't room for
         it beside the row without overlapping the text, and touch
         devices have no cursor to drive the follow effect anyway. */
      @media (max-width: 1100px), (hover: none) {
        .work-preview {
          display: none;
        }
      }

      /* Hover highlight bleeds past the text measure on both sides, which is
         why each row gets its own horizontal padding instead of inheriting
         .col's - the highlight needs to extend beyond where the text sits. */
      .work-row {
        display: block;
        padding: 1.1rem 0.9rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      /* :active alongside :hover - touch devices have no real hover,
         so without this the highlight/arrow only show up through
         iOS's flaky sticky-hover simulation. :active fires the
         instant a finger touches down, giving immediate native-app-
         style press feedback rather than requiring a lucky hover. */
      .work-row:hover,
      .work-row:active {
        background: var(--hover-bg);
      }

      /* Title and year/icon share one line, full width - the
         description sits on its own line below instead of squeezed
         into the same row, which is what let it wrap awkwardly next
         to a stranded year on narrow screens. */
      .work-row .row-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
      }

      .work-row .title {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--title);
      }

      .work-row .desc {
        display: block;
        font-size: 0.92rem;
        line-height: 1.5;
        letter-spacing: 0.15px;
        color: var(--label);
        margin-top: 0.5rem;
      }

      .work-row .meta {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        flex-shrink: 0;
      }

      .work-row .year {
        font-size: 0.85rem;
        color: var(--year);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .work-row .icon {
        font-size: 0.85rem;
        color: var(--icon);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
        display: inline-block;
      }

      /* Same as .intro p above - tablet was inheriting the desktop
         size unchanged, which reads a little small at tablet viewing
         distance next to the titles/headline around it. */
      @media (min-width: 601px) and (max-width: 1000px) {
        .work-row .title {
          font-size: 1.15rem;
        }

        .work-row .desc {
          font-size: 1.02rem;
        }

        .work-row .year,
        .work-row .icon {
          font-size: 0.95rem;
        }
      }

      /* Touch devices have no real hover to linger in, just a brief
         :active flash on tap, and no room left for the icon either
         way: the year sits flush with the row's true right edge here
         (matching the topbar/logo - see .work-row .year below), which
         leaves no space for the icon to render without overlapping
         the year or spilling outside the row's own highlighted
         background. The :active highlight alone is enough tap
         feedback on touch, so the icon just doesn't render here. */
      @media (hover: none) {
        .work-row .icon {
          display: none;
        }
      }

      a.work-row:hover .icon,
      a.work-row:active .icon {
        opacity: 1;
        color: var(--icon-hover);
      }

      a.work-row:hover .icon.external,
      a.work-row:active .icon.external {
        transform: translate(2px, -2px);
      }

      a.work-row:hover .icon.internal,
      a.work-row:active .icon.internal {
        transform: translateX(2px);
      }

      /* --- Sublime row: password-gated case study --- */
      /* Same .work-row treatment as the other rows, just a <button>
         instead of an <a> since it opens the gate modal rather than
         navigating directly. */
      button.work-row {
        display: block;
        width: 100%;
        background: none;
        border: none;
        font-family: inherit;
        text-align: left;
        color: inherit;
        cursor: pointer;
      }

      button.work-row:focus-visible {
        outline: 2px solid var(--label);
        outline-offset: -2px;
      }

      button.work-row:hover .icon.internal,
      button.work-row:focus-visible .icon.internal {
        opacity: 1;
        color: var(--icon-hover);
        transform: translateX(2px);
      }

      /* --- Password gate modal --- */
      .gate-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(10, 10, 10, 0.6);
        backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
        z-index: 100;
        padding: 1.5rem;
      }

      .gate-backdrop.is-open {
        opacity: 1;
        pointer-events: auto;
      }

      .gate-modal {
        width: 100%;
        max-width: 380px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1.5rem;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
        transform: translateY(8px) scale(0.98);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      :root[data-theme="dark"] .gate-modal {
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
      }

      .gate-backdrop.is-open .gate-modal {
        transform: translateY(0) scale(1);
      }

      .gate-modal.is-shaking {
        animation: gate-shake 0.4s ease;
      }

      @keyframes gate-shake {
        10%, 90% { transform: translateX(-1px); }
        20%, 80% { transform: translateX(2px); }
        30%, 50%, 70% { transform: translateX(-4px); }
        40%, 60% { transform: translateX(4px); }
      }

      .gate-modal .modal-title {
        font-size: 1.15rem;
        font-weight: 500;
        color: var(--title);
        margin: 0 0 0.4rem;
      }

      .gate-modal .modal-sub {
        font-size: 0.9rem;
        color: var(--label);
        margin: 0 0 1.4rem;
        line-height: 1.5;
      }

      .gate-field-wrap {
        position: relative;
      }

      /* Covers both type="password" and the type="text" the eye
         toggle switches to - unscoped by type so showing/hiding the
         password never changes the field's own appearance, only the
         masking. */
      .gate-field-wrap input {
        width: 100%;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.7rem 2.6rem 0.7rem 0.85rem;
        color: var(--text);
        font-size: 1.05rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s ease;
      }

      /* Masked-dot spacing only - letter-spacing alone (no font-size
         change) so the box never resizes when the eye toggle
         switches type. The placeholder is real text, not dots, so it
         gets its own rule below resetting spacing back to normal -
         otherwise the placeholder itself visibly stretched out in
         the masked state. */
      .gate-field-wrap input[type="password"] {
        letter-spacing: 0.14em;
      }

      .gate-field-wrap input[type="password"]::placeholder {
        letter-spacing: normal;
      }

      .gate-field-wrap input:focus {
        border-color: var(--label);
      }

      .gate-field-wrap input.is-error {
        border-color: var(--danger);
      }

      .gate-eye-toggle {
        position: absolute;
        top: 50%;
        right: 0.5rem;
        transform: translateY(-50%);
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        outline: none;
        border-radius: 5px;
        color: var(--label);
        cursor: pointer;
        padding: 0;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .gate-eye-toggle:hover {
        background: var(--border);
        color: var(--text);
      }

      /* Quiet, in-palette focus indicator for keyboard users tabbing
         to the button - a plain browser outline (often a bright
         system color) doesn't match anything else here. Mouse clicks
         never see this: the click handler returns focus to the input
         right after toggling. */
      .gate-eye-toggle:focus-visible {
        background: var(--border);
        color: var(--text);
        box-shadow: 0 0 0 2px var(--label);
      }

      .gate-eye-toggle svg {
        width: 17px;
        height: 17px;
        display: block;
      }

      .gate-eye-toggle .eye-off {
        display: none;
      }

      .gate-eye-toggle.is-visible .eye-on {
        display: none;
      }

      .gate-eye-toggle.is-visible .eye-off {
        display: block;
      }

      /* Collapsed to zero height by default - not just invisible -
         so the gap it would otherwise reserve between the field and
         the buttons doesn't show up until there's actually an error. */
      .gate-error-msg {
        font-size: 0.8rem;
        color: var(--danger);
        margin: 0;
        height: 0;
        overflow: hidden;
        opacity: 0;
        transition: opacity 0.15s ease;
      }

      .gate-error-msg.is-shown {
        margin: 0.5rem 0 0;
        height: auto;
        opacity: 1;
      }

      .gate-btn {
        appearance: none;
        border: none;
        border-radius: 6px;
        padding: 0.7rem 1.1rem;
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s ease, background 0.15s ease, color 0.15s ease;
      }

      /* Monochrome "primary" - high-contrast fill/text swap rather
         than a hue, matching the site's all-neutral palette. */
      .gate-btn-primary {
        background: var(--text);
        color: var(--bg);
        display: inline-flex;
        align-items: center;
      }

      .gate-btn-primary:hover {
        opacity: 0.85;
      }

      .gate-btn-primary:disabled {
        opacity: 0.6;
        cursor: default;
      }

      .gate-btn-primary .spinner {
        display: none;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.35);
        border-top-color: var(--bg);
        animation: gate-spin 0.6s linear infinite;
        margin-right: 0.5rem;
      }

      :root:not([data-theme="dark"]) .gate-btn-primary .spinner {
        border: 2px solid rgba(0, 0, 0, 0.2);
        border-top-color: var(--bg);
      }

      .gate-btn-primary.is-loading .spinner {
        display: inline-block;
      }

      .gate-btn-primary.is-loading .btn-label {
        opacity: 0.85;
      }

      @keyframes gate-spin {
        to { transform: rotate(360deg); }
      }

      /* Ghost button - same treatment as the site's back-link/nav
         links: transparent by default, fills with --hover-bg on
         hover, text brightens to --title. No border/box at rest. */
      .gate-btn-ghost {
        background: transparent;
        color: var(--label);
        padding: 0.7rem 0.9rem;
      }

      .gate-btn-ghost:hover {
        background: var(--hover-bg);
        color: var(--title);
      }

      .gate-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.9rem;
      }

      /* On-load entrance, not scroll-triggered like the case study
         template's [data-reveal] (that one uses an IntersectionObserver
         since its content is far down a long page). This content sits
         at/near the fold, so it should always animate in immediately
         on every load/refresh instead of waiting on scroll. Kept
         short and subtle - a small lift, not the case study's bigger
         28px/0.8s version - since this fires unprompted on every
         visit rather than once as the user scrolls to it. */
      [data-load-reveal] {
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.55s ease, transform 0.55s ease;
      }

      /* transform: none (not translateY(0)) at rest - translateY(0)
         is still a non-"none" transform value, which establishes a
         new stacking context on the element for as long as it's set.
         The first intro paragraph contains .name-trigger's absolutely
         positioned, z-indexed photo card - trapped inside that
         stacking context, its z-index only wins against siblings
         inside this paragraph, not the page content around it, so it
         was rendering the surrounding text on top of the photo
         instead of under it once the reveal settled. */
      [data-load-reveal].is-in {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        [data-load-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <Topbar showNav />

    <div class="col">
      <div class="intro">
        <h1 class="intro-h1" data-load-reveal><span class="name-trigger">Humayun Rashid</span> is a designer and founder in <span class="nyc-word" aria-label="NYC">NYC</span></h1>
        <span class="name-photo" role="img" aria-label="Headshot of Humayun Rashid">
          <img class="name-photo-img" src="/headshot.jpg" alt="" />
        </span>
      </div>

      <section>
        <p class="section-heading" data-load-reveal>Select Work</p>

        <div class="work-list">
          <button
            type="button"
            class="work-row"
            data-load-reveal
            data-preview-img="/case-studies/sublime-security/home-preview.webp"
            data-preview-alt="Phishing simulation overview with repeat clickers and a group leaderboard"
            id="sublimeGateTrigger"
            aria-haspopup="dialog"
          >
            <span class="row-top">
              <span class="title">Sublime Security</span>
              <span class="meta">
                <span class="year">2026</span>
                <span class="icon internal">→</span>
              </span>
            </span>
            <span class="desc">Led product design for email security teams to stop malicious threats.</span>
          </button>

          <div class="work-row" data-load-reveal>
            <span class="row-top">
              <span class="title">Nessa Labs</span>
              <span class="meta">
                <span class="year">2020 – 2025</span>
                <span class="icon" aria-hidden="true">→</span>
              </span>
            </span>
            <span class="desc">Founder &amp; Design Director of product design studio for early-stage startups.</span>
          </div>

          <a
            class="work-row"
            data-load-reveal
            data-preview-img="/case-studies/pack/01-hero-a.webp"
            data-preview-alt="Pack platform interface"
            href="/work/pack"
          >
            <span class="row-top">
              <span class="title">Pack Platform</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
            <span class="desc">Platform redesign for headless commerce software.</span>
          </a>

          <a
            class="work-row"
            data-load-reveal
            data-preview-img="/case-studies/ppvp/01-hero-desktop.webp"
            data-preview-alt="PPVP investment app home screen shown on a phone, held in hand"
            href="/work/ppvp"
          >
            <span class="row-top">
              <span class="title">PPVP</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
            <span class="desc">Mobile app design for investment platform for early-stage funding.</span>
          </a>

          <a
            class="work-row"
            data-load-reveal
            data-preview-img="/case-studies/inveterate/01-hero-desktop.webp"
            data-preview-alt="Inveterate membership dashboard on a laptop"
            href="/work/inveterate"
          >
            <span class="row-top">
              <span class="title">Inveterate</span>
              <span class="meta">
                <span class="year">2022</span>
                <span class="icon internal">→</span>
              </span>
            </span>
            <span class="desc">Zero to one design and launch for loyalty and membership platform.</span>
          </a>

          <a class="work-row" data-load-reveal href="https://www.shoppinggives.com/" target="_blank" rel="noopener">
            <span class="row-top">
              <span class="title">Shopping Gives</span>
              <span class="meta">
                <span class="year">2021</span>
                <span class="icon external">↗</span>
              </span>
            </span>
            <span class="desc">Product strategy and design for donation enablement platform.</span>
          </a>

          <a class="work-preview" id="workPreview" href="/work/pack" tabindex="-1" aria-hidden="true">
            <img class="work-preview-img" id="workPreviewImg" src="" alt="" />
          </a>
        </div>
      </section>

    </div>

    <div class="gate-backdrop" id="gateBackdrop">
      <div class="gate-modal">
        <p class="modal-title">Password required</p>
        <p class="modal-sub">This project is confidential.</p>
        <label class="sr-only" for="gatePw">Password</label>
        <div class="gate-field-wrap">
          <input type="password" id="gatePw" placeholder="Enter password" autocomplete="off" />
          <button class="gate-eye-toggle" id="gateEyeToggle" type="button" aria-label="Show password">
            <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1.5 12s3.5-7 10.5-7 10.5 7 10.5 7-3.5 7-10.5 7-10.5-7-10.5-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3l18 18" />
              <path d="M10.6 5.2A10.6 10.6 0 0 1 12 5c7 0 10.5 7 10.5 7a13.6 13.6 0 0 1-3.1 4.1M6.6 6.6C3.7 8.4 1.5 12 1.5 12s3.5 7 10.5 7a10.4 10.4 0 0 0 4.8-1.1" />
              <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
            </svg>
          </button>
        </div>
        <p class="gate-error-msg" id="gateError">Incorrect password. Try again.</p>
        <div class="gate-actions">
          <button class="gate-btn gate-btn-ghost" id="gateCancelBtn" type="button">Cancel</button>
          <button class="gate-btn gate-btn-primary" id="gateUnlockBtn" type="button">
            <span class="spinner" aria-hidden="true"></span><span class="btn-label">Unlock</span>
          </button>
        </div>
      </div>
    </div>

    <Footer />

    <script>
      // On-load entrance for the intro paragraphs and work list -
      // always fires on every load/refresh (not gated behind scroll
      // the way the case study template's reveal is), staggered in
      // DOM order: headline first, then a deliberately longer pause
      // (HEADLINE_GAP_MS, bigger than the normal per-item step) so it
      // has room to breathe before the paragraphs start, then the
      // paragraphs and work rows step in one by one after that. Two
      // rAFs so the initial opacity:0 state actually paints before
      // the transition starts, or the first item would just snap
      // straight to visible.
      const loadRevealEls = document.querySelectorAll<HTMLElement>("[data-load-reveal]");
      const LOAD_REVEAL_STEP_MS = 110;
      const LOAD_REVEAL_HEADLINE_GAP_MS = 340;

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const nycWord = document.querySelector<HTMLElement>(".nyc-word");
      const COFFEE_ICON = "/images/nyc-greek-coffee-emoji.png";
      const PIGEON_ICON = "/images/nyc-pigeon-emoji.png";
      const KNICKS_ICON = "/images/nyc-knicks-emoji.png";
      const NYC_EMOJIS = ["🚕", "🍎", "🗽", "🌭", PIGEON_ICON, COFFEE_ICON, "🥯", KNICKS_ICON];
      const setNycSymbol = (el: HTMLElement, symbol: string) => {
        if (symbol === COFFEE_ICON || symbol === PIGEON_ICON || symbol === KNICKS_ICON) {
          const alt = symbol === COFFEE_ICON
            ? "New York Greek coffee cup"
            : symbol === PIGEON_ICON
              ? "New York pigeon"
              : "New York Knicks";
          el.innerHTML = `<img src="${symbol}" alt="${alt}" />`;
        } else {
          el.textContent = symbol;
        }
      };

      if (nycWord) {
        nycWord.addEventListener("mouseenter", () => {
          nycWord.dataset.hovered = "true";
          setNycSymbol(nycWord, NYC_EMOJIS[Math.floor(Math.random() * NYC_EMOJIS.length)]);
        });
        nycWord.addEventListener("mouseleave", () => {
          nycWord.textContent = "NYC";
        });

        if (!prefersReducedMotion) {
          let emojiIndex = 0;
          const cycleEmoji = () => {
            if (!nycWord.isConnected || nycWord.dataset.hovered) return;
            if (emojiIndex < NYC_EMOJIS.length) {
              setNycSymbol(nycWord, NYC_EMOJIS[emojiIndex++]);
              window.setTimeout(cycleEmoji, 135);
            } else {
              nycWord.textContent = "NYC";
            }
          };
          window.setTimeout(cycleEmoji, 120);
        }
      }

      if (loadRevealEls.length > 0) {
        if (prefersReducedMotion) {
          loadRevealEls.forEach((el) => el.classList.add("is-in"));
        } else {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              loadRevealEls.forEach((el, i) => {
                const delay =
                  i === 0 ? 0 : LOAD_REVEAL_HEADLINE_GAP_MS + (i - 1) * LOAD_REVEAL_STEP_MS;
                setTimeout(() => el.classList.add("is-in"), delay);
              });
            });
          });
        }
      }

      const nameTrigger = document.querySelector<HTMLElement>(".name-trigger");
      const namePhoto = document.querySelector<HTMLElement>(".name-photo");
      const introEl = document.querySelector<HTMLElement>(".intro");

      // .name-photo is a plain sibling of the paragraphs now (see the
      // markup above and the comment on .name-photo's CSS) rather
      // than a descendant of .name-trigger, so its position has to be
      // computed from .name-trigger's own rect instead of anchored
      // via CSS top/left.
      // Original design's aspect ratio (263:306), preserved when the
      // photo is resized to match the underline's width instead of
      // using a fixed size.
      const NAME_PHOTO_ASPECT = 306 / 263;

      function positionPhoto() {
        if (!nameTrigger || !namePhoto || !introEl) return;
        const triggerRect = nameTrigger.getBoundingClientRect();
        const introRect = introEl.getBoundingClientRect();
        const width = triggerRect.width;
        namePhoto.style.width = `${width}px`;
        namePhoto.style.height = `${width * NAME_PHOTO_ASPECT}px`;
        namePhoto.style.top = `${triggerRect.bottom - introRect.top + 5}px`;
        namePhoto.style.left = `${triggerRect.left - introRect.left}px`;
      }

      // Cursor-follow, à la Upstatement's hover-teases (upstatement.com) -
      // inspected live: theirs isn't CSS-transition-driven (the hover
      // figure computes to transition-duration: 0s), it's a
      // requestAnimationFrame loop lerping toward the cursor. This is
      // the same technique, sized down for a name-width card instead
      // of a full media tease: the photo's base position/size still
      // comes from positionPhoto() above (anchored to the underline),
      // and a small clamped offset on top of that drifts toward
      // wherever the cursor sits within the name, so the card feels
      // loosely attached to the pointer without ever leaving the
      // name's own footprint.
      const FOLLOW_RANGE_X = 22;
      const FOLLOW_RANGE_Y = 12;
      const FOLLOW_LERP = 0.16;
      const ENTRANCE_LERP = 0.22;

      let targetFollowX = 0;
      let targetFollowY = 0;
      let followX = 0;
      let followY = 0;
      let entranceT = 0; // 0 = just-revealed pose, 1 = settled
      let followRafId: number | null = null;

      function followTick() {
        followX += (targetFollowX - followX) * FOLLOW_LERP;
        followY += (targetFollowY - followY) * FOLLOW_LERP;
        entranceT += (1 - entranceT) * ENTRANCE_LERP;

        const scale = 0.97 + 0.03 * entranceT;
        const entranceY = -6 * (1 - entranceT);

        if (namePhoto) {
          namePhoto.style.transform = `translate(${followX.toFixed(2)}px, ${(followY + entranceY).toFixed(2)}px) scale(${scale.toFixed(4)})`;
        }

        const settled =
          Math.abs(targetFollowX - followX) < 0.05 &&
          Math.abs(targetFollowY - followY) < 0.05 &&
          entranceT > 0.999;

        if (!settled) {
          followRafId = requestAnimationFrame(followTick);
        } else {
          followRafId = null;
        }
      }

      function ensureFollowLoop() {
        if (followRafId == null) followRafId = requestAnimationFrame(followTick);
      }

      function updateFollowTarget(clientX: number, clientY: number) {
        if (!nameTrigger) return;
        const rect = nameTrigger.getBoundingClientRect();
        const relX = (clientX - rect.left) / rect.width;
        const relY = (clientY - rect.top) / rect.height;
        targetFollowX = (Math.min(1, Math.max(0, relX)) - 0.5) * 2 * FOLLOW_RANGE_X;
        targetFollowY = (Math.min(1, Math.max(0, relY)) - 0.5) * 2 * FOLLOW_RANGE_Y;
        ensureFollowLoop();
      }

      function showPhoto() {
        positionPhoto();
        entranceT = prefersReducedMotion ? 1 : 0;
        namePhoto?.classList.add("is-visible");
        ensureFollowLoop();
      }

      function hidePhoto() {
        namePhoto?.classList.remove("is-visible");
        targetFollowX = 0;
        targetFollowY = 0;
        ensureFollowLoop();
      }

      if (nameTrigger && window.matchMedia("(hover: none)").matches) {
        // Touch devices have no real hover, so the reveal is driven by
        // a tap-toggled class instead of relying on iOS's sticky-hover
        // simulation (unreliable to trigger, and skips the
        // transition/stagger entirely - see the (hover: none) padding
        // rule above for the matching tap-target fix). No cursor to
        // follow here either, so the photo just settles at center.
        nameTrigger.addEventListener("click", () => {
          const isActive = nameTrigger.classList.toggle("is-active");
          if (isActive) showPhoto();
          else hidePhoto();
        });

        document.addEventListener("click", (event) => {
          if (!nameTrigger.contains(event.target as Node)) {
            nameTrigger.classList.remove("is-active");
            hidePhoto();
          }
        });
      } else {
        nameTrigger?.addEventListener("mouseenter", showPhoto);
        if (!prefersReducedMotion) {
          nameTrigger?.addEventListener("mousemove", (event) => {
            updateFollowTarget(event.clientX, event.clientY);
          });
        }
        nameTrigger?.addEventListener("mouseleave", hidePhoto);
      }

      window.addEventListener("resize", () => {
        if (namePhoto?.classList.contains("is-visible")) positionPhoto();
      });

      // --- Work-list hover preview ---
      // Same Upstatement-style cursor-follow as .name-photo above, on
      // specific rows (Sublime, Pack, PPVP, Inveterate - set via
      // data-preview-img on the row itself). One shared image element
      // instead of one per row: on enter, it's repositioned to that
      // row's own rect and re-sourced; while hovered, only its y
      // drifts with the cursor as it moves within the row.
      const workList = document.querySelector<HTMLElement>(".work-list");
      const workPreview = document.getElementById("workPreview") as HTMLAnchorElement | null;
      const workPreviewImg = document.getElementById("workPreviewImg") as HTMLImageElement | null;
      const previewRows = document.querySelectorAll<HTMLElement>("[data-preview-img]");

      // Anchored to each row's own meta column (the year + arrow),
      // not to where the description text happens to end - the row
      // itself is capped at .col's width, so this keeps the preview
      // in the same fixed spot relative to the row, overlapping the
      // date, no matter how wide the browser window is.
      const PREVIEW_OVERLAP_LEAD = 28;
      const PREVIEW_WIDTH = 387;
      const PREVIEW_EDGE_MARGIN = 64;
      const PREVIEW_FOLLOW_RANGE_Y = 22;
      const PREVIEW_FOLLOW_RANGE_X = 14;
      const PREVIEW_FOLLOW_LERP = 0.16;
      const PREVIEW_ENTRANCE_LERP = 0.22;

      let previewTargetX = 0;
      let previewTargetY = 0;
      let previewFollowX = 0;
      let previewFollowY = 0;
      let previewEntranceT = 0;
      let previewRafId: number | null = null;
      let activePreviewRow: HTMLElement | null = null;
      let previewBaseTop = 0;

      function positionPreview(row: HTMLElement) {
        if (!workPreview || !workList) return;
        const metaEl = row.querySelector<HTMLElement>(".meta");
        const anchorRect = (metaEl ?? row).getBoundingClientRect();
        const rowRect = row.getBoundingClientRect();
        const listRect = workList.getBoundingClientRect();
        const previewHeight = workPreview.offsetHeight || (PREVIEW_WIDTH * 26) / 43;
        previewBaseTop = rowRect.top - listRect.top + rowRect.height / 2 - previewHeight / 2;
        const desiredLeft = anchorRect.left - listRect.left - PREVIEW_OVERLAP_LEAD;
        // Still clamped against the viewport as a safety net (e.g. a
        // browser window narrower than .col's own max-width), even
        // though anchoring to the row's meta column keeps this from
        // being the normal case.
        const maxLeft = window.innerWidth - listRect.left - PREVIEW_WIDTH - PREVIEW_EDGE_MARGIN;
        workPreview.style.left = `${Math.min(desiredLeft, maxLeft)}px`;
        workPreview.style.top = `${previewBaseTop}px`;
      }

      function previewTick() {
        previewFollowX += (previewTargetX - previewFollowX) * PREVIEW_FOLLOW_LERP;
        previewFollowY += (previewTargetY - previewFollowY) * PREVIEW_FOLLOW_LERP;
        previewEntranceT += (1 - previewEntranceT) * PREVIEW_ENTRANCE_LERP;

        const scale = 0.97 + 0.03 * previewEntranceT;
        const entranceY = -8 * (1 - previewEntranceT);

        if (workPreview) {
          workPreview.style.transform = `translate(${previewFollowX.toFixed(2)}px, ${(previewFollowY + entranceY).toFixed(2)}px) scale(${scale.toFixed(4)})`;
        }

        const settled =
          Math.abs(previewTargetX - previewFollowX) < 0.05 &&
          Math.abs(previewTargetY - previewFollowY) < 0.05 &&
          previewEntranceT > 0.999;

        if (!settled) {
          previewRafId = requestAnimationFrame(previewTick);
        } else {
          previewRafId = null;
        }
      }

      function ensurePreviewLoop() {
        if (previewRafId == null) previewRafId = requestAnimationFrame(previewTick);
      }

      function updatePreviewFollowTarget(clientX: number, clientY: number) {
        if (!activePreviewRow) return;
        const rect = activePreviewRow.getBoundingClientRect();
        const relX = (clientX - rect.left) / rect.width;
        const relY = (clientY - rect.top) / rect.height;
        previewTargetX = (Math.min(1, Math.max(0, relX)) - 0.5) * 2 * PREVIEW_FOLLOW_RANGE_X;
        previewTargetY = (Math.min(1, Math.max(0, relY)) - 0.5) * 2 * PREVIEW_FOLLOW_RANGE_Y;
        ensurePreviewLoop();
      }

      // The preview sits taller than a single row, so it visually
      // overlaps the row above/below the one it's previewing - moving
      // the cursor off the row's own text and onto the image itself
      // (or across the gap between them) used to fire the row's
      // mouseleave before the image could claim the hover, hiding the
      // preview mid-reach and restarting its entrance animation on
      // the way back in (a stutter/glimmer). A short grace timer plus
      // listeners on the preview itself keep it alive across that
      // gap, and re-hovering the same row no longer replays the
      // entrance.
      let previewHideTimer: number | null = null;

      function cancelPreviewHide() {
        if (previewHideTimer != null) {
          window.clearTimeout(previewHideTimer);
          previewHideTimer = null;
        }
      }

      function hidePreviewNow() {
        activePreviewRow = null;
        workPreview?.classList.remove("is-visible");
        previewTargetX = 0;
        previewTargetY = 0;
        ensurePreviewLoop();
      }

      function schedulePreviewHide() {
        cancelPreviewHide();
        previewHideTimer = window.setTimeout(() => {
          previewHideTimer = null;
          hidePreviewNow();
        }, 120);
      }

      function showPreview(row: HTMLElement) {
        if (!workPreview || !workPreviewImg) return;
        cancelPreviewHide();
        const alreadyShowingRow = activePreviewRow === row && workPreview.classList.contains("is-visible");
        activePreviewRow = row;
        workPreviewImg.src = row.dataset.previewImg ?? "";
        workPreviewImg.alt = row.dataset.previewAlt ?? "";
        // Link rows lend the preview their destination. Sublime's row
        // is a button (it opens the password gate), so the preview's
        // click is forwarded to it instead - see the handler below.
        if (row instanceof HTMLAnchorElement) {
          workPreview.href = row.href;
          workPreview.target = row.target;
          workPreview.rel = row.rel;
        } else {
          workPreview.removeAttribute("href");
          workPreview.removeAttribute("target");
          workPreview.removeAttribute("rel");
        }
        positionPreview(row);
        if (!alreadyShowingRow) {
          previewEntranceT = prefersReducedMotion ? 1 : 0;
        }
        workPreview.classList.add("is-visible");
        ensurePreviewLoop();
        workPreviewImg.onload = () => {
          if (activePreviewRow === row) positionPreview(row);
        };
      }

      if (!window.matchMedia("(hover: none)").matches) {
        previewRows.forEach((row) => {
          row.addEventListener("mouseenter", () => showPreview(row));
          if (!prefersReducedMotion) {
            row.addEventListener("mousemove", (event) => {
              updatePreviewFollowTarget(event.clientX, event.clientY);
            });
          }
          row.addEventListener("mouseleave", schedulePreviewHide);
        });

        if (workPreview) {
          workPreview.addEventListener("mouseenter", cancelPreviewHide);
          workPreview.addEventListener("mouseleave", schedulePreviewHide);
          workPreview.addEventListener("click", (event) => {
            if (!activePreviewRow || activePreviewRow instanceof HTMLAnchorElement) return;
            event.preventDefault();
            activePreviewRow.click();
          });
          if (!prefersReducedMotion) {
            workPreview.addEventListener("mousemove", (event) => {
              updatePreviewFollowTarget(event.clientX, event.clientY);
            });
          }
        }

        window.addEventListener("resize", () => {
          if (activePreviewRow) positionPreview(activePreviewRow);
        });
      }

      // --- Sublime password gate ---
      // Static site, no backend: this is a soft gate, not real access
      // control. Only a SHA-256 hash of the password ships, so it can't be
      // read off the page, and a correct entry is remembered in
      // localStorage, which the case study page checks before showing.
      const GATE_HASH = "2e678bda8969b9f5249fc236429ad8e44268e18579334a1dddb0bc958ebbc44c";
      const GATE_UNLOCK_KEY = "sublime-case-study-unlocked";
      const GATE_UNLOCK_HREF = "/work/sublime-security";

      async function matchesGate(value: string) {
        if (!window.crypto?.subtle) return false;
        const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
        const hex = [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
        return hex === GATE_HASH;
      }

      const gateTriggerBtn = document.getElementById("sublimeGateTrigger");
      const gateBackdrop = document.getElementById("gateBackdrop");
      const gateModal = document.querySelector<HTMLElement>(".gate-modal");
      const gateCancelBtn = document.getElementById("gateCancelBtn");
      const gateUnlockBtn = document.getElementById("gateUnlockBtn") as HTMLButtonElement | null;
      const gatePw = document.getElementById("gatePw") as HTMLInputElement | null;
      const gateError = document.getElementById("gateError");
      const gateEyeToggle = document.getElementById("gateEyeToggle");

      let gateChecking = false;

      function resetGateField() {
        gatePw?.classList.remove("is-error");
        gateError?.classList.remove("is-shown");
      }

      function openGate() {
        if (!gatePw || !gateBackdrop) return;
        gatePw.value = "";
        resetGateField();
        gateBackdrop.classList.add("is-open");
        setTimeout(() => gatePw.focus(), 150);
      }

      function closeGate() {
        gateBackdrop?.classList.remove("is-open");
      }

      gateTriggerBtn?.addEventListener("click", openGate);
      gateCancelBtn?.addEventListener("click", closeGate);
      gateBackdrop?.addEventListener("click", (event) => {
        if (event.target === gateBackdrop) closeGate();
      });
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          gateBackdrop?.classList.contains("is-open") &&
          !gateChecking
        ) {
          closeGate();
        }
      });

      gateEyeToggle?.addEventListener("click", () => {
        if (!gatePw) return;
        const showing = gateEyeToggle.classList.toggle("is-visible");
        const caret = gatePw.selectionStart;
        gatePw.type = showing ? "text" : "password";
        gateEyeToggle.setAttribute("aria-label", showing ? "Hide password" : "Show password");
        // Return focus to the input instead of leaving it on the
        // toggle button - keeps the field looking consistently
        // focused and avoids ever showing the button's own focus
        // ring on a mouse click, restoring the caret position it had
        // before the type swap.
        gatePw.focus();
        gatePw.setSelectionRange(caret, caret);
      });

      function setGateLoading(isLoading: boolean) {
        gateChecking = isLoading;
        gateUnlockBtn?.classList.toggle("is-loading", isLoading);
        if (gateUnlockBtn) gateUnlockBtn.disabled = isLoading;
        if (gateCancelBtn) (gateCancelBtn as HTMLButtonElement).disabled = isLoading;
        if (gatePw) gatePw.disabled = isLoading;
      }

      function attemptGateUnlock() {
        if (gateChecking || !gatePw || !gateError || !gateModal) return;
        if (gatePw.value.trim().length === 0) {
          gatePw.classList.add("is-error");
          gateError.textContent = "Enter a password to continue.";
          gateError.classList.add("is-shown");
          return;
        }

        resetGateField();
        setGateLoading(true);

        const attempt = gatePw.value.trim();
        setTimeout(async () => {
          const correct = await matchesGate(attempt);
          if (correct) {
            try {
              localStorage.setItem(GATE_UNLOCK_KEY, "1");
            } catch {
              // Storage blocked: the page will ask again, nothing breaks.
            }
            window.location.href = GATE_UNLOCK_HREF;
            return;
          }
          setGateLoading(false);
          gatePw.classList.add("is-error");
          gateError.textContent = "Incorrect password. Try again.";
          gateError.classList.add("is-shown");
          gateModal.classList.remove("is-shaking");
          void gateModal.offsetWidth;
          gateModal.classList.add("is-shaking");
          gatePw.focus();
          gatePw.select();
        }, 500);
      }

      gateUnlockBtn?.addEventListener("click", attemptGateUnlock);
      gatePw?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") attemptGateUnlock();
      });
      gatePw?.addEventListener("input", () => {
        if (gatePw.classList.contains("is-error")) resetGateField();
      });
    </script>
  </body>
</html>
