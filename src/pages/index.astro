---
import Topbar from "../components/Topbar.astro";

const PHOTO_GRID = 10;
const PHOTO_WIDTH = 263;
const PHOTO_HEIGHT = 306;
const tileWidth = PHOTO_WIDTH / PHOTO_GRID;
const tileHeight = PHOTO_HEIGHT / PHOTO_GRID;

// Stagger delay is randomized per hover at runtime (see the script
// below), not baked in here - only the slice position is fixed.
const photoTiles = Array.from({ length: PHOTO_GRID * PHOTO_GRID }, (_, i) => {
  const col = i % PHOTO_GRID;
  const row = Math.floor(i / PHOTO_GRID);
  return {
    style: `background-position: ${(-col * tileWidth).toFixed(2)}px ${(-row * tileHeight).toFixed(2)}px;`,
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>Humayun Rashid · Product Designer</title>
    <meta name="description" content="Humayun Rashid — product designer and founder based in New York City." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      /* Time-based dark mode (see the inline head script + Topbar's
         script, both keyed off NYC local time) - an off dark grey,
         never pure black, mirroring the light palette's warmth. */
      :root {
        --bg: #f8f8f6;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #8a8a8a;
        --hover-bg: #eae9e5;
        --title: #262626;
        --year: #9a9994;
        --icon: #c9c7c0;
        --icon-hover: #6b6b6b;
        --border: #e2e0da;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
        --photo-shadow: 0 16px 40px rgba(0, 0, 0, 0.16), 0 2px 8px rgba(0, 0, 0, 0.08);
      }

      :root[data-theme="dark"] {
        --bg: #1b1b19;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --hover-bg: #2b2b28;
        --title: #eeede8;
        --year: #77766f;
        --icon: #55544e;
        --icon-hover: #b5b4ad;
        --border: #333230;
        --selection-bg: #4fae82;
        --selection-text: #1b1b19;
        /* A black shadow reads as almost nothing against this near-black
           background, so dark mode leans on a soft light-edge glow
           instead of a darker shadow to give the card the same sense
           of lift. */
        --photo-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.06);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .intro {
        margin-top: 4.55rem;
      }

      .intro p {
        font-size: 1.15rem;
        line-height: 1.75;
        color: var(--text-secondary);
        margin: 0 0 1.25rem;
      }

      .intro p:last-child {
        margin-bottom: 0;
      }

      .intro a {
        text-decoration: none;
      }

      /* Headshot reveal on hovering the name - a small photo card that
         fades/lifts into view. The pixelation is the blur itself: the
         photo is sliced into a 10x10 grid of tiles, each showing its
         own piece of the image (via background-position), each
         individually blurred and staggered so they sharpen into focus
         out of order rather than as one flat crossfade. No color
         overlay - the blur alone reads as "pixelated". */
      .name-trigger {
        position: relative;
        display: inline-block;
      }

      .name-trigger::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.45s ease;
      }

      .name-trigger:hover::after {
        transform: scaleX(1);
      }

      .name-photo {
        position: absolute;
        top: calc(100% + 14px);
        left: 0;
        width: 263px;
        height: 306px;
        border-radius: 2px;
        overflow: hidden;
        opacity: 0;
        transform: translateY(-6px) scale(0.97);
        transition: opacity 0.3s ease, transform 0.3s ease;
        pointer-events: none;
        z-index: 30;
        box-shadow: var(--photo-shadow);
        background: var(--hover-bg);
      }

      .name-trigger:hover .name-photo {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .pixel-grid {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        grid-template-rows: repeat(10, 1fr);
      }

      /* Delay is set randomly per hover by the script below, not baked
         in at build time - no scale/zoom on the tiles themselves
         (that was causing the seams that read as "not smooth"), just
         a plain blur clearing, staggered. */
      .pixel-tile {
        background-image: url("/headshot.jpg");
        background-repeat: no-repeat;
        background-size: 263px 306px;
        filter: blur(9px);
        transition: filter 1s ease;
      }

      .name-trigger:hover .pixel-tile {
        filter: blur(0);
      }

      section {
        padding: 4.55rem 0 3.5rem;
      }

      .section-heading {
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--label);
        margin: 0 0 0.875rem;
      }

      .work-list {
        margin: 0 -0.9rem;
      }

      /* Hover highlight bleeds past the text measure on both sides, which is
         why each row gets its own horizontal padding instead of inheriting
         .col's - the highlight needs to extend beyond where the text sits. */
      .work-row {
        display: block;
        padding: 1.1rem 0.9rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      .work-row:hover {
        background: var(--hover-bg);
      }

      .work-row .title {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--title);
        display: block;
        margin-bottom: 0.3rem;
      }

      .work-row .row-bottom {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
      }

      .work-row .desc {
        font-size: 0.92rem;
        color: var(--label);
      }

      .work-row .meta {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        flex-shrink: 0;
      }

      .work-row .year {
        font-size: 0.85rem;
        color: var(--year);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .work-row .icon {
        font-size: 0.85rem;
        color: var(--icon);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
        display: inline-block;
      }

      .work-row:hover .icon {
        opacity: 1;
        color: var(--icon-hover);
      }

      .work-row:hover .icon.external {
        transform: translate(2px, -2px);
      }

      .work-row:hover .icon.internal {
        transform: translateX(2px);
      }

      footer {
        margin-top: 2.35rem;
        padding: 1.75rem 0 6rem;
        border-top: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.85rem;
        color: var(--label);
        flex-wrap: wrap;
        gap: 1rem;
      }

      footer .who {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      }

      footer .who .name {
        color: var(--title);
        font-weight: 500;
      }

      footer .tz {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
      }

      .blink {
        animation: blink 1s steps(1) infinite;
      }

      @keyframes blink {
        50%,
        100% {
          opacity: 0;
        }
      }

      footer .links {
        display: flex;
        gap: 0.9rem;
      }

      footer a {
        text-decoration: none;
      }

      footer a:hover {
        color: var(--title);
      }
    </style>
  </head>
  <body>
    <Topbar />

    <div class="col">
      <div class="intro">
        <p>
          I'm <span class="name-trigger">Humayun Rashid<span class="name-photo" role="img" aria-label="Headshot of Humayun Rashid">
              <span class="pixel-grid" aria-hidden="true">
                {photoTiles.map((tile) => <span class="pixel-tile" style={tile.style} />)}
              </span>
            </span></span>, a product designer and founder based in New
          York City with a decade of experience shipping products people actually want to use.
          Most recently, I led design at Sublime Security, the fastest growing email security startup in the US, shipping tools like
          quarantine digest and phishing simulations. Before that, I founded and ran Nessa Labs,
          a design studio where I advised and designed products for early stage SaaS founders
          navigating their first real growth push.
        </p>
        <p>
          I care about what never makes it onto the screen: the onboarding flow nobody notices,
          the empty state that quietly loses the user, the setting that should've been the
          default all along. Getting those details right starts with talking to users, understanding
          where they get stuck before assuming you know the fix. That's where the real work
          happens, and where most teams give up.
        </p>
        <p>
          Great design isn't about adding more features, it's about subtracting until what's
          left feels like magic.
        </p>
      </div>

      <section>
        <p class="section-heading">Select Work</p>

        <div class="work-list">
          <a class="work-row" href="https://sublime.security/" target="_blank" rel="noopener">
            <span class="title">Sublime Security</span>
            <span class="row-bottom">
              <span class="desc">Led product design for security teams to stop malicious threats.</span>
              <span class="meta">
                <span class="year">2026</span>
                <span class="icon external">↗</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/nessa-labs">
            <span class="title">Nessa Labs</span>
            <span class="row-bottom">
              <span class="desc">Founder &amp; Design Director of product design studio for early stage startups.</span>
              <span class="meta">
                <span class="year">2021 – 2026</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/pack">
            <span class="title">Pack Platform</span>
            <span class="row-bottom">
              <span class="desc">Product redesign for headless commerce platform.</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/ppvp">
            <span class="title">PPVP</span>
            <span class="row-bottom">
              <span class="desc">Mobile app design for investment platform for early stage funding.</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/inveterate">
            <span class="title">Inveterate</span>
            <span class="row-bottom">
              <span class="desc">Product strategy and design for loyalty and membership platform.</span>
              <span class="meta">
                <span class="year">2022</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="https://www.shoppinggives.com/" target="_blank" rel="noopener">
            <span class="title">Shopping Gives</span>
            <span class="row-bottom">
              <span class="desc">Product strategy and design for donation enablement platform.</span>
              <span class="meta">
                <span class="year">2022</span>
                <span class="icon external">↗</span>
              </span>
            </span>
          </a>
        </div>
      </section>

      <footer>
        <span class="who">
          <span class="name">Humayun Rashid</span>
          <span class="tz">
            <span>NYC</span>
            <span id="nyc-time">—:— —</span>
          </span>
        </span>
        <span class="links">
          <a href="https://www.linkedin.com/in/humayunrashid/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/itshum" target="_blank" rel="noopener">Github</a>
          <a href="https://x.com/humrashid" target="_blank" rel="noopener">Twitter</a>
          <a href="/humayun-rashid-resume.pdf" target="_blank" rel="noopener" type="application/pdf">CV</a>
        </span>
      </footer>
    </div>

    <script>
      const el = document.getElementById("nyc-time");
      function updateClock() {
        const parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          minute: "2-digit",
          hour12: true,
        }).formatToParts(new Date());
        const hour = parts.find((p) => p.type === "hour")?.value ?? "-";
        const minute = parts.find((p) => p.type === "minute")?.value ?? "--";
        const period = parts.find((p) => p.type === "dayPeriod")?.value ?? "";
        el.innerHTML = `${hour}<span class="blink">:</span>${minute} ${period}`;
      }
      updateClock();
      setInterval(updateClock, 1000);

      // Re-randomize which tiles clear first on every hover, so the
      // reveal never sweeps the same top-left-to-bottom-right way
      // twice in a row.
      const MAX_DELAY_S = 0.9;
      const nameTrigger = document.querySelector(".name-trigger");
      const pixelTiles = document.querySelectorAll(".pixel-tile");

      nameTrigger?.addEventListener("mouseenter", () => {
        pixelTiles.forEach((tile) => {
          tile.style.transitionDelay = `${(Math.random() * MAX_DELAY_S).toFixed(3)}s`;
        });
      });
    </script>
  </body>
</html>
