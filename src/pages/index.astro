---
import Topbar from "../components/Topbar.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>Humayun Rashid · Product Designer</title>
    <meta name="description" content="Humayun Rashid — product designer and founder based in New York City." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      /* Time-based dark mode (see the inline head script + Topbar's
         script, both keyed off NYC local time) - an off dark grey,
         never pure black, mirroring the light palette's warmth. */
      :root {
        --bg: #f8f8f6;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #8a8a8a;
        --hover-bg: #eae9e5;
        --title: #262626;
        --year: #9a9994;
        --icon: #c9c7c0;
        --icon-hover: #6b6b6b;
        --border: #e2e0da;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #1b1b19;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --hover-bg: #2b2b28;
        --title: #eeede8;
        --year: #77766f;
        --icon: #55544e;
        --icon-hover: #b5b4ad;
        --border: #333230;
        --selection-bg: #4fae82;
        --selection-text: #1b1b19;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .intro {
        margin-top: 4.55rem;
      }

      .intro p {
        font-size: 1.15rem;
        line-height: 1.75;
        color: var(--text-secondary);
        margin: 0 0 1.25rem;
      }

      .intro p:last-child {
        margin-bottom: 0;
      }

      .intro a {
        text-decoration: none;
      }

      /* Headshot reveal on hovering the name - a small photo card that
         fades/lifts into view, its image starting blurred behind a
         pixel-grid overlay (same 4x4 motif as the logo mark) that
         clears over a couple seconds, like the pixels resolving into
         a real photo instead of a plain blur-to-sharp crossfade. */
      .name-trigger {
        position: relative;
        display: inline-block;
      }

      .name-photo {
        position: absolute;
        top: calc(100% + 14px);
        left: 0;
        width: 210px;
        height: 245px;
        border-radius: 8px;
        overflow: hidden;
        opacity: 0;
        transform: translateY(-6px) scale(0.97);
        transition: opacity 0.3s ease, transform 0.3s ease;
        pointer-events: none;
        z-index: 30;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
        background: var(--hover-bg);
      }

      .name-trigger:hover .name-photo {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .name-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: blur(16px) saturate(0.6);
        transform: scale(1.1);
        transition: filter 1.6s cubic-bezier(0.2, 0.7, 0.3, 1), transform 1.6s cubic-bezier(0.2, 0.7, 0.3, 1);
      }

      .name-trigger:hover .name-photo img {
        filter: blur(0) saturate(1);
        transform: scale(1);
      }

      .name-photo .pixel-overlay {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(4, 1fr);
      }

      .name-photo .pixel-overlay span {
        background: #1f3d2e;
        opacity: 0.9;
        transition: opacity 0.5s ease;
      }

      .name-photo .pixel-overlay span:nth-child(4n + 2) {
        background: #f4f4f0;
      }

      .name-photo .pixel-overlay span:nth-child(3n) {
        background: #f4f4f0;
      }

      /* Staggered per-cell fade so the grid dissolves unevenly rather
         than as one flat wash. */
      .name-photo .pixel-overlay span:nth-child(1) { transition-delay: 0.05s; }
      .name-photo .pixel-overlay span:nth-child(2) { transition-delay: 0.15s; }
      .name-photo .pixel-overlay span:nth-child(3) { transition-delay: 0.08s; }
      .name-photo .pixel-overlay span:nth-child(4) { transition-delay: 0.22s; }
      .name-photo .pixel-overlay span:nth-child(5) { transition-delay: 0.18s; }
      .name-photo .pixel-overlay span:nth-child(6) { transition-delay: 0.3s; }
      .name-photo .pixel-overlay span:nth-child(7) { transition-delay: 0.12s; }
      .name-photo .pixel-overlay span:nth-child(8) { transition-delay: 0.35s; }
      .name-photo .pixel-overlay span:nth-child(9) { transition-delay: 0.25s; }
      .name-photo .pixel-overlay span:nth-child(10) { transition-delay: 0.1s; }
      .name-photo .pixel-overlay span:nth-child(11) { transition-delay: 0.4s; }
      .name-photo .pixel-overlay span:nth-child(12) { transition-delay: 0.2s; }
      .name-photo .pixel-overlay span:nth-child(13) { transition-delay: 0.45s; }
      .name-photo .pixel-overlay span:nth-child(14) { transition-delay: 0.28s; }
      .name-photo .pixel-overlay span:nth-child(15) { transition-delay: 0.5s; }
      .name-photo .pixel-overlay span:nth-child(16) { transition-delay: 0.38s; }

      .name-trigger:hover .name-photo .pixel-overlay span {
        opacity: 0;
      }

      section {
        padding: 4.55rem 0 3.5rem;
      }

      .section-heading {
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--label);
        margin: 0 0 0.875rem;
      }

      .work-list {
        margin: 0 -0.9rem;
      }

      /* Hover highlight bleeds past the text measure on both sides, which is
         why each row gets its own horizontal padding instead of inheriting
         .col's - the highlight needs to extend beyond where the text sits. */
      .work-row {
        display: block;
        padding: 1.1rem 0.9rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      .work-row:hover {
        background: var(--hover-bg);
      }

      .work-row .title {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--title);
        display: block;
        margin-bottom: 0.3rem;
      }

      .work-row .row-bottom {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
      }

      .work-row .desc {
        font-size: 0.92rem;
        color: var(--label);
      }

      .work-row .meta {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        flex-shrink: 0;
      }

      .work-row .year {
        font-size: 0.85rem;
        color: var(--year);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .work-row .icon {
        font-size: 0.85rem;
        color: var(--icon);
        opacity: 0;
        transition: opacity 0.15s ease, transform 0.15s ease;
        display: inline-block;
      }

      .work-row:hover .icon {
        opacity: 1;
        color: var(--icon-hover);
      }

      .work-row:hover .icon.external {
        transform: translate(2px, -2px);
      }

      .work-row:hover .icon.internal {
        transform: translateX(2px);
      }

      footer {
        margin-top: 2.35rem;
        padding: 1.75rem 0 6rem;
        border-top: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.85rem;
        color: var(--label);
        flex-wrap: wrap;
        gap: 1rem;
      }

      footer .who {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      }

      footer .who .name {
        color: var(--title);
        font-weight: 500;
      }

      footer .tz {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
      }

      .blink {
        animation: blink 1s steps(1) infinite;
      }

      @keyframes blink {
        50%,
        100% {
          opacity: 0;
        }
      }

      footer .links {
        display: flex;
        gap: 0.9rem;
      }

      footer a {
        text-decoration: none;
      }

      footer a:hover {
        color: var(--title);
      }
    </style>
  </head>
  <body>
    <Topbar />

    <div class="col">
      <div class="intro">
        <p>
          I'm <span class="name-trigger">Humayun Rashid<span class="name-photo">
              <img src="/headshot.jpg" alt="Humayun Rashid" />
              <span class="pixel-overlay">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
              </span>
            </span></span>, a product designer and founder based in New
          York City with a decade of experience shipping products people actually want to use.
          Most recently, I led design at Sublime Security, the fastest growing email security startup in the US, shipping tools like
          quarantine digest and phishing simulations. Before that, I founded and ran Nessa Labs,
          a design studio where I advised and designed products for early stage SaaS founders
          navigating their first real growth push.
        </p>
        <p>
          I care about what never makes it onto the screen: the onboarding flow nobody notices,
          the empty state that quietly loses the user, the setting that should've been the
          default all along. Getting those details right starts with talking to users, understanding
          where they get stuck before assuming you know the fix. That's where the real work
          happens, and where most teams give up.
        </p>
        <p>
          Great design isn't about adding more features, it's about subtracting until what's
          left feels like magic.
        </p>
      </div>

      <section>
        <p class="section-heading">Select Work</p>

        <div class="work-list">
          <a class="work-row" href="https://sublime.security/" target="_blank" rel="noopener">
            <span class="title">Sublime Security</span>
            <span class="row-bottom">
              <span class="desc">Led product design for security teams to stop malicious threats.</span>
              <span class="meta">
                <span class="year">2026</span>
                <span class="icon external">↗</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/nessa-labs">
            <span class="title">Nessa Labs</span>
            <span class="row-bottom">
              <span class="desc">Founder &amp; Design Director of product design studio for early stage startups.</span>
              <span class="meta">
                <span class="year">2021 – 2026</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/pack">
            <span class="title">Pack Platform</span>
            <span class="row-bottom">
              <span class="desc">Product redesign for headless commerce platform.</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/ppvp">
            <span class="title">PPVP</span>
            <span class="row-bottom">
              <span class="desc">Mobile app design for investment platform for early stage funding.</span>
              <span class="meta">
                <span class="year">2023</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="/work/inveterate">
            <span class="title">Inveterate</span>
            <span class="row-bottom">
              <span class="desc">Product strategy and design for loyalty and membership platform.</span>
              <span class="meta">
                <span class="year">2022</span>
                <span class="icon internal">→</span>
              </span>
            </span>
          </a>

          <a class="work-row" href="https://www.shoppinggives.com/" target="_blank" rel="noopener">
            <span class="title">Shopping Gives</span>
            <span class="row-bottom">
              <span class="desc">Product strategy and design for donation enablement platform.</span>
              <span class="meta">
                <span class="year">2022</span>
                <span class="icon external">↗</span>
              </span>
            </span>
          </a>
        </div>
      </section>

      <footer>
        <span class="who">
          <span class="name">Humayun Rashid</span>
          <span class="tz">
            <span>NYC</span>
            <span id="nyc-time">—:— —</span>
          </span>
        </span>
        <span class="links">
          <a href="https://www.linkedin.com/in/humayunrashid/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/itshum" target="_blank" rel="noopener">Github</a>
          <a href="https://x.com/humrashid" target="_blank" rel="noopener">Twitter</a>
          <a href="/humayun-rashid-resume.pdf" target="_blank" rel="noopener" type="application/pdf">CV</a>
        </span>
      </footer>
    </div>

    <script>
      const el = document.getElementById("nyc-time");
      function updateClock() {
        const parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          minute: "2-digit",
          hour12: true,
        }).formatToParts(new Date());
        const hour = parts.find((p) => p.type === "hour")?.value ?? "-";
        const minute = parts.find((p) => p.type === "minute")?.value ?? "--";
        const period = parts.find((p) => p.type === "dayPeriod")?.value ?? "";
        el.innerHTML = `${hour}<span class="blink">:</span>${minute} ${period}`;
      }
      updateClock();
      setInterval(updateClock, 1000);
    </script>
  </body>
</html>
