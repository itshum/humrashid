---
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import signatureSvg from "../assets/humayun-signature-strokes.svg?raw";

const polishedSignatureSvg = signatureSvg.replace('viewBox="0 0 1000 364"', 'viewBox="220 125 650 185"');
---

<!doctype html>
<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/about" />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <style is:inline>
      html[data-theme="dark"] {
        background: #16171c;
        color: #eeede8;
      }
      html:not([data-theme="dark"]) {
        background: #f6f6f3;
        color: #262626;
      }
    </style>
    <title>About · Humayun Rashid</title>
    <meta name="description" content="A bit about me — how I think about design, and what I'm doing now." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Humayun Rashid" />
    <meta property="og:title" content="About · Humayun Rashid" />
    <meta property="og:url" content="https://www.humrashid.com/about" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      /* same tokens as the case-study template — this page follows the
         exact same shell (Topbar back-arrow format, dark mode, fonts) */
      :root {
        --bg: #f6f6f3;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #e8e7e2;
        --title: #262626;
        --year: #8a8984;
        --icon: #c9c7c0;
        --icon-hover: #6b6b6b;
        --border: #e0ded7;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #a1a09a;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --icon: #474641;
        --icon-hover: #b5b4ad;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scrollbar-color: var(--border) var(--bg);
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      body {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
      }

      body > .col { flex: 1; }
      body > .site-footer { margin-top: auto; }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col {
          padding: 0 2rem;
        }
      }

      .about-hero {
        padding: 5.25rem 0 1rem;
      }

      .about-hero .eyebrow {
        font-size: 0.8rem;
        color: var(--label);
        margin: 0 0 1.25rem;
      }

      .about-hero h1 {
        font-size: 2.25rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        margin: 0;
      }

      .prose {
        padding: 1rem 0 2rem;
        font-size: 1.08rem;
        line-height: 1.75;
        color: var(--text-secondary);
      }

      .prose p {
        margin: 0 0 1.4rem;
      }
      .prose p:last-child {
        margin-bottom: 0;
      }

      /* The original trackpad drawing stays vector-sharp at every size. */
      .sign-off {
        padding: 2.75rem 0 5rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
      }

      .sign-off-line {
        margin: 0 0 1.25rem;
        font-size: 1.08rem;
        line-height: 1.75;
        color: var(--text-secondary);
      }

      .signature {
        width: min(100%, 218px);
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.55s ease, transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .signature svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
      }

      .signature path {
        stroke: var(--title);
        stroke-dasharray: var(--path-length);
        stroke-dashoffset: var(--path-length);
      }

      .signature.is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      .signature.is-revealed path {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset var(--draw-duration) linear var(--draw-delay);
      }

      @media (prefers-reduced-motion: reduce) {
        .signature { transition: none; }
        .signature path { stroke-dashoffset: 0; transition: none; }
      }
    </style>
  </head>
  <body>
    <Topbar showBack iconOnlyBack hideLogo />

    <div class="col">
      <div class="about-hero">
        <h1>Hi, I'm Humayun.</h1>
      </div>

      <div class="prose">
        <p>
          I've spent over a decade designing and building products across B2B SaaS and eCommerce.
          Most recently, I was on the early design team at Sublime Security, the fastest-growing
          cybersecurity email startup in the US, where I led design on launches like Quarantine
          Digest and Dynamic Phishing Simulations. Before that, I founded and led Nessa Labs, a studio
          where I advised founders and designed digital products for early-stage startups.
        </p>
        <p>
          I've also built and exited digital agencies, and worked alongside founders to take their
          products from nothing to acquisition. That's given me a real sense of what it takes to build
          something people actually use, not just design around one.
        </p>
        <p>
          I care about how things connect, and how that shapes the smallest details. The people using
          what I design are real, with real needs, not abstractions. That's what draws me to the parts
          of a product nobody notices: the empty state that quietly loses someone, the setting that
          should've been the default all along. Getting those right starts with talking to users,
          understanding where they get stuck before assuming I know the fix. That's where the real work
          happens, and where most teams stop looking. Great design is deciding what to leave out.
        </p>
        <p>
          Beyond work, I'm an avid marathoner, usually running alongside my three-year-old Vizsla,
          Mars. In the kitchen, I'm reconstructing Bangladeshi classics from scratch and digging into
          the food science behind them. Travel is where those interests collide: I explore a city
          through its food, culture, and art, doing my best Anthony Bourdain impression along the way.
        </p>
      </div>

      <div class="sign-off">
        <p class="sign-off-line">Stay curious,</p>
        <div class="signature" data-reveal role="img" aria-label="Handwritten signature of Humayun Rashid" set:html={polishedSignatureSvg}></div>
      </div>
    </div>

    <Footer />

    <script>
      const signature = document.querySelector<HTMLElement>(".signature[data-reveal]");
      if (signature) {
        const playbackSpeed = 0.62;
        signature.querySelectorAll<SVGPathElement>("path").forEach((path) => {
          const length = path.getTotalLength();
          const duration = Number(path.dataset.duration || 700) * playbackSpeed;
          const delay = Number(path.dataset.delay || 0) * playbackSpeed;
          path.style.setProperty("--path-length", `${length}`);
          path.style.setProperty("--draw-duration", `${duration}ms`);
          path.style.setProperty("--draw-delay", `${delay + 120}ms`);
        });

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.6 }
          );
          observer.observe(signature);
        } else {
          signature.classList.add("is-revealed");
        }
      }

    </script>
  </body>
</html>
