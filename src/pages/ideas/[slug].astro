---
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("ideas", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(data.date);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={`https://www.humrashid.com/ideas/${entry.id}`} />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>{data.title} · Humayun Rashid</title>
    <meta name="description" content={data.excerpt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      :root {
        --bg: #f8f8f6;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --title: #262626;
        --year: #8a8984;
        --border: #e2e0da;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #171715;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --title: #eeede8;
        --year: #73726b;
        --border: #2f2e2c;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col {
          padding: 0 2rem;
        }
      }

      .post-hero {
        padding: 4.5rem 0 3rem;
      }

      .post-hero .eyebrow {
        font-size: 0.8rem;
        color: var(--label);
        margin: 0 0 1.25rem;
      }

      .post-hero h1 {
        font-size: 2.1rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        line-height: 1.3;
        margin: 0 0 1rem;
        text-wrap: balance;
      }

      .post-hero .date {
        font-size: 0.85rem;
        color: var(--year);
        font-variant-numeric: tabular-nums;
      }

      @media (max-width: 600px) {
        .post-hero h1 {
          font-size: 1.65rem;
        }
      }

      .post-body {
        padding-bottom: 6rem;
      }

      .post-body p {
        font-size: 1.05rem;
        line-height: 1.75;
        color: var(--text-secondary);
        margin: 0 0 1.5rem;
      }

      .post-body p:last-child {
        margin-bottom: 0;
      }

      /* Subtle fade-up on scroll, same feel as the case study
         template and the Principles page - fires once. */
      [data-reveal] {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <Topbar showBack />

    <div class="col">
      <div class="post-hero" data-reveal>
        <p class="eyebrow">Ideas</p>
        <h1>{data.title}</h1>
        <p class="date">{formattedDate}</p>
      </div>
    </div>

    <div class="col">
      <div class="post-body" data-reveal>
        <Content />
      </div>
    </div>

    <Footer />

    <script>
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (revealEls.length > 0) {
        if ("IntersectionObserver" in window) {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-revealed");
                revealObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
          );
          revealEls.forEach((el) => revealObserver.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add("is-revealed"));
        }
      }
    </script>
  </body>
</html>
