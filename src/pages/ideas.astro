---
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("ideas", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(
    date
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://www.humrashid.com/ideas" />
    <script is:inline>
      // Set before first paint so there's no light-mode flash before
      // Topbar's script confirms/re-checks the same NYC-time rule.
      (function () {
        var parts = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "numeric",
          hour12: false,
        }).formatToParts(new Date());
        var hour = Number(
          (parts.filter(function (p) {
            return p.type === "hour";
          })[0] || {}).value || 12
        );
        document.documentElement.dataset.theme = hour >= 19 || hour < 6 ? "dark" : "light";
      })();
    </script>
    <title>Ideas · Humayun Rashid</title>
    <meta
      name="description"
      content="Notes on design, product, and building things worth using, from Humayun Rashid."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      :root {
        --bg: #e9e7e2;
        --text: #262626;
        --text-secondary: #2b2b2b;
        --label: #7a7a7a;
        --hover-bg: #dbd8d1;
        --title: #262626;
        --year: #8a8984;
        --border: #d3cfc6;
        --selection-bg: #1f3d2e;
        --selection-text: #f8f8f6;
      }

      :root[data-theme="dark"] {
        --bg: #0d0d0c;
        --text: #eeede8;
        --text-secondary: #d6d5d0;
        --label: #93928c;
        --hover-bg: #1d1d1b;
        --title: #eeede8;
        --year: #696862;
        --border: #252423;
        --selection-bg: #4fae82;
        --selection-text: #171715;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      .col {
        max-width: 718px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media (max-width: 600px) {
        .col {
          padding: 0 2rem;
        }
      }

      .post-list {
        padding: 4.5rem 0 8rem;
        margin: 0 -0.9rem;
      }

      /* Same hover treatment as .work-row on the homepage - the
         highlight bleeds past the text measure on both sides, which
         is why the row gets its own horizontal padding instead of
         inheriting .col's. */
      .post-row {
        display: block;
        padding: 1.1rem 0.9rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      .post-row:hover,
      .post-row:active {
        background: var(--hover-bg);
      }

      .post-row .row-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
      }

      /* min-width: 0 lets a flex item shrink below its content size,
         which is what allows the ellipsis truncation to actually
         engage instead of the row just overflowing. Both title and
         excerpt clamp to a single line so every row reserves exactly
         the same height, whatever the real post title ends up being. */
      .post-row .title {
        margin: 0;
        min-width: 0;
        flex: 1;
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--title);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .post-row .date {
        font-size: 0.85rem;
        color: var(--year);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .post-row .excerpt {
        display: block;
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--label);
        margin-top: 0.5rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      @media (min-width: 601px) and (max-width: 1000px) {
        .post-row .title {
          font-size: 1.2rem;
        }

        .post-row .excerpt {
          font-size: 1.02rem;
        }

        .post-row .date {
          font-size: 0.92rem;
        }
      }

      /* Subtle fade-up on scroll, same feel as the case study
         template and the Principles page - fires once. */
      [data-reveal] {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <Topbar showBack />

    <div class="col">
      <div class="post-list">
        {
          posts.map((post, i) => (
            <a class="post-row" href={`/ideas/${post.id}`} data-reveal style={`transition-delay: ${i * 70}ms`}>
              <div class="row-top">
                <h2 class="title">{post.data.title}</h2>
                <span class="date">{formatDate(post.data.date)}</span>
              </div>
              <span class="excerpt">{post.data.excerpt}</span>
            </a>
          ))
        }
      </div>
    </div>

    <Footer />

    <script>
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (revealEls.length > 0) {
        if ("IntersectionObserver" in window) {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-revealed");
                revealObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
          );
          revealEls.forEach((el) => revealObserver.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add("is-revealed"));
        }
      }
    </script>
  </body>
</html>
