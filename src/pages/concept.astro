---
// Low-fidelity prototype: sphere/orbit navigation mechanic.
// Testing real content formats now: a Safari-style browser panel (live
// iframe + hover-to-visit), a Mobbin-style card (media block + headline +
// subtext), and a Polaroid-style photo panel with camera metadata. Panels
// vary in size by content kind. Positioning is still a true sphere
// (longitude/latitude per panel), with resistance-then-hard-lock dragging
// and an infinite loop on both axes.

// Nav logo: a real circle — straight horizontal rows and vertical
// columns of an 11x11 grid, with any cell farther than LOGO_RADIUS from
// the center dropped, tapering each row's length near the top/bottom
// exactly like the reference. Not a spiral: every dot lines up with its
// row and column neighbors.
const LOGO_GRID_N = 11;
const LOGO_RADIUS = 5.2; // in grid units from center
const logoDots = Array.from({ length: LOGO_GRID_N * LOGO_GRID_N }, (_, i) => {
  const row = Math.floor(i / LOGO_GRID_N);
  const col = i % LOGO_GRID_N;
  const center = (LOGO_GRID_N - 1) / 2;
  const dist = Math.hypot(row - center, col - center);
  // deterministic pseudo-random (not Math.random — this needs to render
  // the same on every request) pick of which dots carry the shimmer
  const pseudoRandom = ((i * 9301 + 49297) % 233280) / 233280;
  return {
    visible: dist <= LOGO_RADIUS,
    isLetter: pseudoRandom < 0.45,
    delayMs: Math.round((row / LOGO_GRID_N) * 320),
  };
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>concept — orbit nav</title>
		<meta name="robots" content="noindex" />
		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				overflow: hidden;
				background: #fff;
				font-family: system-ui, -apple-system, sans-serif;
				color: #111;
				touch-action: none;
				user-select: none;
				-webkit-user-select: none;
				/* the dedicated control for this, distinct from wheel's own
				   preventDefault: without it, some browsers still run their own
				   overscroll bounce/pull-to-refresh chrome at the top/bottom of
				   the page on a fast vertical scroll, which is its own source of
				   a white flash independent of anything happening in #stage */
				overscroll-behavior: none;
			}

			#stage {
				position: fixed;
				inset: 0;
				overscroll-behavior: none;
				perspective: 1600px;
				perspective-origin: 50% 50%;
				cursor: grab;
			}
			#stage.grabbing {
				cursor: grabbing;
			}

			#field {
				position: absolute;
				inset: 0;
				transform-style: preserve-3d;
			}

			/* outer wrapper: JS-controlled sphere position/rotation/scale only */
			.panel-wrap {
				position: absolute;
				top: 50%;
				left: 50%;
				will-change: transform, opacity, filter;
			}

			/* inner surface: carries the idle float + shadow, composes with the
			   outer transform instead of fighting it for the same property */
			.panel-surface {
				width: 100%;
				height: 100%;
				border-radius: 14px;
				animation: floaty 6s ease-in-out infinite;
				transition: box-shadow 300ms ease;
			}
			@keyframes floaty {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-8px);
				}
			}
			/* a slot's content identity changes constantly as it's recycled to
			   a new column/row — this softens that swap into a quick flash
			   instead of an instant pop, restarted from JS on every swap */
			@keyframes panelSwapFade {
				from {
					opacity: 0.35;
				}
				to {
					opacity: 1;
				}
			}
			.panel-surface.is-swapping {
				animation: floaty 6s ease-in-out infinite, panelSwapFade 220ms ease-out;
			}

			/* ---- home: just the text, no card/box around it ---- */
			.k-home .panel-surface {
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 24px;
				border-radius: 0;
			}
			.k-home .home-label {
				font-size: clamp(28px, 4.2vw, 64px); /* 30% down from clamp(40,6vw,92) */
				color: #111;
				font-weight: 500;
				line-height: 1.15;
				letter-spacing: -0.01em;
				display: inline-block; /* own box for the bottom-to-top reveal transform */
			}
			.nyc-word {
				display: inline-block;
				cursor: pointer;
			}

			/* ---- card: Mobbin-style — media block, then headline + subtext below ---- */
			.k-card .panel-surface {
				display: flex;
				flex-direction: column;
				gap: 14px;
				pointer-events: auto;
			}
			.card-media {
				flex: 1;
				border-radius: 12px;
				background: #ececec;
				background-size: cover;
				background-position: center;
				position: relative;
			}
			.card-media .tag {
				position: absolute;
				top: 10px;
				left: 10px;
				background: rgba(0, 0, 0, 0.55);
				color: #fff;
				font-size: 10px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 3px 9px;
				border-radius: 999px;
			}
			/* hover-to-visit arrow, real case studies only (item.link set) —
			   same treatment as the browser panel's visit affordance */
			.card-visit {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 12px;
				background: rgba(255, 255, 255, 0);
				opacity: 0;
				transition: opacity 200ms, background 200ms;
				text-decoration: none;
				border: none;
				padding: 0;
				cursor: pointer;
				font: inherit;
			}
			.card-media:hover .card-visit {
				opacity: 1;
				background: rgba(255, 255, 255, 0.35);
			}
			.card-visit-icon {
				width: 52px;
				height: 52px;
				border-radius: 999px;
				background: #111;
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
				transform: scale(0.85);
				transition: transform 200ms;
			}
			.card-media:hover .card-visit-icon {
				transform: scale(1);
			}
			.card-text {
				padding: 0 2px;
			}
			.card-title {
				font-size: 17px;
				font-weight: 600;
				color: #111;
				margin-bottom: 4px;
			}
			.card-subtitle {
				font-size: 13px;
				color: #999;
				line-height: 1.4;
			}
			/* case studies are bigger by default (CASE_STUDY size) — scale the
			   text to match instead of leaving it at the generic-card size */
			.card-text.is-case-study .card-title {
				font-size: 23px;
				margin-bottom: 6px;
			}
			.card-text.is-case-study .card-subtitle {
				font-size: 16px;
			}

			/* ---- browser: Safari chrome + live iframe + hover-to-visit, with
			   a title/subtitle caption below — same shell shape as .k-card
			   (window flex:1, caption auto-height below it) so browser and
			   case-study panels read as the same family in Work mode ---- */
			.k-browser .panel-surface {
				display: flex;
				flex-direction: column;
				gap: 14px;
				pointer-events: auto;
			}
			.browser-window {
				flex: 1;
				display: flex;
				flex-direction: column;
				background: #fdfdfd;
				border-radius: 14px;
				overflow: hidden;
				border: 1px solid #e4e4e4;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), inset 0 0 0 1px rgba(255, 255, 255, 0.6);
				min-height: 0;
			}
			/* real macOS Safari toolbar: traffic lights, sidebar + back
			   controls, a centered pill address bar (lock/domain/reload), then
			   the download/share/new-tab/tab-overview icon cluster on the
			   right — same grouping and order as the reference window */
			.browser-chrome {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 11px 14px;
				background: #f7f7f7;
				border-bottom: 1px solid #e3e3e3;
			}
			.browser-dots {
				display: flex;
				gap: 7px;
				flex-shrink: 0;
			}
			.browser-dots svg {
				width: 12px;
				height: 12px;
				display: block;
			}
			.browser-tool-group {
				display: flex;
				align-items: center;
				gap: 9px;
				flex-shrink: 0;
				color: #a3a3a3;
			}
			.browser-tool-group svg {
				width: 14px;
				height: 14px;
				display: block;
			}
			.browser-tool-group .chevron-down svg {
				width: 9px;
				height: 9px;
			}
			.browser-url {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 6px;
				background: #fff;
				border: 1px solid #e2e2e2;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
				border-radius: 8px;
				padding: 6px 10px;
				font-size: 12px;
				color: #444;
				min-width: 0;
			}
			.browser-url svg {
				width: 11px;
				height: 11px;
				flex-shrink: 0;
				color: #9a9a9a;
			}
			.browser-url .browser-reload {
				margin-left: auto;
			}
			.browser-url span {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.browser-body {
				position: relative;
				flex: 1;
				background: #fafafa;
			}
			.browser-body iframe {
				width: 100%;
				height: 100%;
				border: 0;
				display: block;
				pointer-events: none; /* the iframe never steals the drag */
			}
			/* peripheral/background browser panels never mount a real iframe —
			   a live cross-origin embed (rendr.app, humrashid.com, etc.) being
			   torn down and recreated every time a slot recycles to a new
			   column was forcing a real network fetch mid-scroll, which is
			   what read as a "hard reset" flash. Only the one slot that's
			   actually centered (see `focused` in buildSurface) gets a real
			   iframe; every other occurrence gets this static fill instead. */
			.browser-body-placeholder {
				position: absolute;
				inset: 0;
				background: linear-gradient(135deg, #f2f2f0 0%, #fafafa 40%, #f2f2f0 100%);
			}
			.browser-visit {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(255, 255, 255, 0);
				opacity: 0;
				transition: opacity 200ms, background 200ms;
				text-decoration: none;
				pointer-events: none;
			}
			.browser-window:hover .browser-visit {
				opacity: 1;
				background: rgba(255, 255, 255, 0.55);
				pointer-events: auto;
			}
			.browser-visit-icon {
				width: 52px;
				height: 52px;
				border-radius: 999px;
				background: #111;
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
				transform: scale(0.85);
				transition: transform 200ms;
			}
			.browser-window:hover .browser-visit-icon {
				transform: scale(1);
			}

			/* ---- video: looping muted clip, same card shell as .k-card ---- */
			.k-video .panel-surface {
				display: flex;
				pointer-events: auto;
			}
			.video-media {
				flex: 1;
				border-radius: 12px;
				overflow: hidden;
				position: relative;
				background: #000;
			}
			.video-media video {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.video-media-placeholder {
				position: absolute;
				inset: 0;
				background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 60%, #1a1a1a 100%);
			}
			/* ---- photo: polaroid-style frame + camera metadata caption ---- */
			.k-photo .panel-surface {
				background: #fff;
				border-radius: 4px;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
				padding: 14px 14px 0;
				display: flex;
				flex-direction: column;
			}
			.photo-image {
				flex: 1;
				border-radius: 2px;
			}
			.photo-caption {
				padding: 12px 4px 16px;
			}
			.photo-meta-camera {
				font-size: 12px;
				color: #666;
				font-weight: 500;
			}
			.photo-meta-line {
				font-size: 11px;
				color: #aaa;
				margin-top: 2px;
			}

			/* ---- portrait: plain photo, no treatment ---- */
			.k-portrait .panel-surface {
				border-radius: 16px;
				overflow: hidden;
				background: #f4f2ec;
				box-shadow: 0 14px 34px rgba(0, 0, 0, 0.14);
			}
			.portrait-img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.coord {
				position: absolute;
				bottom: 6px;
				right: 8px;
				font-size: 9px;
				color: #ccc;
				z-index: 5;
			}

			/* edge affordance arrows */
			.edge-arrow {
				position: fixed;
				z-index: 30;
				background: none;
				border: none;
				cursor: pointer;
				color: #999;
				padding: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: opacity 150ms;
			}
			.edge-arrow:hover {
				color: #111;
			}
			.edge-arrow svg {
				width: 22px;
				height: 22px;
			}
			#arrow-up {
				top: 18px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-down {
				bottom: 96px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-left {
				left: 18px;
				top: 50%;
				transform: translateY(-50%);
			}
			#arrow-right {
				right: 18px;
				top: 50%;
				transform: translateY(-50%);
			}

			/* floating nav pill, Mobbin-style, fixed bottom center */
			#nav {
				position: fixed;
				bottom: 28px;
				left: 50%;
				transform: translateX(-50%);
				z-index: 40;
				display: flex;
				align-items: center;
				gap: 4px;
				padding: 8px;
				background: rgba(255, 255, 255, 0.94);
				backdrop-filter: blur(22px) saturate(180%);
				-webkit-backdrop-filter: blur(22px) saturate(180%);
				border: 1px solid rgba(255, 255, 255, 0.92);
				border-radius: 999px;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.8);
			}
			#nav button.dot {
				width: 42px;
				height: 42px;
				border-radius: 999px;
				border: none;
				background: none; /* the dots themselves form the circle now */
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 0;
			}

			/* logo mark: a real circle — an 11x11 grid (see logoDots in the
			   frontmatter) with any cell past LOGO_RADIUS from center hidden
			   via visibility (not display, so the grid tracks/alignment stay
			   put), tapering each row's length near the top/bottom. Straight
			   rows and columns throughout, not a spiral. */
			.logo-mark {
				display: grid;
				grid-template-columns: repeat(11, 2.2px);
				grid-template-rows: repeat(11, 2.2px);
				gap: 0.75px;
			}
			.logo-mark .px {
				width: 2.2px;
				height: 2.2px;
				border-radius: 999px;
				background: #d5d5d1;
				animation: dot-enter 480ms ease-out both;
			}
			.logo-mark .px.is-hidden {
				visibility: hidden;
			}
			.logo-mark .px.is-letter {
				animation:
					dot-enter 480ms ease-out both,
					dot-shimmer 5s linear infinite;
			}
			@keyframes dot-enter {
				from {
					opacity: 0;
					transform: scale(0.3);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}
			@keyframes dot-shimmer {
				0% {
					background: rgb(150, 130, 210);
				}
				20% {
					background: rgb(120, 190, 200);
				}
				40% {
					background: rgb(200, 190, 130);
				}
				60% {
					background: rgb(210, 140, 180);
				}
				80% {
					background: rgb(130, 170, 220);
				}
				100% {
					background: rgb(150, 130, 210);
				}
			}
			#nav a {
				padding: 8px 16px;
				border-radius: 999px;
				text-decoration: none;
				color: #333;
				font-size: 14px;
				transition: background 120ms;
			}
			#nav a:hover {
				background: #f0f0f0;
			}
			#nav a.flash {
				background: #111;
				color: #fff;
			}

			#hint {
				position: fixed;
				top: 18px;
				left: 18px;
				font-size: 11px;
				color: #bbb;
				z-index: 30;
				max-width: 230px;
				line-height: 1.5;
			}

			/* case-study modal: the real page, loaded in place, scrollable like
			   any normal page — not a re-summarized preview */
			#case-modal {
				position: fixed;
				inset: 0;
				z-index: 1000;
				display: none;
				align-items: center;
				justify-content: center;
				background: rgba(20, 20, 20, 0.45);
				backdrop-filter: blur(8px);
			}
			#case-modal.open {
				display: flex;
			}
			#case-modal .modal-panel {
				position: relative;
				width: min(1120px, 92vw);
				height: min(840px, 88vh);
				background: #fff;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 40px 120px rgba(0, 0, 0, 0.4);
			}
			#case-modal iframe {
				width: 100%;
				height: 100%;
				border: 0;
				display: block;
			}
			#minimap {
				position: fixed;
				bottom: 96px;
				right: 24px;
				z-index: 30;
				display: grid;
				grid-template-columns: repeat(6, 6px);
				grid-auto-rows: 6px;
				gap: 4px;
			}
			#minimap .cell {
				width: 6px;
				height: 6px;
				border-radius: 999px;
				background: #e5e5e5;
			}
			#minimap .cell.active {
				background: #111;
			}
		</style>
	</head>
	<body>
		<svg width="0" height="0" style="position: absolute">
			<defs>
				<radialGradient id="bgloss" cx="35%" cy="30%" r="75%">
					<stop offset="0%" stop-color="#fff" stop-opacity="0.55" />
					<stop offset="45%" stop-color="#fff" stop-opacity="0" />
				</radialGradient>
			</defs>
		</svg>

		<div id="hint">
			drag / scroll / swipe to look around · arrow keys work too<br />
			loops forever both ways · flows freely, with just a hint of resistance passing center
		</div>

		<div id="stage">
			<div id="field"></div>
		</div>

		<button class="edge-arrow" id="arrow-up" aria-label="pan up">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 19V5M5 12l7-7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-down" aria-label="pan down">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 5v14M5 12l7 7 7-7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-left" aria-label="pan left">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M19 12H5M12 5l-7 7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-right" aria-label="pan right">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M5 12h14M12 5l7 7-7 7" /></svg
			>
		</button>

		<div id="minimap"></div>

		<nav id="nav">
			<button class="dot" id="nav-home" title="recenter">
				<span class="logo-mark" aria-label="Humayun Rashid, home">
					{logoDots.map((d) => (
						<span
							class={`px${d.isLetter ? ' is-letter' : ''}${d.visible ? '' : ' is-hidden'}`}
							style={`animation-delay:${d.delayMs}ms`}
						/>
					))}
				</span>
			</button>
			<a href="#" id="nav-work">Work</a>
			<a href="#" data-stub="/ideas">Ideas</a>
			<a href="#" id="nav-principles">Principles</a>
			<a href="#" id="nav-about">About</a>
		</nav>

		<div id="case-modal">
			<div class="modal-panel">
				<iframe id="modal-iframe" src="about:blank" title="Case study"></iframe>
			</div>
		</div>

		<script>
			// ---- content model -------------------------------------------------
			// A torus: both axes loop forever. Row 0 / col 0 is "home". Every
			// item now carries its own kind + size — panels are no longer
			// uniform, they vary by what they're showing.
			const COLS = 6;
			const ROWS = 3;

			type Sized = { w: number; h: number };
			type HomeItem = Sized & { kind: 'home'; title: string };
			type CardItem = Sized & {
				kind: 'card';
				tag: string;
				title: string;
				subtitle: string;
				seed: string;
				image?: string; // real asset path — overrides the Picsum placeholder
				link?: string; // real page URL — adds the hover-to-visit arrow
			};
			type BrowserItem = Sized & {
				kind: 'browser';
				url: string;
				display: string;
				title?: string;
				subtitle?: string;
				year?: string;
			};
			type PhotoItem = Sized & { kind: 'photo'; tone: string; camera: string; meta: string; src?: string };
			type VideoItem = Sized & { kind: 'video'; title: string; subtitle: string; src?: string };
			type PortraitItem = Sized & { kind: 'portrait'; src: string };
			type Item = HomeItem | CardItem | BrowserItem | PhotoItem | VideoItem | PortraitItem;

			const SM: Sized = { w: 280, h: 220 };
			const MD: Sized = { w: 380, h: 300 };
			const LG: Sized = { w: 520, h: 380 };
			const CASE_STUDY: Sized = { w: 650, h: 513 }; // ~37% bigger than MD, then +25% more per feedback
			const HOME: Sized = { w: 980, h: 460 }; // roomy — this text has no box, needs space
			const BROWSER: Sized = { w: 784, h: 532 }; // 40% larger than the other kinds
			const PHOTO: Sized = { w: 300, h: 400 };
			const VIDEO: Sized = { w: 420, h: 320 };
			const PORTRAIT: Sized = { w: 360, h: 500 };

			// a couple of small, freely-embeddable public sample clips (CC0/MDN
			// demo assets) — stand-ins to test the video-panel format, not final
			// content
			const CLIP_A = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4';
			const CLIP_B = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/friday.mp4';
			// real b-roll from the Nessa site — a looping cab shot
			const CLIP_NESSA_CAB = 'https://cdn.prod.website-files.com/6284f50b95ff173d79dff367/62fffc164bf9875964f162d3_Nessa%20-%20Cab-transcode.mp4';

			// NYC landmarks, standard emoji glyphs (renders as Apple's style on
			// macOS/iOS automatically). No dedicated emoji exists yet for a
			// pigeon specifically, the Empire State Building, a MetroCard, or
			// the classic blue Greek diner cup — closest standard stand-ins used
			// instead (generic bird, building, card, coffee cup).
			const NYC_EMOJIS = ['🚕', '🍎', '🗽', '🌭', '🐦', '🏢', '☕', '🥯', '💳'];

			function card(tag: string, title: string, subtitle: string, seed: string, size: Sized, image?: string): CardItem {
				return { kind: 'card', tag, title, subtitle, seed, image, ...size };
			}

			// Case studies always get the bigger CASE_STUDY size, real cover art,
			// and a link to the actual page (hover reveals a visit arrow) — this
			// is the default treatment for any real case study on the site.
			function caseStudy(title: string, subtitle: string, seed: string, image: string, link: string): CardItem {
				return { kind: 'card', tag: 'case study', title, subtitle, seed, image, link, ...CASE_STUDY };
			}

			// named so both the default grid and the "Work" rearrangement can
			// reference the exact same items
			const ITEM_SUBLIME = card(
				'case study',
				'Sublime Security',
				'Quarantine digests & phishing simulations for the fastest-growing email security startup in the US.',
				'sublime',
				MD
			); // no live page or cover art for this one yet — stays the generic treatment until both exist
			const ITEM_ATRIUM = card('case study', 'Atrium', 'A quiet home for books and articles worth remembering.', 'atrium', MD);
			const ITEM_PACK = caseStudy(
				'Pack',
				"Turning an agency's custom commerce builds into a scalable, merchant friendly SaaS platform.",
				'pack',
				'/case-studies/pack/01-hero-a.webp',
				'/work/pack'
			);
			const ITEM_INVETERATE = caseStudy(
				'Inveterate',
				'Taking a loyalty and membership platform from zero to one for eCommerce brands.',
				'inveterate',
				'/case-studies/inveterate/01-hero-desktop.webp',
				'/work/inveterate'
			);
			const ITEM_PPVP = caseStudy(
				'PPVP',
				'Designing an exclusive investment app for accredited investors.',
				'ppvp',
				'/case-studies/ppvp/01-hero-desktop.webp',
				'/work/ppvp'
			);
			const ITEM_RENDR: Item = {
				kind: 'browser',
				url: 'https://rendr.app',
				display: 'rendr.app',
				title: 'rendr',
				subtitle: 'Product design & build',
				year: '2024',
				...BROWSER,
			};
			const ITEM_HUMRASHID: Item = {
				kind: 'browser',
				url: 'https://www.humrashid.com',
				display: 'humrashid.com',
				title: 'humrashid.com',
				subtitle: 'This site — design & build',
				year: '2025',
				...BROWSER,
			};

			const rowsByIndex: Item[][] = [
				[
					{ kind: 'home', title: 'Humayun Rashid is a designer<br/>and founder in NYC', ...HOME },
					{ kind: 'portrait', src: '/concept/portrait.jpg', ...PORTRAIT },
					ITEM_RENDR,
					{ kind: 'photo', tone: '#d8d2c4', camera: 'Candid', meta: 'Nessa studio, NYC', src: '/concept/humayun-ux.jpg', ...PHOTO },
					ITEM_ATRIUM,
					ITEM_SUBLIME,
				],
				[
					card('about', 'About — the longer version', 'A decade of B2B SaaS and eCommerce design, and what I care about now.', 'about-me', LG),
					card('ideas', 'Ideas — writing & notes', 'Short essays on onboarding, empty states, and saying no.', 'ideas-notes', MD),
					{ kind: 'video', title: 'Nessa — Studio', subtitle: 'B-roll from a shoot around the city.', src: CLIP_NESSA_CAB, ...VIDEO },
					{ kind: 'photo', tone: '#c9d0c6', camera: 'Kodak Gold 200', meta: 'Prospect Park · Jun 2024', ...PHOTO },
					ITEM_HUMRASHID,
					card('writing', 'Principles', 'A running list of rules I design by.', 'principles', SM),
				],
				[
					{ kind: 'photo', tone: '#dcd6cf', camera: 'iPhone 15 Pro', meta: 'Lower Manhattan · Mar 2024', ...PHOTO },
					ITEM_PACK,
					ITEM_INVETERATE,
					{ kind: 'browser', url: 'https://example.com', display: 'example.com', ...BROWSER },
					card('link', 'dribbble ↗', 'Shots and works-in-progress.', 'dribbble', SM),
					ITEM_PPVP,
				],
			];

			// "Work" mode: every real case study plus the other live sites,
			// nothing else — cycles through a flat list instead of the usual
			// grid, with each row offset so it doesn't repeat in a straight
			// column.
			const WORK_ITEMS: Item[] = [ITEM_PACK, ITEM_INVETERATE, ITEM_PPVP, ITEM_SUBLIME, ITEM_ATRIUM, ITEM_RENDR, ITEM_HUMRASHID];
			let mode: 'default' | 'work' = 'default';

			function mod(n: number, m: number) {
				return ((n % m) + m) % m;
			}
			function hashCode(s: string): number {
				let h = 0;
				for (let i = 0; i < s.length; i++) h = (h << 5) - h + s.charCodeAt(i);
				return h;
			}
			function itemAt(col: number, row: number): Item {
				if (mode === 'work') {
					return WORK_ITEMS[mod(col + row * 2, WORK_ITEMS.length)];
				}
				return rowsByIndex[mod(row, ROWS)][mod(col, COLS)];
			}
			function safe(n: number): number {
				return Number.isFinite(n) ? n : 0;
			}
			function clamp(v: number, lo: number, hi: number) {
				return Math.min(hi, Math.max(lo, v));
			}

			// ---- true spherical placement -----------------------------------------
			// One panel centered at rest, with just its edge — not its bulk —
			// showing on each side as a "there's more this way" affordance.
			// Too tight and panels collide into a jumbled mess; too loose and
			// neighbors disappear entirely. This is the middle ground.
			const SPHERE_R = 1800; // px
			const DEG_PER_COL = 25; // longitude degrees between adjacent panel centers
			const DEG_PER_ROW = 21; // latitude degrees between adjacent panel centers
			// Work mode is every item at case-study/browser size, back to back —
			// packed at the default grid's spacing they visibly overlap, where
			// the default grid gets away with it by mixing in small/medium
			// panels between the big ones. Wider spacing just for this mode.
			const WORK_DEG_PER_COL = 36;
			const WORK_DEG_PER_ROW = 31;

			function sphereTransform(lonDeg: number, latDeg: number, extra = ''): string {
				const lon = (clamp(lonDeg, -85, 85) * Math.PI) / 180;
				const lat = (clamp(latDeg, -85, 85) * Math.PI) / 180;
				const x = SPHERE_R * Math.sin(lon) * Math.cos(lat);
				const y = SPHERE_R * Math.sin(lat);
				const z = SPHERE_R * (Math.cos(lon) * Math.cos(lat) - 1);
				// rotate so each panel's own surface normal points radially
				// outward from the sphere's center — the surface bulges toward
				// the viewer at the front pole and curves away at the edges,
				// like the front half of a globe, not a bowl caving inward.
				return `translate(-50%, -50%) translate3d(${x}px, ${y}px, ${z}px) rotateY(${lonDeg}deg) rotateX(${-latDeg}deg) ${extra}`;
			}

			// ---- state -----------------------------------------------------------
			let rawCol = 0;
			let rawRow = 0;
			let dragging = false;
			let startX = 0,
				startY = 0,
				startRawCol = 0,
				startRawRow = 0;
			let velX = 0,
				velY = 0,
				lastMoveT = 0,
				lastDx = 0,
				lastDy = 0;
			let animRAF: number | undefined;

			const DRAG_SENSITIVITY = 1 / 420;
			const WHEEL_SENSITIVITY = 1 / 900;

			// Only a light detent at each integer, not a hard lock — RESISTANCE_MIX
			// close to 0 would be pure free-flowing linear motion; keep it low so
			// you feel just the slightest hesitation passing a centered panel,
			// then it's back to plain, direct tracking.
			const RESISTANCE_MIX = 0.22;
			function easeInOutCubic(t: number): number {
				return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
			}
			function applyResistance(raw: number): number {
				const base = Math.floor(raw);
				const frac = raw - base;
				const eased = easeInOutCubic(frac);
				return base + frac + (eased - frac) * RESISTANCE_MIX;
			}

			const field = document.getElementById('field') as HTMLDivElement;
			const stage = document.getElementById('stage') as HTMLDivElement;

			// ---- case-study modal: loads the real page in place -------------------
			const caseModal = document.getElementById('case-modal') as HTMLDivElement;
			const modalIframe = document.getElementById('modal-iframe') as HTMLIFrameElement;
			function openCaseModal(url: string) {
				modalIframe.src = url;
				caseModal.classList.add('open');
			}
			function closeCaseModal() {
				caseModal.classList.remove('open');
				modalIframe.src = 'about:blank';
				animateRawTo(0, 0);
			}
			window.addEventListener('message', (e) => {
				if (e.origin === window.location.origin && e.data?.type === 'close-case-study') closeCaseModal();
			});
			caseModal.addEventListener('click', (e) => {
				if (e.target === caseModal) closeCaseModal();
			});
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && caseModal.classList.contains('open')) closeCaseModal();
			});

			// A cross of 9 panels is rendered: center, plus two neighbors deep
			// in each cardinal direction. The extra (second) ring is never
			// meant to be seen clearly — by the time a slot is recycled to a
			// new column/row at the edge of that ring gives extra off-screen
			// context around the focused panel, Ramp-style.
			type Slot = {
				wrap: HTMLDivElement;
				surface: HTMLDivElement;
				key: string;
				dc: number;
				dr: number;
				cleanup?: () => void; // stops a live effect (portrait canvas rAF/listeners) before content is replaced
			};
			const slots: Slot[] = [];
			function makeSlot(dc: number, dr: number): Slot {
				const wrap = document.createElement('div');
				wrap.className = 'panel-wrap';
				const surface = document.createElement('div');
				surface.className = 'panel-surface';
				wrap.appendChild(surface);
				field.appendChild(wrap);
				return { wrap, surface, key: '', dc, dr };
			}
			slots.push(
				makeSlot(-2, 0),
				makeSlot(-1, 0),
				makeSlot(0, 0),
				makeSlot(1, 0),
				makeSlot(2, 0),
				makeSlot(0, -2),
				makeSlot(0, -1),
				makeSlot(0, 1),
				makeSlot(0, 2)
			);

			function buildSurface(item: Item, focused: boolean): string {
				if (item.kind === 'home') {
					// "NYC" gets its own span: it's the word the boot animation
					// cycles through landmark emoji into, and the word that
					// swaps to a random one of those emoji on hover.
					const withNycSpan = item.title.replace(/NYC$/, '<span class="nyc-word">NYC</span>');
					return `<div class="home-label">${withNycSpan}</div>`;
				}
				if (item.kind === 'card') {
					// Always set a background — a plain <img>/background-image
					// request is cheap and cached by the browser once loaded, so
					// unlike the iframe/video fix below, gating this on `focused`
					// was wrong: it wasn't preventing a real reload, it was
					// actively hiding an already-cached image every time this
					// slot's DOM element wasn't the focused one, which produced
					// a *more* visible flash (image -> blank gray -> image again
					// as a card moved in and out of focus) than the thing it was
					// meant to fix.
					const bg = item.image ?? `https://picsum.photos/seed/${encodeURIComponent(item.seed)}/${item.w * 2}/${Math.round((item.h - 90) * 2)}`;
					const isCaseStudy = item.tag === 'case study' && !!item.image;
					const visitArrow = item.link
						? `<button class="card-visit" data-case-link="${item.link}">
								<span class="card-visit-icon">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M7 17L17 7M17 7H9M17 7V15" />
									</svg>
								</span>
							</button>`
						: '';
					return `
						<div class="card-media"${bg ? ` style="background-image:url('${bg}')"` : ''}>
							<span class="tag">${item.tag}</span>
							${visitArrow}
						</div>
						<div class="card-text${isCaseStudy ? ' is-case-study' : ''}">
							<div class="card-title">${item.title}</div>
							<div class="card-subtitle">${item.subtitle}</div>
						</div>`;
				}
				if (item.kind === 'video') {
					// same fix as the browser iframes/card placeholders — an
					// autoplaying <video src> is a real network fetch, so a
					// peripheral slot recycling past this item constantly
					// re-triggers it. Only load it once this slot is focused.
					// no caption — just the loop, edge to edge
					const src = item.src ?? (Math.abs(hashCode(item.title)) % 2 === 0 ? CLIP_A : CLIP_B);
					return `
						<div class="video-media">
							${focused ? `<video autoplay muted loop playsinline src="${src}"></video>` : `<div class="video-media-placeholder"></div>`}
						</div>`;
				}
				if (item.kind === 'browser') {
					const caption = item.title
						? `<div class="card-text">
								<div class="card-title">${item.title}</div>
								<div class="card-subtitle">${item.subtitle ?? ''}${item.subtitle && item.year ? ' · ' : ''}${item.year ?? ''}</div>
							</div>`
						: '';
					return `
						<div class="browser-window">
							<div class="browser-chrome">
								<div class="browser-dots">
									<svg viewBox="0 0 13 13"><circle cx="6.5" cy="6.5" r="6.5" fill="#ff5f57" /><circle cx="6.5" cy="6.5" r="6.5" fill="url(#bgloss)" /></svg>
									<svg viewBox="0 0 13 13"><circle cx="6.5" cy="6.5" r="6.5" fill="#febc2e" /><circle cx="6.5" cy="6.5" r="6.5" fill="url(#bgloss)" /></svg>
									<svg viewBox="0 0 13 13"><circle cx="6.5" cy="6.5" r="6.5" fill="#28c840" /><circle cx="6.5" cy="6.5" r="6.5" fill="url(#bgloss)" /></svg>
								</div>
								<div class="browser-tool-group">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="3" /><line x1="9" y1="5" x2="9" y2="19" /></svg>
									<span class="chevron-down"
										><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg
									></span>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" /></svg>
								</div>
								<div class="browser-url">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
									<span>${item.display}</span>
									<span class="browser-reload"
										><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" /></svg
									></span>
								</div>
								<div class="browser-tool-group">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v6m0 0l-2.5-2.5M12 14l2.5-2.5" /></svg>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V4M8 8l4-4 4 4" /><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" /></svg>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="8" height="8" rx="1.5" /><rect x="13" y="3" width="8" height="8" rx="1.5" /><rect x="3" y="13" width="8" height="8" rx="1.5" /><rect x="13" y="13" width="8" height="8" rx="1.5" /></svg>
								</div>
							</div>
							<div class="browser-body">
								${
									focused
										? `<iframe src="${item.url}" loading="lazy" referrerpolicy="no-referrer"></iframe>`
										: `<div class="browser-body-placeholder"></div>`
								}
								<a class="browser-visit" href="${item.url}" target="_blank" rel="noopener">
									<span class="browser-visit-icon">
										<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M7 17L17 7M17 7H9M17 7V15" />
										</svg>
									</span>
								</a>
							</div>
						</div>
						${caption}`;
				}
				if (item.kind === 'portrait') {
					return `<img class="portrait-img" src="${item.src}" alt="Humayun Rashid" />`;
				}
				// photo — a real src (same-origin asset) overrides the flat
				// tone color with the actual image, cover-fit
				const photoStyle = item.src
					? `background-image:url('${item.src}');background-size:cover;background-position:center`
					: `background:${item.tone}`;
				return `
					<div class="photo-image" style="${photoStyle}"></div>
					<div class="photo-caption">
						<div class="photo-meta-camera">${item.camera}</div>
						<div class="photo-meta-line">${item.meta}</div>
					</div>`;
			}

			function render() {
				// self-heal rather than cascade — a NaN here (there's no known
				// path to one, but the coast/animate loops don't individually
				// guard every write) would otherwise turn into `rowsByIndex[NaN]`
				// being undefined, throwing inside the loop below and, since
				// this runs inside a requestAnimationFrame callback, silently
				// killing that rAF loop mid-motion — which would freeze the
				// sphere until the next interaction, not just for that slot.
				rawCol = safe(rawCol);
				rawRow = safe(rawRow);
				const panCol = applyResistance(rawCol);
				const panRow = applyResistance(rawRow);
				const centerColInt = Math.round(panCol);
				const centerRowInt = Math.round(panRow);

				for (const slot of slots) {
					try {
					const c = centerColInt + slot.dc;
					const r = centerRowInt + slot.dr;
					const key = `${c},${r}`;
					const item = itemAt(c, r);
					if (slot.key !== key) {
						const isFirstAssignment = slot.key === '';
						slot.key = key;
						slot.cleanup?.(); // stop any live effect (portrait canvas rAF) before this slot's content is replaced
						slot.cleanup = undefined;
						const focused = slot.dc === 0 && slot.dr === 0;
						slot.surface.innerHTML = buildSurface(item, focused) + `<div class="coord">${c},${r}</div>`;
						slot.wrap.className = `panel-wrap k-${item.kind}`;
						slot.wrap.style.width = `${item.w}px`;
						slot.wrap.style.height = `${item.h}px`;
						// re-wire the NYC hover-swap every time home's markup is
						// rebuilt (innerHTML replace drops old listeners) — covers
						// both the first render and any later return to home
						if (item.kind === 'home') {
							const nycEl = slot.surface.querySelector<HTMLElement>('.nyc-word');
							nycEl?.addEventListener('mouseenter', () => {
								nycEl.textContent = NYC_EMOJIS[Math.floor(Math.random() * NYC_EMOJIS.length)];
							});
							nycEl?.addEventListener('mouseleave', () => {
								nycEl.textContent = 'NYC';
							});
						}
						// case-study visit arrow opens the real page in the modal
						// instead of navigating away from the sphere
						if (item.kind === 'card' && item.link) {
							const visitBtn = slot.surface.querySelector<HTMLButtonElement>('.card-visit');
							visitBtn?.addEventListener('click', (e) => {
								e.stopPropagation();
								openCaseModal(item.link!);
							});
						}
						// content is swapped instantly (no delayed timer — under fast
						// continuous scrolling a timer-based fade kept re-triggering
						// itself before finishing, which is what was reading as a
						// stark "reset"), then a quick CSS-driven flash softens the
						// pop. Restarting via remove/reflow/add so a slot that swaps
						// again before the flash finishes just restarts cleanly
						// instead of getting stuck. Skipped on a slot's very first
						// assignment (page load) — that flash (opacity 0.35 -> 1)
						// was fighting the boot sequence below, which explicitly
						// holds every surface at opacity 0 until it's ready to
						// reveal them in order; racing it made panels flash
						// visible immediately, then fade out, then fade in again
						// for real.
						if (!isFirstAssignment) {
							slot.surface.classList.remove('is-swapping');
							void slot.surface.offsetWidth;
							slot.surface.classList.add('is-swapping');
						}
					}

					const dCol = c - panCol;
					const dRow = r - panRow;
					const dist = Math.sqrt(dCol * dCol + dRow * dRow);
					// Vignette, not a global blur: panels stay fully sharp and
					// opaque through the whole middle of the field — only the
					// outer edge, right before a panel scrolls past the edge of
					// the viewport, softens and dims. DEPTH_START is how far off
					// dead-center a panel can be before that starts.
					const DEPTH_START = 0.75;
					const t = clamp(dist - DEPTH_START, 0, 10);
					const scale = clamp(1.08 - t * 0.32, 0.62, 1.08);
					const opacity = clamp(1 - t * 0.5, 0.3, 1);
					// Ramp-style depth of field: sharp through the middle,
					// softly gaussian-blurred only at the outer edge
					const blur = clamp(t * 7, 0, 6);
					const lon = dCol * (mode === 'work' ? WORK_DEG_PER_COL : DEG_PER_COL);
					const lat = dRow * (mode === 'work' ? WORK_DEG_PER_ROW : DEG_PER_ROW);

					slot.wrap.style.transform = sphereTransform(lon, lat, `scale(${scale})`);
					slot.wrap.style.opacity = String(opacity);
					// `filter: blur()` clips at the element's own box — on a card
					// or photo that edge is hidden by the panel's own background/
					// image, but "home" is bare text with nothing behind it, so
					// the blur's hard-clipped edge showed up as a faint rectangle
					// floating around the words while it panned off-center.
					slot.wrap.style.filter = blur > 0.05 && item.kind !== 'home' ? `blur(${blur.toFixed(1)}px)` : '';
					slot.wrap.style.zIndex = String(Math.round(2000 - dist * 10));

					// floating depth: very subtle — a hint of lift, not a heavy
					// drop shadow. The hover-to-visit affordance on browser
					// panels is untouched. Home is bare text — no shadow at all.
					// For card/video, the shadow belongs on the media block only
					// — the headline/subtext below must read as free-floating
					// text on the page, not part of a shared card silhouette.
					const lift = clamp(1 - dist, 0, 1);
					const shadow = `0 ${5 * lift + 2}px ${16 * lift + 5}px rgba(0,0,0,${0.03 + 0.05 * lift})`;
					if (item.kind === 'home') {
						slot.surface.style.boxShadow = 'none';
					} else if (item.kind === 'card' || item.kind === 'video') {
						slot.surface.style.boxShadow = 'none';
						const media = slot.surface.querySelector<HTMLElement>('.card-media, .video-media');
						if (media) media.style.boxShadow = shadow;
					} else {
						slot.surface.style.boxShadow = shadow;
					}
					} catch (err) {
						console.error('render() failed for one slot — skipping it instead of aborting the frame', err);
					}
				}
				renderMinimap(centerColInt, centerRowInt);
			}

			function renderMinimap(centerColInt: number, centerRowInt: number) {
				const mm = document.getElementById('minimap')!;
				mm.innerHTML = '';
				for (let r = 0; r < ROWS; r++) {
					for (let c = 0; c < COLS; c++) {
						const cell = document.createElement('div');
						cell.className = 'cell';
						if (mod(r, ROWS) === mod(centerRowInt, ROWS) && mod(c, COLS) === mod(centerColInt, COLS)) {
							cell.classList.add('active');
						}
						mm.appendChild(cell);
					}
				}
			}

			// ---- input: drag (mouse + touch via pointer events) -----------------
			// Listens on #stage, but panels are pointer-events:auto (so hover/
			// click work on browser panels) — pointerdown on a panel still
			// bubbles up to this handler since nothing stops propagation.
			//
			// Interactive controls (the case-study visit button, external
			// browser-panel links) are excluded from starting a drag at all:
			// setPointerCapture retargets the resulting click event to
			// whichever element captured the pointer, which silently ate
			// clicks on anything nested inside #stage — found by testing a
			// real mouse click on the case-study arrow, which JS-triggered
			// .click() calls during earlier testing had masked.
			stage.addEventListener('pointerdown', (e) => {
				if ((e.target as HTMLElement).closest('.card-visit, .browser-visit')) return;
				dragging = true;
				stage.classList.add('grabbing');
				stage.setPointerCapture(e.pointerId);
				startX = e.clientX;
				startY = e.clientY;
				startRawCol = rawCol;
				startRawRow = rawRow;
				velX = velY = 0;
				lastDx = lastDy = 0;
				lastMoveT = performance.now();
				cancelAnim();
			});

			stage.addEventListener('pointermove', (e) => {
				if (!dragging) return;
				const dx = e.clientX - startX;
				const dy = e.clientY - startY;
				const now = performance.now();
				const dt = Math.max(16, now - lastMoveT);
				velX = (dx - lastDx) / dt;
				velY = (dy - lastDy) / dt;
				lastDx = dx;
				lastDy = dy;
				lastMoveT = now;
				rawCol = safe(startRawCol - dx * DRAG_SENSITIVITY);
				rawRow = safe(startRawRow - dy * DRAG_SENSITIVITY);
				render();
			});

			function endDrag() {
				if (!dragging) return;
				dragging = false;
				stage.classList.remove('grabbing');
				const vCol = -velX * DRAG_SENSITIVITY;
				const vRow = -velY * DRAG_SENSITIVITY;
				startCoast(vCol, vRow);
			}
			stage.addEventListener('pointerup', endDrag);
			stage.addEventListener('pointercancel', endDrag);
			stage.addEventListener('pointerleave', () => {
				if (dragging) endDrag();
			});

			// ---- input: wheel / trackpad -----------------------------------------
			// Listens on window, not #stage: the edge-pan arrows, hint text, and
			// nav pill are fixed-position siblings of #stage, not children of
			// it — exactly where a vertical scroll gesture's cursor tends to
			// land (arrow-up/down sit dead center top/bottom). A wheel event
			// over any of them used to bubble straight past this handler with
			// nothing calling preventDefault, so the browser's own overscroll
			// gesture (Chrome's pull-to-refresh chief among them) took over —
			// the "hard reset / bright flash" that only ever showed up on
			// vertical scroll. Listening on window catches every wheel event
			// on the page regardless of what's directly under the cursor.
			window.addEventListener(
				'wheel',
				(e) => {
					if (caseModal.classList.contains('open')) return; // let the modal's own content scroll normally
					e.preventDefault();
					cancelAnim();
					rawCol = safe(rawCol + e.deltaX * WHEEL_SENSITIVITY);
					rawRow = safe(rawRow + e.deltaY * WHEEL_SENSITIVITY);
					render();
				},
				{ passive: false }
			);

			// ---- free momentum coast on release — no forced snap ------------------
			// Dragging is direct 1:1 tracking (through the light detent above);
			// letting go just carries that motion on with friction until it
			// naturally comes to rest, wherever that is — it is not pulled to
			// the nearest panel. Keyboard/arrow controls still jump exactly one
			// panel via animateRawTo, since those are deliberate discrete actions.
			const FRICTION_PER_16MS = 0.9;
			function startCoast(vCol: number, vRow: number) {
				cancelAnim();
				let vC = clamp(vCol, -2.5, 2.5);
				let vR = clamp(vRow, -2.5, 2.5);
				let lastT = performance.now();
				function frame(now: number) {
					const dt = Math.min(48, now - lastT);
					lastT = now;
					rawCol = safe(rawCol + vC * dt);
					rawRow = safe(rawRow + vR * dt);
					const decay = Math.pow(FRICTION_PER_16MS, dt / 16.67);
					vC *= decay;
					vR *= decay;
					render();
					if (Math.abs(vC) > 0.00005 || Math.abs(vR) > 0.00005) {
						animRAF = requestAnimationFrame(frame);
					} else {
						targetCol = Math.round(rawCol);
						targetRow = Math.round(rawRow);
						stepChaining = true;
						animRAF = undefined;
					}
				}
				animRAF = requestAnimationFrame(frame);
			}

			// ---- input: keyboard ---------------------------------------------------
			window.addEventListener('keydown', (e) => {
				const step: Record<string, [number, number]> = {
					ArrowLeft: [-1, 0],
					ArrowRight: [1, 0],
					ArrowUp: [0, -1],
					ArrowDown: [0, 1],
				};
				if (step[e.key]) {
					e.preventDefault();
					stepMove(...step[e.key]);
				}
			});

			// ---- edge arrow clicks ---------------------------------------------
			document.getElementById('arrow-up')!.addEventListener('click', () => stepMove(0, -1));
			document.getElementById('arrow-down')!.addEventListener('click', () => stepMove(0, 1));
			document.getElementById('arrow-left')!.addEventListener('click', () => stepMove(-1, 0));
			document.getElementById('arrow-right')!.addEventListener('click', () => stepMove(1, 0));
			document.getElementById('nav-home')!.addEventListener('click', () => animateRawTo(0, 0));

			// logo mark: same hover behavior as the real site's Topbar logo —
			// cells randomly flip between the shimmer ("letter") state and
			// plain gray on mousemove, at the same ~45% chance per cell
			const LOGO_LETTER_CHANCE = 0.45;
			const logoCells = document.querySelectorAll<HTMLElement>('.logo-mark .px:not(.is-hidden)');
			document.getElementById('nav-home')!.addEventListener('mousemove', () => {
				logoCells.forEach((cell) => {
					cell.classList.toggle('is-letter', Math.random() < LOGO_LETTER_CHANCE);
				});
			});

			// ---- "Work" nav: jumble the visible panels, then rearrange into a
			// work-only view (every case study + the other live sites). Clicking
			// again toggles back to the normal mixed field.
			document.getElementById('nav-work')!.addEventListener('click', (e) => {
				e.preventDefault();
				toggleWorkMode();
			});

			// ---- "About"/"Principles" nav: same case-study modal, pointed at
			// the real pages instead of a case study
			document.getElementById('nav-about')!.addEventListener('click', (e) => {
				e.preventDefault();
				openCaseModal('/about');
			});
			document.getElementById('nav-principles')!.addEventListener('click', (e) => {
				e.preventDefault();
				openCaseModal('/principles');
			});

			// Two straight, eased passes — panels slide off toward their own
			// corner of the field and back in, like cards being swept aside
			// and re-dealt onto a table. No rotation, no wobble: every panel
			// moves once, in one direction, and settles.
			function slidePanels(direction: 1 | -1, onDone: () => void) {
				const SLIDE_MS = 300;
				const STAGGER_MS = 26;
				const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
				const bases = slots.map((s) => s.wrap.style.transform);
				const baseOpacities = slots.map((s) => parseFloat(s.wrap.style.opacity || '1'));
				const delays = slots.map((s) => (Math.abs(s.dc) + Math.abs(s.dr)) * STAGGER_MS);
				const start = performance.now();
				function frame(now: number) {
					let allDone = true;
					for (let i = 0; i < slots.length; i++) {
						const localT = clamp((now - start - delays[i]) / SLIDE_MS, 0, 1);
						if (localT < 1) allDone = false;
						const eased = easeOutCubic(localT);
						// direction 1 (out): amount grows 0 -> 1. direction -1 (in): amount shrinks 1 -> 0.
						const amount = direction === 1 ? eased : 1 - eased;
						const dx = slots[i].dc * 34 * amount;
						const dy = 70 * amount + slots[i].dr * 20 * amount;
						slots[i].wrap.style.transform = `${bases[i]} translate(${dx}px, ${dy}px)`;
						slots[i].wrap.style.opacity = String(baseOpacities[i] * (1 - 0.7 * amount));
					}
					if (!allDone) {
						requestAnimationFrame(frame);
					} else {
						onDone();
					}
				}
				requestAnimationFrame(frame);
			}

			function toggleWorkMode() {
				cancelAnim();
				slidePanels(1, () => {
					mode = mode === 'work' ? 'default' : 'work';
					rawCol = 0;
					rawRow = 0;
					stepChaining = false;
					for (const s of slots) s.key = '';
					render();
					slidePanels(-1, render);
				});
			}

			let stepChaining = false;
			let targetCol = 0;
			let targetRow = 0;

			function stepMove(dc: number, dr: number) {
				const baseCol = stepChaining ? targetCol : Math.round(rawCol);
				const baseRow = stepChaining ? targetRow : Math.round(rawRow);
				animateRawTo(baseCol + dc, baseRow + dr);
				stepChaining = true;
			}

			function cancelAnim() {
				if (animRAF) cancelAnimationFrame(animRAF);
				animRAF = undefined;
			}

			function animateRawTo(nextCol: number, nextRow: number) {
				cancelAnim();
				stepChaining = true;
				targetCol = nextCol;
				targetRow = nextRow;
				const fromCol = rawCol;
				const fromRow = rawRow;
				const dCol = nextCol - fromCol;
				const dRow = nextRow - fromRow;
				const duration = 320;
				const start = performance.now();
				function tick(now: number) {
					const t = clamp((now - start) / duration, 0, 1);
					const eased = 1 - Math.pow(1 - t, 3);
					rawCol = fromCol + dCol * eased;
					rawRow = fromRow + dRow * eased;
					render();
					if (t < 1) {
						animRAF = requestAnimationFrame(tick);
					} else {
						rawCol = nextCol;
						rawRow = nextRow;
						render();
						animRAF = undefined;
					}
				}
				animRAF = requestAnimationFrame(tick);
			}

			// ---- nav pill stub links --------------------------------------------
			document.querySelectorAll('#nav a[data-stub]').forEach((a) => {
				a.addEventListener('click', (e) => {
					e.preventDefault();
					a.classList.add('flash');
					setTimeout(() => a.classList.remove('flash'), 250);
					console.log(`stub nav → ${(a as HTMLElement).dataset.stub}`);
				});
			});

			// ---- boot sequence: blank -> home text fades in -> neighbors fade in ---
			// A one-time reveal on first load, not something that replays every
			// time you navigate back to home. Position everything immediately
			// (so transforms/sizes are correct from frame one), but hold every
			// panel's own surface at opacity 0 and fade them in on a timer —
			// independent of the per-frame distance-based opacity that
			// panel-wrap already handles, so dragging mid-intro can't conflict
			// with it.
			for (const slot of slots) slot.surface.style.opacity = '0';
			render();

			const homeSlot = slots.find((s) => s.dc === 0 && s.dr === 0)!;
			const neighborSlots = slots.filter((s) => s !== homeSlot);

			function fadeOpacity(els: HTMLDivElement[], duration: number, onDone?: () => void) {
				const start = performance.now();
				function frame(now: number) {
					const t = clamp((now - start) / duration, 0, 1);
					for (const el of els) el.style.opacity = String(t);
					if (t < 1) {
						requestAnimationFrame(frame);
					} else {
						for (const el of els) el.style.opacity = '';
						onDone?.();
					}
				}
				requestAnimationFrame(frame);
			}

			// Home's own reveal: the surface itself is visible immediately (it
			// has no box, nothing to hide), and the label rises up from below
			// while fading in — slow, so it reads as a deliberate entrance, not
			// a quick fade. The "NYC" word runs through a quick reel of NYC
			// landmark emoji alongside it, landing on the real word right as
			// the reveal finishes.
			homeSlot.surface.style.opacity = '1';
			const homeLabel = homeSlot.surface.querySelector<HTMLElement>('.home-label');
			const nycWord = homeSlot.surface.querySelector<HTMLElement>('.nyc-word');
			const REVEAL_MS = 1700;

			function revealHomeLabel(onDone: () => void) {
				if (!homeLabel) {
					onDone();
					return;
				}
				homeLabel.style.opacity = '0';
				homeLabel.style.transform = 'translateY(44px)';
				const start = performance.now();
				function frame(now: number) {
					const t = clamp((now - start) / REVEAL_MS, 0, 1);
					const eased = 1 - Math.pow(1 - t, 3);
					homeLabel!.style.opacity = String(eased);
					homeLabel!.style.transform = `translateY(${(1 - eased) * 44}px)`;
					if (t < 1) {
						requestAnimationFrame(frame);
					} else {
						homeLabel!.style.opacity = '';
						homeLabel!.style.transform = '';
						onDone();
					}
				}
				requestAnimationFrame(frame);
			}

			if (nycWord) {
				const frameMs = Math.round((REVEAL_MS * 0.7) / NYC_EMOJIS.length);
				let i = 0;
				function cycle() {
					if (i < NYC_EMOJIS.length) {
						nycWord!.textContent = NYC_EMOJIS[i];
						i++;
						setTimeout(cycle, frameMs);
					} else {
						nycWord!.textContent = 'NYC';
					}
				}
				cycle();
			}

			revealHomeLabel(() => {
				fadeOpacity(
					neighborSlots.map((s) => s.surface),
					650
				);
			});
		</script>
	</body>
</html>
