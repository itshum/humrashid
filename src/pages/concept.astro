---
// Low-fidelity prototype: sphere/orbit navigation mechanic.
// Testing real content formats now: a Safari-style browser panel (live
// iframe + hover-to-visit), a Mobbin-style card (media block + headline +
// subtext), and a Polaroid-style photo panel with camera metadata. Panels
// vary in size by content kind. Positioning is still a true sphere
// (longitude/latitude per panel), with resistance-then-hard-lock dragging
// and an infinite loop on both axes.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>concept — orbit nav</title>
		<meta name="robots" content="noindex" />
		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				overflow: hidden;
				background: #fff;
				font-family: system-ui, -apple-system, sans-serif;
				color: #111;
				touch-action: none;
				user-select: none;
				-webkit-user-select: none;
			}

			#stage {
				position: fixed;
				inset: 0;
				perspective: 1600px;
				perspective-origin: 50% 50%;
				cursor: grab;
			}
			#stage.grabbing {
				cursor: grabbing;
			}

			#field {
				position: absolute;
				inset: 0;
				transform-style: preserve-3d;
			}

			/* outer wrapper: JS-controlled sphere position/rotation/scale only */
			.panel-wrap {
				position: absolute;
				top: 50%;
				left: 50%;
				will-change: transform, opacity;
			}

			/* inner surface: carries the idle float + shadow, composes with the
			   outer transform instead of fighting it for the same property */
			.panel-surface {
				width: 100%;
				height: 100%;
				border-radius: 14px;
				animation: floaty 6s ease-in-out infinite;
				transition: box-shadow 300ms ease;
			}
			@keyframes floaty {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-8px);
				}
			}

			/* ---- home: just the text, no card/box around it ---- */
			.k-home .panel-surface {
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 24px;
				border-radius: 0;
			}
			.k-home .home-label {
				font-size: clamp(28px, 4.2vw, 64px); /* 30% down from clamp(40,6vw,92) */
				color: #111;
				font-weight: 500;
				line-height: 1.15;
				letter-spacing: -0.01em;
				display: inline-block; /* own box for the bottom-to-top reveal transform */
			}
			.nyc-word {
				display: inline-block;
				cursor: pointer;
			}

			/* ---- card: Mobbin-style — media block, then headline + subtext below ---- */
			.k-card .panel-surface {
				display: flex;
				flex-direction: column;
				gap: 14px;
				pointer-events: auto;
			}
			.card-media {
				flex: 1;
				border-radius: 12px;
				background: #ececec;
				background-size: cover;
				background-position: center;
				position: relative;
			}
			.card-media .tag {
				position: absolute;
				top: 10px;
				left: 10px;
				background: rgba(0, 0, 0, 0.55);
				color: #fff;
				font-size: 10px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 3px 9px;
				border-radius: 999px;
			}
			/* hover-to-visit arrow, real case studies only (item.link set) —
			   same treatment as the browser panel's visit affordance */
			.card-visit {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 12px;
				background: rgba(255, 255, 255, 0);
				opacity: 0;
				transition: opacity 200ms, background 200ms;
				text-decoration: none;
				border: none;
				padding: 0;
				cursor: pointer;
				font: inherit;
			}
			.card-media:hover .card-visit {
				opacity: 1;
				background: rgba(255, 255, 255, 0.35);
			}
			.card-visit-icon {
				width: 52px;
				height: 52px;
				border-radius: 999px;
				background: #111;
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
				transform: scale(0.85);
				transition: transform 200ms;
			}
			.card-media:hover .card-visit-icon {
				transform: scale(1);
			}
			.card-text {
				padding: 0 2px;
			}
			.card-title {
				font-size: 17px;
				font-weight: 600;
				color: #111;
				margin-bottom: 4px;
			}
			.card-subtitle {
				font-size: 13px;
				color: #999;
				line-height: 1.4;
			}
			/* case studies are bigger by default (CASE_STUDY size) — scale the
			   text to match instead of leaving it at the generic-card size */
			.card-text.is-case-study .card-title {
				font-size: 23px;
				margin-bottom: 6px;
			}
			.card-text.is-case-study .card-subtitle {
				font-size: 16px;
			}

			/* ---- browser: Safari chrome + live iframe + hover-to-visit ---- */
			.k-browser .panel-surface {
				display: flex;
				flex-direction: column;
				background: #fff;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid #dcdcdc;
				box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6);
				pointer-events: auto;
			}
			.browser-chrome {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 12px 14px;
				background: linear-gradient(#f8f8f8, #ececec);
				border-bottom: 1px solid #d8d8d8;
			}
			.browser-dots {
				display: flex;
				gap: 8px;
				flex-shrink: 0;
			}
			.browser-dots svg {
				width: 13px;
				height: 13px;
				display: block;
			}
			.browser-nav-icons {
				display: flex;
				gap: 10px;
				flex-shrink: 0;
				color: #b0b0b0;
			}
			.browser-nav-icons svg {
				width: 15px;
				height: 15px;
				display: block;
			}
			.browser-url {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 6px;
				background: #fff;
				border: 1px solid #e2e2e2;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
				border-radius: 7px;
				padding: 5px 10px;
				font-size: 12px;
				color: #6b6b6b;
				min-width: 0;
			}
			.browser-url svg {
				width: 11px;
				height: 11px;
				flex-shrink: 0;
				color: #9a9a9a;
			}
			.browser-url span {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.browser-body {
				position: relative;
				flex: 1;
				background: #fafafa;
			}
			.browser-body iframe {
				width: 100%;
				height: 100%;
				border: 0;
				display: block;
				pointer-events: none; /* the iframe never steals the drag */
			}
			.browser-visit {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(255, 255, 255, 0);
				opacity: 0;
				transition: opacity 200ms, background 200ms;
				text-decoration: none;
				pointer-events: none;
			}
			.k-browser .panel-surface:hover .browser-visit {
				opacity: 1;
				background: rgba(255, 255, 255, 0.55);
				pointer-events: auto;
			}
			.browser-visit-icon {
				width: 52px;
				height: 52px;
				border-radius: 999px;
				background: #111;
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
				transform: scale(0.85);
				transition: transform 200ms;
			}
			.k-browser .panel-surface:hover .browser-visit-icon {
				transform: scale(1);
			}

			/* ---- video: looping muted clip, same card shell as .k-card ---- */
			.k-video .panel-surface {
				display: flex;
				flex-direction: column;
				gap: 14px;
				pointer-events: auto;
			}
			.video-media {
				flex: 1;
				border-radius: 12px;
				overflow: hidden;
				position: relative;
				background: #000;
			}
			.video-media video {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.video-badge {
				position: absolute;
				top: 10px;
				left: 10px;
				background: rgba(0, 0, 0, 0.55);
				color: #fff;
				font-size: 10px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 3px 9px;
				border-radius: 999px;
			}

			/* ---- photo: polaroid-style frame + camera metadata caption ---- */
			.k-photo .panel-surface {
				background: #fff;
				border-radius: 4px;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
				padding: 14px 14px 0;
				display: flex;
				flex-direction: column;
			}
			.photo-image {
				flex: 1;
				border-radius: 2px;
			}
			.photo-caption {
				padding: 12px 4px 16px;
			}
			.photo-meta-camera {
				font-size: 12px;
				color: #666;
				font-weight: 500;
			}
			.photo-meta-line {
				font-size: 11px;
				color: #aaa;
				margin-top: 2px;
			}

			/* ---- portrait: cursor-interactive treatment, one of 6 picked at
			   random per page load ---- */
			.k-portrait .panel-surface {
				border-radius: 16px;
				overflow: hidden;
				background: #f4f2ec;
				box-shadow: 0 14px 34px rgba(0, 0, 0, 0.14);
				pointer-events: auto;
			}
			.portrait-stage {
				position: relative;
				width: 100%;
				height: 100%;
			}
			.portrait-canvas {
				display: block;
				cursor: crosshair;
			}
			.portrait-img,
			.portrait-svg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
			}
			.portrait-img {
				object-fit: cover;
			}
			.portrait-svg path,
			.portrait-svg circle,
			.portrait-svg line {
				fill: none;
				stroke: #111;
				stroke-width: 4;
				stroke-linecap: round;
				stroke-linejoin: round;
			}
			.portrait-svg .crown {
				stroke: #d4af37;
				stroke-width: 5;
			}

			.coord {
				position: absolute;
				bottom: 6px;
				right: 8px;
				font-size: 9px;
				color: #ccc;
				z-index: 5;
			}

			/* edge affordance arrows */
			.edge-arrow {
				position: fixed;
				z-index: 30;
				background: none;
				border: none;
				cursor: pointer;
				color: #999;
				padding: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: opacity 150ms;
			}
			.edge-arrow:hover {
				color: #111;
			}
			.edge-arrow svg {
				width: 22px;
				height: 22px;
			}
			#arrow-up {
				top: 18px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-down {
				bottom: 96px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-left {
				left: 18px;
				top: 50%;
				transform: translateY(-50%);
			}
			#arrow-right {
				right: 18px;
				top: 50%;
				transform: translateY(-50%);
			}

			/* floating nav pill, Mobbin-style, fixed bottom center */
			#nav {
				position: fixed;
				bottom: 28px;
				left: 50%;
				transform: translateX(-50%);
				z-index: 40;
				display: flex;
				align-items: center;
				gap: 4px;
				padding: 8px;
				background: rgba(255, 255, 255, 0.55);
				backdrop-filter: blur(22px) saturate(180%);
				-webkit-backdrop-filter: blur(22px) saturate(180%);
				border: 1px solid rgba(255, 255, 255, 0.7);
				border-radius: 999px;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.6);
			}
			#nav button.dot {
				width: 42px;
				height: 42px;
				border-radius: 999px;
				border: none;
				background: none; /* the dots themselves form the circle now */
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 0;
			}

			/* logo mark: same idea as the real site's pixel-grid logo (a grid of
			   cells encoding "Hr"), rebuilt as an actual filled disc of dots —
			   a 5x5 grid with the 4 corners hidden (visibility, not display, so
			   the grid tracks stay put) reads as a circle, not a clipped square */
			.logo-mark {
				display: grid;
				grid-template-columns: repeat(5, 4.4px);
				grid-template-rows: repeat(5, 4.4px);
				gap: 2.2px;
			}
			.logo-mark .px {
				width: 4.4px;
				height: 4.4px;
				border-radius: 999px;
				background: #d5d5d1;
				animation: dot-enter 480ms ease-out both;
			}
			.logo-mark .px.is-corner {
				visibility: hidden;
			}
			.logo-mark .px.is-letter {
				animation:
					dot-enter 480ms ease-out both,
					dot-shimmer 5s linear infinite;
			}
			@keyframes dot-enter {
				from {
					opacity: 0;
					transform: scale(0.3);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}
			@keyframes dot-shimmer {
				0% {
					background: rgb(150, 130, 210);
				}
				20% {
					background: rgb(120, 190, 200);
				}
				40% {
					background: rgb(200, 190, 130);
				}
				60% {
					background: rgb(210, 140, 180);
				}
				80% {
					background: rgb(130, 170, 220);
				}
				100% {
					background: rgb(150, 130, 210);
				}
			}
			#nav a {
				padding: 8px 16px;
				border-radius: 999px;
				text-decoration: none;
				color: #333;
				font-size: 14px;
				transition: background 120ms;
			}
			#nav a:hover {
				background: #f0f0f0;
			}
			#nav a.flash {
				background: #111;
				color: #fff;
			}

			#hint {
				position: fixed;
				top: 18px;
				left: 18px;
				font-size: 11px;
				color: #bbb;
				z-index: 30;
				max-width: 230px;
				line-height: 1.5;
			}

			/* case-study modal: the real page, loaded in place, scrollable like
			   any normal page — not a re-summarized preview */
			#case-modal {
				position: fixed;
				inset: 0;
				z-index: 1000;
				display: none;
				align-items: center;
				justify-content: center;
				background: rgba(20, 20, 20, 0.45);
				backdrop-filter: blur(8px);
			}
			#case-modal.open {
				display: flex;
			}
			#case-modal .modal-panel {
				position: relative;
				width: min(1120px, 92vw);
				height: min(840px, 88vh);
				background: #fff;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 40px 120px rgba(0, 0, 0, 0.4);
			}
			#case-modal iframe {
				width: 100%;
				height: 100%;
				border: 0;
				display: block;
			}
			#case-modal .modal-close {
				position: absolute;
				top: -22px;
				right: -22px;
				width: 56px;
				height: 56px;
				border-radius: 999px;
				background: #fff;
				color: #111;
				border: 1px solid #eaeaea;
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
			}
			#case-modal .modal-close svg {
				width: 22px;
				height: 22px;
			}

			#minimap {
				position: fixed;
				bottom: 96px;
				right: 24px;
				z-index: 30;
				display: grid;
				grid-template-columns: repeat(6, 6px);
				grid-auto-rows: 6px;
				gap: 4px;
			}
			#minimap .cell {
				width: 6px;
				height: 6px;
				border-radius: 999px;
				background: #e5e5e5;
			}
			#minimap .cell.active {
				background: #111;
			}
		</style>
	</head>
	<body>
		<svg width="0" height="0" style="position: absolute">
			<defs>
				<radialGradient id="bgloss" cx="35%" cy="30%" r="75%">
					<stop offset="0%" stop-color="#fff" stop-opacity="0.55" />
					<stop offset="45%" stop-color="#fff" stop-opacity="0" />
				</radialGradient>
			</defs>
		</svg>

		<div id="hint">
			drag / scroll / swipe to look around · arrow keys work too<br />
			loops forever both ways · flows freely, with just a hint of resistance passing center
		</div>

		<div id="stage">
			<div id="field"></div>
		</div>

		<button class="edge-arrow" id="arrow-up" aria-label="pan up">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 19V5M5 12l7-7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-down" aria-label="pan down">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 5v14M5 12l7 7 7-7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-left" aria-label="pan left">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M19 12H5M12 5l-7 7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-right" aria-label="pan right">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M5 12h14M12 5l7 7-7 7" /></svg
			>
		</button>

		<div id="minimap"></div>

		<nav id="nav">
			<button class="dot" id="nav-home" title="recenter">
				<span class="logo-mark" aria-label="Humayun Rashid, home">
					<span class="px is-corner" style="animation-delay:0ms"></span><span class="px is-letter" style="animation-delay:0ms"></span><span class="px" style="animation-delay:0ms"></span><span class="px is-letter" style="animation-delay:0ms"></span><span class="px is-corner" style="animation-delay:0ms"></span>
					<span class="px is-letter" style="animation-delay:70ms"></span><span class="px" style="animation-delay:70ms"></span><span class="px is-letter" style="animation-delay:70ms"></span><span class="px" style="animation-delay:70ms"></span><span class="px is-letter" style="animation-delay:70ms"></span>
					<span class="px" style="animation-delay:140ms"></span><span class="px is-letter" style="animation-delay:140ms"></span><span class="px" style="animation-delay:140ms"></span><span class="px is-letter" style="animation-delay:140ms"></span><span class="px" style="animation-delay:140ms"></span>
					<span class="px is-letter" style="animation-delay:210ms"></span><span class="px" style="animation-delay:210ms"></span><span class="px is-letter" style="animation-delay:210ms"></span><span class="px" style="animation-delay:210ms"></span><span class="px is-letter" style="animation-delay:210ms"></span>
					<span class="px is-corner" style="animation-delay:280ms"></span><span class="px is-letter" style="animation-delay:280ms"></span><span class="px" style="animation-delay:280ms"></span><span class="px is-letter" style="animation-delay:280ms"></span><span class="px is-corner" style="animation-delay:280ms"></span>
				</span>
			</button>
			<a href="#" id="nav-work">Work</a>
			<a href="#" data-stub="/ideas">Ideas</a>
			<a href="#" data-stub="/about">About</a>
		</nav>

		<div id="case-modal">
			<div class="modal-panel">
				<button class="modal-close" id="modal-close" aria-label="Close">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
						><path d="M6 6l12 12M18 6L6 18" /></svg
					>
				</button>
				<iframe id="modal-iframe" src="about:blank" title="Case study"></iframe>
			</div>
		</div>

		<script>
			// ---- content model -------------------------------------------------
			// A torus: both axes loop forever. Row 0 / col 0 is "home". Every
			// item now carries its own kind + size — panels are no longer
			// uniform, they vary by what they're showing.
			const COLS = 6;
			const ROWS = 3;

			type Sized = { w: number; h: number };
			type HomeItem = Sized & { kind: 'home'; title: string };
			type CardItem = Sized & {
				kind: 'card';
				tag: string;
				title: string;
				subtitle: string;
				seed: string;
				image?: string; // real asset path — overrides the Picsum placeholder
				link?: string; // real page URL — adds the hover-to-visit arrow
			};
			type BrowserItem = Sized & { kind: 'browser'; url: string; display: string };
			type PhotoItem = Sized & { kind: 'photo'; tone: string; camera: string; meta: string };
			type VideoItem = Sized & { kind: 'video'; title: string; subtitle: string };
			type PortraitItem = Sized & { kind: 'portrait'; src: string };
			type Item = HomeItem | CardItem | BrowserItem | PhotoItem | VideoItem | PortraitItem;

			const SM: Sized = { w: 280, h: 220 };
			const MD: Sized = { w: 380, h: 300 };
			const LG: Sized = { w: 520, h: 380 };
			const CASE_STUDY: Sized = { w: 650, h: 513 }; // ~37% bigger than MD, then +25% more per feedback
			const HOME: Sized = { w: 980, h: 460 }; // roomy — this text has no box, needs space
			const BROWSER: Sized = { w: 784, h: 532 }; // 40% larger than the other kinds
			const PHOTO: Sized = { w: 300, h: 400 };
			const VIDEO: Sized = { w: 420, h: 320 };
			const PORTRAIT: Sized = { w: 360, h: 500 };

			// six cursor-interactive treatments of the portrait — one is picked
			// at random per page load, so a refresh gets a different style
			type PortraitStyle = 'pixelate' | 'basquiat' | 'warhol' | 'pointillism' | 'impressionist' | 'sketch';
			const PORTRAIT_STYLES: PortraitStyle[] = ['pixelate', 'basquiat', 'warhol', 'pointillism', 'impressionist', 'sketch'];
			const PORTRAIT_STYLE: PortraitStyle = PORTRAIT_STYLES[Math.floor(Math.random() * PORTRAIT_STYLES.length)];

			// a couple of small, freely-embeddable public sample clips (CC0/MDN
			// demo assets) — stand-ins to test the video-panel format, not final
			// content
			const CLIP_A = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4';
			const CLIP_B = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/friday.mp4';

			// NYC landmarks, standard emoji glyphs (renders as Apple's style on
			// macOS/iOS automatically). No dedicated emoji exists yet for a
			// pigeon specifically, the Empire State Building, a MetroCard, or
			// the classic blue Greek diner cup — closest standard stand-ins used
			// instead (generic bird, building, card, coffee cup).
			const NYC_EMOJIS = ['🚕', '🍎', '🗽', '🌭', '🐦', '🏢', '☕', '🥯', '💳'];

			function card(tag: string, title: string, subtitle: string, seed: string, size: Sized, image?: string): CardItem {
				return { kind: 'card', tag, title, subtitle, seed, image, ...size };
			}

			// Case studies always get the bigger CASE_STUDY size, real cover art,
			// and a link to the actual page (hover reveals a visit arrow) — this
			// is the default treatment for any real case study on the site.
			function caseStudy(title: string, subtitle: string, seed: string, image: string, link: string): CardItem {
				return { kind: 'card', tag: 'case study', title, subtitle, seed, image, link, ...CASE_STUDY };
			}

			// named so both the default grid and the "Work" rearrangement can
			// reference the exact same items
			const ITEM_SUBLIME = card(
				'case study',
				'Sublime Security',
				'Quarantine digests & phishing simulations for the fastest-growing email security startup in the US.',
				'sublime',
				MD
			); // no live page or cover art for this one yet — stays the generic treatment until both exist
			const ITEM_ATRIUM = card('case study', 'Atrium', 'A quiet home for books and articles worth remembering.', 'atrium', MD);
			const ITEM_PACK = caseStudy(
				'Pack',
				"Turning an agency's custom commerce builds into a scalable, merchant friendly SaaS platform.",
				'pack',
				'/case-studies/pack/01-hero-a.webp',
				'/work/pack'
			);
			const ITEM_INVETERATE = caseStudy(
				'Inveterate',
				'Taking a loyalty and membership platform from zero to one for eCommerce brands.',
				'inveterate',
				'/case-studies/inveterate/01-hero-desktop.webp',
				'/work/inveterate'
			);
			const ITEM_PPVP = caseStudy(
				'PPVP',
				'Designing an exclusive investment app for accredited investors.',
				'ppvp',
				'/case-studies/ppvp/01-hero-desktop.webp',
				'/work/ppvp'
			);
			const ITEM_RENDR: Item = { kind: 'browser', url: 'https://rendr.app', display: 'rendr.app', ...BROWSER };
			const ITEM_HUMRASHID: Item = { kind: 'browser', url: 'https://www.humrashid.com', display: 'humrashid.com', ...BROWSER };

			const rowsByIndex: Item[][] = [
				[
					{ kind: 'home', title: 'Humayun Rashid is a designer<br/>and founder in NYC', ...HOME },
					{ kind: 'portrait', src: '/concept/portrait.jpg', ...PORTRAIT },
					ITEM_RENDR,
					{ kind: 'photo', tone: '#d8d2c4', camera: 'Fujifilm X100V', meta: 'Brooklyn, NY · Sep 2024', ...PHOTO },
					ITEM_ATRIUM,
					ITEM_SUBLIME,
				],
				[
					card('about', 'About — the longer version', 'A decade of B2B SaaS and eCommerce design, and what I care about now.', 'about-me', LG),
					card('ideas', 'Ideas — writing & notes', 'Short essays on onboarding, empty states, and saying no.', 'ideas-notes', MD),
					{ kind: 'video', title: 'Talk — five users', subtitle: 'A clip from a workshop on user interviews.', ...VIDEO },
					{ kind: 'photo', tone: '#c9d0c6', camera: 'Kodak Gold 200', meta: 'Prospect Park · Jun 2024', ...PHOTO },
					ITEM_HUMRASHID,
					card('writing', 'Principles', 'A running list of rules I design by.', 'principles', SM),
				],
				[
					{ kind: 'photo', tone: '#dcd6cf', camera: 'iPhone 15 Pro', meta: 'Lower Manhattan · Mar 2024', ...PHOTO },
					ITEM_PACK,
					ITEM_INVETERATE,
					{ kind: 'browser', url: 'https://example.com', display: 'example.com', ...BROWSER },
					card('link', 'dribbble ↗', 'Shots and works-in-progress.', 'dribbble', SM),
					ITEM_PPVP,
				],
			];

			// "Work" mode: every real case study plus the other live sites,
			// nothing else — cycles through a flat list instead of the usual
			// grid, with each row offset so it doesn't repeat in a straight
			// column.
			const WORK_ITEMS: Item[] = [ITEM_PACK, ITEM_INVETERATE, ITEM_PPVP, ITEM_SUBLIME, ITEM_ATRIUM, ITEM_RENDR, ITEM_HUMRASHID];
			let mode: 'default' | 'work' = 'default';

			function mod(n: number, m: number) {
				return ((n % m) + m) % m;
			}
			function hashCode(s: string): number {
				let h = 0;
				for (let i = 0; i < s.length; i++) h = (h << 5) - h + s.charCodeAt(i);
				return h;
			}
			function itemAt(col: number, row: number): Item {
				if (mode === 'work') {
					return WORK_ITEMS[mod(col + row * 2, WORK_ITEMS.length)];
				}
				return rowsByIndex[mod(row, ROWS)][mod(col, COLS)];
			}
			function safe(n: number): number {
				return Number.isFinite(n) ? n : 0;
			}
			function clamp(v: number, lo: number, hi: number) {
				return Math.min(hi, Math.max(lo, v));
			}

			// ---- true spherical placement -----------------------------------------
			// One panel centered at rest, with just its edge — not its bulk —
			// showing on each side as a "there's more this way" affordance.
			// Too tight and panels collide into a jumbled mess; too loose and
			// neighbors disappear entirely. This is the middle ground.
			const SPHERE_R = 1800; // px
			const DEG_PER_COL = 25; // longitude degrees between adjacent panel centers
			const DEG_PER_ROW = 21; // latitude degrees between adjacent panel centers

			function sphereTransform(lonDeg: number, latDeg: number, extra = ''): string {
				const lon = (clamp(lonDeg, -85, 85) * Math.PI) / 180;
				const lat = (clamp(latDeg, -85, 85) * Math.PI) / 180;
				const x = SPHERE_R * Math.sin(lon) * Math.cos(lat);
				const y = SPHERE_R * Math.sin(lat);
				const z = SPHERE_R * (Math.cos(lon) * Math.cos(lat) - 1);
				// rotate so each panel's own surface normal points radially
				// outward from the sphere's center — the surface bulges toward
				// the viewer at the front pole and curves away at the edges,
				// like the front half of a globe, not a bowl caving inward.
				return `translate(-50%, -50%) translate3d(${x}px, ${y}px, ${z}px) rotateY(${lonDeg}deg) rotateX(${-latDeg}deg) ${extra}`;
			}

			// ---- state -----------------------------------------------------------
			let rawCol = 0;
			let rawRow = 0;
			let dragging = false;
			let startX = 0,
				startY = 0,
				startRawCol = 0,
				startRawRow = 0;
			let velX = 0,
				velY = 0,
				lastMoveT = 0,
				lastDx = 0,
				lastDy = 0;
			let animRAF: number | undefined;

			const DRAG_SENSITIVITY = 1 / 420;
			const WHEEL_SENSITIVITY = 1 / 900;

			// Only a light detent at each integer, not a hard lock — RESISTANCE_MIX
			// close to 0 would be pure free-flowing linear motion; keep it low so
			// you feel just the slightest hesitation passing a centered panel,
			// then it's back to plain, direct tracking.
			const RESISTANCE_MIX = 0.22;
			function easeInOutCubic(t: number): number {
				return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
			}
			function applyResistance(raw: number): number {
				const base = Math.floor(raw);
				const frac = raw - base;
				const eased = easeInOutCubic(frac);
				return base + frac + (eased - frac) * RESISTANCE_MIX;
			}

			const field = document.getElementById('field') as HTMLDivElement;
			const stage = document.getElementById('stage') as HTMLDivElement;

			// ---- case-study modal: loads the real page in place -------------------
			const caseModal = document.getElementById('case-modal') as HTMLDivElement;
			const modalIframe = document.getElementById('modal-iframe') as HTMLIFrameElement;
			function openCaseModal(url: string) {
				modalIframe.src = url;
				caseModal.classList.add('open');
			}
			function closeCaseModal() {
				caseModal.classList.remove('open');
				modalIframe.src = 'about:blank';
			}
			document.getElementById('modal-close')!.addEventListener('click', closeCaseModal);
			caseModal.addEventListener('click', (e) => {
				if (e.target === caseModal) closeCaseModal();
			});
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && caseModal.classList.contains('open')) closeCaseModal();
			});

			// Only a cross of 5 panels is ever rendered: center + one neighbor in
			// each cardinal direction. No diagonals, no grid.
			type Slot = {
				wrap: HTMLDivElement;
				surface: HTMLDivElement;
				key: string;
				dc: number;
				dr: number;
				cleanup?: () => void; // stops a live effect (portrait canvas rAF/listeners) before content is replaced
			};
			const slots: Slot[] = [];
			function makeSlot(dc: number, dr: number): Slot {
				const wrap = document.createElement('div');
				wrap.className = 'panel-wrap';
				const surface = document.createElement('div');
				surface.className = 'panel-surface';
				wrap.appendChild(surface);
				field.appendChild(wrap);
				return { wrap, surface, key: '', dc, dr };
			}
			slots.push(makeSlot(-1, 0), makeSlot(0, 0), makeSlot(1, 0), makeSlot(0, -1), makeSlot(0, 1));

			function buildSurface(item: Item): string {
				if (item.kind === 'home') {
					// "NYC" gets its own span: it's the word the boot animation
					// cycles through landmark emoji into, and the word that
					// swaps to a random one of those emoji on hover.
					const withNycSpan = item.title.replace(/NYC$/, '<span class="nyc-word">NYC</span>');
					return `<div class="home-label">${withNycSpan}</div>`;
				}
				if (item.kind === 'card') {
					const bg = item.image ?? `https://picsum.photos/seed/${encodeURIComponent(item.seed)}/${item.w * 2}/${Math.round((item.h - 90) * 2)}`;
					const isCaseStudy = item.tag === 'case study' && !!item.image;
					const visitArrow = item.link
						? `<button class="card-visit" data-case-link="${item.link}">
								<span class="card-visit-icon">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M7 17L17 7M17 7H9M17 7V15" />
									</svg>
								</span>
							</button>`
						: '';
					return `
						<div class="card-media" style="background-image:url('${bg}')">
							<span class="tag">${item.tag}</span>
							${visitArrow}
						</div>
						<div class="card-text${isCaseStudy ? ' is-case-study' : ''}">
							<div class="card-title">${item.title}</div>
							<div class="card-subtitle">${item.subtitle}</div>
						</div>`;
				}
				if (item.kind === 'video') {
					const src = Math.abs(hashCode(item.title)) % 2 === 0 ? CLIP_A : CLIP_B;
					return `
						<div class="video-media">
							<video autoplay muted loop playsinline src="${src}"></video>
							<span class="video-badge">video</span>
						</div>
						<div class="card-text">
							<div class="card-title">${item.title}</div>
							<div class="card-subtitle">${item.subtitle}</div>
						</div>`;
				}
				if (item.kind === 'browser') {
					return `
						<div class="browser-chrome">
							<div class="browser-dots">
								<svg viewBox="0 0 13 13"><circle cx="6.5" cy="6.5" r="6.5" fill="#ff5f57" /><circle cx="6.5" cy="6.5" r="6.5" fill="url(#bgloss)" /></svg>
								<svg viewBox="0 0 13 13"><circle cx="6.5" cy="6.5" r="6.5" fill="#febc2e" /><circle cx="6.5" cy="6.5" r="6.5" fill="url(#bgloss)" /></svg>
								<svg viewBox="0 0 13 13"><circle cx="6.5" cy="6.5" r="6.5" fill="#28c840" /><circle cx="6.5" cy="6.5" r="6.5" fill="url(#bgloss)" /></svg>
							</div>
							<div class="browser-nav-icons">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 6l-6 6 6 6" /></svg>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l6 6-6 6" /></svg>
							</div>
							<div class="browser-url">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
								<span>${item.display}</span>
							</div>
						</div>
						<div class="browser-body">
							<iframe src="${item.url}" loading="lazy" referrerpolicy="no-referrer"></iframe>
							<a class="browser-visit" href="${item.url}" target="_blank" rel="noopener">
								<span class="browser-visit-icon">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M7 17L17 7M17 7H9M17 7V15" />
									</svg>
								</span>
							</a>
						</div>`;
				}
				if (item.kind === 'portrait') {
					if (PORTRAIT_STYLE === 'basquiat') {
						return `
							<div class="portrait-stage">
								<img class="portrait-img" src="${item.src}" alt="Humayun Rashid" />
								<svg class="portrait-svg" viewBox="0 0 360 500" preserveAspectRatio="none">
									<!-- crown, sat on the hairline, five jagged points with a
									     banded base and small facet ticks for a more layered,
									     scratchy Basquiat texture -->
									<path class="crown" d="M135,112 L135,92 L150,65 L165,92 L178,60 L193,92 L208,60 L221,92 L236,65 L251,92 L251,112 Z" />
									<path class="crown" d="M140,100 L246,100" />
									<path class="crown" d="M160,80 L165,88" />
									<path class="crown" d="M188,73 L193,85" />
									<path class="crown" d="M216,80 L221,88" />
									<!-- mustache -->
									<path d="M165,216 Q178,209 193,215 Q208,209 221,216" />
									<!-- beard: a smooth U tracing the jaw from ear to ear under
									     the chin — a jagged stroke at this scale just scattered
									     across the mouth instead of reading as an outline -->
									<path d="M148,200 Q140,230 145,255 Q150,280 175,298 Q193,306 211,298 Q236,280 241,255 Q246,230 238,200" />
								</svg>
							</div>`;
					}
					return `<div class="portrait-stage"><canvas class="portrait-canvas"></canvas></div>`;
				}
				// photo
				return `
					<div class="photo-image" style="background:${item.tone}"></div>
					<div class="photo-caption">
						<div class="photo-meta-camera">${item.camera}</div>
						<div class="photo-meta-line">${item.meta}</div>
					</div>`;
			}

			// ---- portrait effects: 6 cursor-interactive treatments -----------------
			function clamp01(v: number): number {
				return Math.min(1, Math.max(0, v));
			}

			function coverFit(img: HTMLImageElement, w: number, h: number) {
				const ir = img.naturalWidth / img.naturalHeight;
				const cr = w / h;
				let sx = 0,
					sy = 0,
					sw = img.naturalWidth,
					sh = img.naturalHeight;
				if (ir > cr) {
					sw = img.naturalHeight * cr;
					sx = (img.naturalWidth - sw) / 2;
				} else {
					sh = img.naturalWidth / cr;
					sy = (img.naturalHeight - sh) / 2;
				}
				return { sx, sy, sw, sh };
			}

			function setupCanvas(canvas: HTMLCanvasElement, w: number, h: number): CanvasRenderingContext2D {
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				canvas.width = w * dpr;
				canvas.height = h * dpr;
				canvas.style.width = `${w}px`;
				canvas.style.height = `${h}px`;
				const ctx = canvas.getContext('2d')!;
				ctx.scale(dpr, dpr);
				return ctx;
			}

			type Crop = { sx: number; sy: number; sw: number; sh: number };

			// 1. Pixelation — ambient pixel size slowly grows over time (full
			// clarity -> pixelated), while a small sharp "lens" follows the cursor
			function startPixelate(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, img: HTMLImageElement, crop: Crop, w: number, h: number) {
				let ambient = 2;
				const maxAmbient = 26;
				const growthPerSec = 2.4;
				let mouse: { x: number; y: number } | null = null;
				let last = performance.now();
				let raf = 0;
				const off = document.createElement('canvas');
				const offCtx = off.getContext('2d')!;

				function drawPixelated(size: number, clip?: () => void) {
					const cols = Math.max(1, Math.round(w / size));
					const rows = Math.max(1, Math.round(h / size));
					off.width = cols;
					off.height = rows;
					offCtx.drawImage(img, crop.sx, crop.sy, crop.sw, crop.sh, 0, 0, cols, rows);
					ctx.save();
					if (clip) clip();
					ctx.imageSmoothingEnabled = false;
					ctx.drawImage(off, 0, 0, cols, rows, 0, 0, w, h);
					ctx.restore();
				}

				function frame(now: number) {
					const dt = (now - last) / 1000;
					last = now;
					ambient = Math.min(maxAmbient, ambient + growthPerSec * dt);
					drawPixelated(ambient);
					if (mouse) {
						const mx = mouse.x,
							my = mouse.y;
						drawPixelated(2, () => {
							ctx.beginPath();
							ctx.arc(mx, my, 70, 0, Math.PI * 2);
							ctx.clip();
						});
					}
					raf = requestAnimationFrame(frame);
				}
				raf = requestAnimationFrame(frame);

				function onMove(e: MouseEvent) {
					const r = canvas.getBoundingClientRect();
					mouse = { x: e.clientX - r.left, y: e.clientY - r.top };
				}
				function onLeave() {
					mouse = null;
				}
				canvas.addEventListener('mousemove', onMove);
				canvas.addEventListener('mouseleave', onLeave);
				return () => {
					cancelAnimationFrame(raf);
					canvas.removeEventListener('mousemove', onMove);
					canvas.removeEventListener('mouseleave', onLeave);
				};
			}

			// 3. Warhol — 2x2 duotone grid, cursor position shifts each quadrant's
			// registration for a "chromium"/misprinted-silkscreen feel
			function startWarhol(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, img: HTMLImageElement, crop: Crop, w: number, h: number) {
				const palettes = ['rgb(255,60,120)', 'rgb(0,180,190)', 'rgb(255,140,0)', 'rgb(150,210,60)'];
				let mouseX = 0.5;
				let raf = 0;
				function render() {
					ctx.clearRect(0, 0, w, h);
					const cw = w / 2,
						ch = h / 2;
					for (let i = 0; i < 4; i++) {
						const cx = (i % 2) * cw,
							cy = Math.floor(i / 2) * ch;
						ctx.save();
						ctx.beginPath();
						ctx.rect(cx, cy, cw, ch);
						ctx.clip();
						ctx.fillStyle = palettes[i];
						ctx.fillRect(cx, cy, cw, ch);
						ctx.filter = 'grayscale(1) contrast(1.35) brightness(1.05)';
						ctx.globalCompositeOperation = 'multiply';
						const shift = (mouseX - 0.5) * 16 * (i % 2 === 0 ? 1 : -1);
						ctx.drawImage(img, crop.sx, crop.sy, crop.sw, crop.sh, cx + shift, cy, cw, ch);
						ctx.restore();
					}
					raf = requestAnimationFrame(render);
				}
				raf = requestAnimationFrame(render);
				function onMove(e: MouseEvent) {
					const r = canvas.getBoundingClientRect();
					mouseX = (e.clientX - r.left) / w;
				}
				canvas.addEventListener('mousemove', onMove);
				return () => {
					cancelAnimationFrame(raf);
					canvas.removeEventListener('mousemove', onMove);
				};
			}

			// 4. Pointillism — stippled dots everywhere; near the cursor, dots
			// shrink and resolve into sharper detail
			function startPointillism(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, img: HTMLImageElement, crop: Crop, w: number, h: number) {
				const off = document.createElement('canvas');
				off.width = w;
				off.height = h;
				const offCtx = off.getContext('2d')!;
				offCtx.drawImage(img, crop.sx, crop.sy, crop.sw, crop.sh, 0, 0, w, h);
				const data = offCtx.getImageData(0, 0, w, h).data;
				let mouse: { x: number; y: number } | null = null;
				let raf = 0;
				const cell = 7;
				function render() {
					ctx.fillStyle = '#faf8f2';
					ctx.fillRect(0, 0, w, h);
					for (let y = 0; y < h; y += cell) {
						for (let x = 0; x < w; x += cell) {
							const idx = (Math.min(h - 1, y) * w + Math.min(w - 1, x)) * 4;
							let radius = cell * 0.42;
							if (mouse) {
								const d = Math.hypot(x - mouse.x, y - mouse.y);
								if (d < 90) radius = cell * 0.42 * (0.35 + 0.65 * (d / 90));
							}
							ctx.beginPath();
							ctx.fillStyle = `rgb(${data[idx]},${data[idx + 1]},${data[idx + 2]})`;
							ctx.arc(x + cell / 2, y + cell / 2, Math.max(0.6, radius), 0, Math.PI * 2);
							ctx.fill();
						}
					}
					raf = requestAnimationFrame(render);
				}
				raf = requestAnimationFrame(render);
				function onMove(e: MouseEvent) {
					const r = canvas.getBoundingClientRect();
					mouse = { x: e.clientX - r.left, y: e.clientY - r.top };
				}
				function onLeave() {
					mouse = null;
				}
				canvas.addEventListener('mousemove', onMove);
				canvas.addEventListener('mouseleave', onLeave);
				return () => {
					cancelAnimationFrame(raf);
					canvas.removeEventListener('mousemove', onMove);
					canvas.removeEventListener('mouseleave', onLeave);
				};
			}

			// 5. Impressionist brushstrokes — a field of small rotated strokes
			// sampled from the photo; cursor stirs a local swirl into the flow
			function startImpressionist(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, img: HTMLImageElement, crop: Crop, w: number, h: number) {
				const off = document.createElement('canvas');
				off.width = w;
				off.height = h;
				const offCtx = off.getContext('2d')!;
				offCtx.drawImage(img, crop.sx, crop.sy, crop.sw, crop.sh, 0, 0, w, h);
				const data = offCtx.getImageData(0, 0, w, h).data;
				let mouse = { x: w / 2, y: h / 2 };
				let t = 0;
				let raf = 0;
				const cell = 8;
				function render() {
					t += 0.01;
					ctx.fillStyle = '#141210';
					ctx.fillRect(0, 0, w, h);
					for (let y = 0; y < h; y += cell) {
						for (let x = 0; x < w; x += cell) {
							const idx = (Math.min(h - 1, y) * w + Math.min(w - 1, x)) * 4;
							let angle = Math.sin(x * 0.05 + t) * 0.6 + Math.cos(y * 0.05 + t * 0.7) * 0.6;
							const dx = x - mouse.x,
								dy = y - mouse.y;
							const dist = Math.hypot(dx, dy);
							if (dist < 120) {
								const swirl = (1 - dist / 120) * 2.2;
								angle += Math.atan2(dy, dx) + (Math.PI / 2) * swirl;
							}
							ctx.save();
							ctx.translate(x + cell / 2, y + cell / 2);
							ctx.rotate(angle);
							ctx.fillStyle = `rgb(${data[idx]},${data[idx + 1]},${data[idx + 2]})`;
							ctx.fillRect(-cell * 0.7, -cell * 0.22, cell * 1.4, cell * 0.44);
							ctx.restore();
						}
					}
					raf = requestAnimationFrame(render);
				}
				raf = requestAnimationFrame(render);
				function onMove(e: MouseEvent) {
					const r = canvas.getBoundingClientRect();
					mouse = { x: e.clientX - r.left, y: e.clientY - r.top };
				}
				canvas.addEventListener('mousemove', onMove);
				return () => {
					cancelAnimationFrame(raf);
					canvas.removeEventListener('mousemove', onMove);
				};
			}

			// 6. Sketch — Sobel edge-detected line art that draws itself in with a
			// jittery, hand-drawn reveal edge; cursor nudges a "still touching up"
			// jitter into nearby lines once the reveal is done
			function startSketch(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, img: HTMLImageElement, crop: Crop, w: number, h: number) {
				const off = document.createElement('canvas');
				off.width = w;
				off.height = h;
				const offCtx = off.getContext('2d')!;
				offCtx.drawImage(img, crop.sx, crop.sy, crop.sw, crop.sh, 0, 0, w, h);
				const src = offCtx.getImageData(0, 0, w, h);
				const gray = new Float32Array(w * h);
				for (let i = 0; i < w * h; i++) {
					const o = i * 4;
					gray[i] = src.data[o] * 0.3 + src.data[o + 1] * 0.59 + src.data[o + 2] * 0.11;
				}
				const sketchCanvas = document.createElement('canvas');
				sketchCanvas.width = w;
				sketchCanvas.height = h;
				const sketchImg = sketchCanvas.getContext('2d')!.createImageData(w, h);
				for (let y = 1; y < h - 1; y++) {
					for (let x = 1; x < w - 1; x++) {
						const i = y * w + x;
						const gx = -gray[i - w - 1] - 2 * gray[i - 1] - gray[i + w - 1] + gray[i - w + 1] + 2 * gray[i + 1] + gray[i + w + 1];
						const gy = -gray[i - w - 1] - 2 * gray[i - w] - gray[i - w + 1] + gray[i + w - 1] + 2 * gray[i + w] + gray[i + w + 1];
						const mag = Math.min(255, Math.sqrt(gx * gx + gy * gy));
						const v = 255 - mag * 1.6;
						sketchImg.data[i * 4] = v;
						sketchImg.data[i * 4 + 1] = v;
						sketchImg.data[i * 4 + 2] = v;
						sketchImg.data[i * 4 + 3] = 255;
					}
				}
				sketchCanvas.getContext('2d')!.putImageData(sketchImg, 0, 0);

				let raf = 0;
				let mouse: { x: number; y: number } | null = null;
				const start = performance.now();
				const REVEAL_MS = 2600;
				const jitterSeed = Array.from({ length: 40 }, () => Math.random());

				function render(now: number) {
					const t = clamp01((now - start) / REVEAL_MS);
					ctx.fillStyle = '#fdfcf8';
					ctx.fillRect(0, 0, w, h);
					ctx.save();
					ctx.beginPath();
					const revealY = t * (h + 60) - 30;
					const step = w / (jitterSeed.length - 1);
					ctx.moveTo(0, 0);
					ctx.lineTo(w, 0);
					// walk the jittery boundary right-to-left so it continues the
					// path's direction instead of zigzagging back across itself
					for (let i = jitterSeed.length - 1; i >= 0; i--) {
						const x = i * step;
						const jitter = (jitterSeed[i] - 0.5) * 26;
						ctx.lineTo(x, Math.max(0, revealY + jitter));
					}
					ctx.closePath();
					ctx.clip();
					ctx.drawImage(sketchCanvas, 0, 0);
					ctx.restore();

					if (mouse && t >= 1) {
						ctx.save();
						ctx.beginPath();
						ctx.arc(mouse.x, mouse.y, 46, 0, Math.PI * 2);
						ctx.clip();
						ctx.globalAlpha = 0.85 + Math.random() * 0.15;
						ctx.drawImage(sketchCanvas, Math.round((Math.random() - 0.5) * 2), Math.round((Math.random() - 0.5) * 2));
						ctx.restore();
					}
					raf = requestAnimationFrame(render);
				}
				raf = requestAnimationFrame(render);
				function onMove(e: MouseEvent) {
					const r = canvas.getBoundingClientRect();
					mouse = { x: e.clientX - r.left, y: e.clientY - r.top };
				}
				function onLeave() {
					mouse = null;
				}
				canvas.addEventListener('mousemove', onMove);
				canvas.addEventListener('mouseleave', onLeave);
				return () => {
					cancelAnimationFrame(raf);
					canvas.removeEventListener('mousemove', onMove);
					canvas.removeEventListener('mouseleave', onLeave);
				};
			}

			// 2. Basquiat — hand-drawn crown/monocle/beard SVG overlay that draws
			// itself on; hovering the portrait replays the draw-on animation
			function startBasquiat(container: HTMLElement): () => void {
				const svg = container.querySelector('svg.portrait-svg');
				const paths = svg ? Array.from(svg.querySelectorAll('path, circle, line')) : [];
				function playDraw() {
					paths.forEach((p, i) => {
						const el = p as SVGGeometryElement & HTMLElement;
						const len = 'getTotalLength' in el ? (el as any).getTotalLength() : 200;
						el.style.strokeDasharray = String(len);
						el.style.strokeDashoffset = String(len);
						el.style.transition = 'none';
						void el.getBoundingClientRect(); // force reflow so the reset above takes effect before animating
						el.style.transition = `stroke-dashoffset ${900 + i * 220}ms ease-out ${i * 160}ms`;
						requestAnimationFrame(() => {
							el.style.strokeDashoffset = '0';
						});
					});
				}
				playDraw();
				function onEnter() {
					playDraw();
				}
				container.addEventListener('mouseenter', onEnter);
				return () => {
					container.removeEventListener('mouseenter', onEnter);
				};
			}

			function initPortrait(container: HTMLElement, src: string, w: number, h: number): () => void {
				let cancelled = false;
				let stop: (() => void) | null = null;
				if (PORTRAIT_STYLE === 'basquiat') {
					stop = startBasquiat(container);
					return () => {
						cancelled = true;
						stop?.();
					};
				}
				const img = new Image();
				img.onload = () => {
					if (cancelled) return;
					const canvas = container.querySelector('canvas.portrait-canvas') as HTMLCanvasElement | null;
					if (!canvas) return;
					const ctx = setupCanvas(canvas, w, h);
					const crop = coverFit(img, w, h);
					if (PORTRAIT_STYLE === 'pixelate') stop = startPixelate(canvas, ctx, img, crop, w, h);
					else if (PORTRAIT_STYLE === 'warhol') stop = startWarhol(canvas, ctx, img, crop, w, h);
					else if (PORTRAIT_STYLE === 'pointillism') stop = startPointillism(canvas, ctx, img, crop, w, h);
					else if (PORTRAIT_STYLE === 'impressionist') stop = startImpressionist(canvas, ctx, img, crop, w, h);
					else if (PORTRAIT_STYLE === 'sketch') stop = startSketch(canvas, ctx, img, crop, w, h);
				};
				img.src = src;
				return () => {
					cancelled = true;
					stop?.();
				};
			}

			function render() {
				const panCol = applyResistance(rawCol);
				const panRow = applyResistance(rawRow);
				const centerColInt = Math.round(panCol);
				const centerRowInt = Math.round(panRow);

				for (const slot of slots) {
					const c = centerColInt + slot.dc;
					const r = centerRowInt + slot.dr;
					const key = `${c},${r}`;
					const item = itemAt(c, r);
					if (slot.key !== key) {
						slot.cleanup?.(); // stop any live effect (portrait canvas rAF) before this slot's content is replaced
						slot.cleanup = undefined;
						slot.surface.innerHTML = buildSurface(item) + `<div class="coord">${c},${r}</div>`;
						slot.wrap.className = `panel-wrap k-${item.kind}`;
						slot.wrap.style.width = `${item.w}px`;
						slot.wrap.style.height = `${item.h}px`;
						slot.key = key;
						// re-wire the NYC hover-swap every time home's markup is
						// rebuilt (innerHTML replace drops old listeners) — covers
						// both the first render and any later return to home
						if (item.kind === 'home') {
							const nycEl = slot.surface.querySelector<HTMLElement>('.nyc-word');
							nycEl?.addEventListener('mouseenter', () => {
								nycEl.textContent = NYC_EMOJIS[Math.floor(Math.random() * NYC_EMOJIS.length)];
							});
							nycEl?.addEventListener('mouseleave', () => {
								nycEl.textContent = 'NYC';
							});
						}
						// case-study visit arrow opens the real page in the modal
						// instead of navigating away from the sphere
						if (item.kind === 'card' && item.link) {
							const visitBtn = slot.surface.querySelector<HTMLButtonElement>('.card-visit');
							visitBtn?.addEventListener('click', (e) => {
								e.stopPropagation();
								openCaseModal(item.link!);
							});
						}
						if (item.kind === 'portrait') {
							slot.cleanup = initPortrait(slot.surface, item.src, item.w, item.h);
						}
					}

					const dCol = c - panCol;
					const dRow = r - panRow;
					const dist = Math.sqrt(dCol * dCol + dRow * dRow);
					// gentler falloff than before — neighbors should still read
					// clearly as "there's more this way", not fade to near-nothing
					const scale = clamp(1.08 - dist * 0.28, 0.62, 1.08);
					const opacity = clamp(1 - dist * 0.32, 0.35, 1);
					const lon = dCol * DEG_PER_COL;
					const lat = dRow * DEG_PER_ROW;

					slot.wrap.style.transform = sphereTransform(lon, lat, `scale(${scale})`);
					slot.wrap.style.opacity = String(opacity);
					slot.wrap.style.zIndex = String(Math.round(2000 - dist * 10));

					// floating depth: very subtle — a hint of lift, not a heavy
					// drop shadow. The hover-to-visit affordance on browser
					// panels is untouched. Home is bare text — no shadow at all.
					// For card/video, the shadow belongs on the media block only
					// — the headline/subtext below must read as free-floating
					// text on the page, not part of a shared card silhouette.
					const lift = clamp(1 - dist, 0, 1);
					const shadow = `0 ${5 * lift + 2}px ${16 * lift + 5}px rgba(0,0,0,${0.03 + 0.05 * lift})`;
					if (item.kind === 'home') {
						slot.surface.style.boxShadow = 'none';
					} else if (item.kind === 'card' || item.kind === 'video') {
						slot.surface.style.boxShadow = 'none';
						const media = slot.surface.querySelector<HTMLElement>('.card-media, .video-media');
						if (media) media.style.boxShadow = shadow;
					} else {
						slot.surface.style.boxShadow = shadow;
					}
				}
				renderMinimap(centerColInt, centerRowInt);
			}

			function renderMinimap(centerColInt: number, centerRowInt: number) {
				const mm = document.getElementById('minimap')!;
				mm.innerHTML = '';
				for (let r = 0; r < ROWS; r++) {
					for (let c = 0; c < COLS; c++) {
						const cell = document.createElement('div');
						cell.className = 'cell';
						if (mod(r, ROWS) === mod(centerRowInt, ROWS) && mod(c, COLS) === mod(centerColInt, COLS)) {
							cell.classList.add('active');
						}
						mm.appendChild(cell);
					}
				}
			}

			// ---- input: drag (mouse + touch via pointer events) -----------------
			// Listens on #stage, but panels are pointer-events:auto (so hover/
			// click work on browser panels) — pointerdown on a panel still
			// bubbles up to this handler since nothing stops propagation.
			//
			// Interactive controls (the case-study visit button, external
			// browser-panel links) are excluded from starting a drag at all:
			// setPointerCapture retargets the resulting click event to
			// whichever element captured the pointer, which silently ate
			// clicks on anything nested inside #stage — found by testing a
			// real mouse click on the case-study arrow, which JS-triggered
			// .click() calls during earlier testing had masked.
			stage.addEventListener('pointerdown', (e) => {
				if ((e.target as HTMLElement).closest('.card-visit, .browser-visit')) return;
				dragging = true;
				stage.classList.add('grabbing');
				stage.setPointerCapture(e.pointerId);
				startX = e.clientX;
				startY = e.clientY;
				startRawCol = rawCol;
				startRawRow = rawRow;
				velX = velY = 0;
				lastDx = lastDy = 0;
				lastMoveT = performance.now();
				cancelAnim();
			});

			stage.addEventListener('pointermove', (e) => {
				if (!dragging) return;
				const dx = e.clientX - startX;
				const dy = e.clientY - startY;
				const now = performance.now();
				const dt = Math.max(16, now - lastMoveT);
				velX = (dx - lastDx) / dt;
				velY = (dy - lastDy) / dt;
				lastDx = dx;
				lastDy = dy;
				lastMoveT = now;
				rawCol = safe(startRawCol - dx * DRAG_SENSITIVITY);
				rawRow = safe(startRawRow - dy * DRAG_SENSITIVITY);
				render();
			});

			function endDrag() {
				if (!dragging) return;
				dragging = false;
				stage.classList.remove('grabbing');
				const vCol = -velX * DRAG_SENSITIVITY;
				const vRow = -velY * DRAG_SENSITIVITY;
				startCoast(vCol, vRow);
			}
			stage.addEventListener('pointerup', endDrag);
			stage.addEventListener('pointercancel', endDrag);
			stage.addEventListener('pointerleave', () => {
				if (dragging) endDrag();
			});

			// ---- input: wheel / trackpad -----------------------------------------
			stage.addEventListener(
				'wheel',
				(e) => {
					e.preventDefault();
					cancelAnim();
					rawCol = safe(rawCol + e.deltaX * WHEEL_SENSITIVITY);
					rawRow = safe(rawRow + e.deltaY * WHEEL_SENSITIVITY);
					render();
				},
				{ passive: false }
			);

			// ---- free momentum coast on release — no forced snap ------------------
			// Dragging is direct 1:1 tracking (through the light detent above);
			// letting go just carries that motion on with friction until it
			// naturally comes to rest, wherever that is — it is not pulled to
			// the nearest panel. Keyboard/arrow controls still jump exactly one
			// panel via animateRawTo, since those are deliberate discrete actions.
			const FRICTION_PER_16MS = 0.9;
			function startCoast(vCol: number, vRow: number) {
				cancelAnim();
				let vC = clamp(vCol, -2.5, 2.5);
				let vR = clamp(vRow, -2.5, 2.5);
				let lastT = performance.now();
				function frame(now: number) {
					const dt = Math.min(48, now - lastT);
					lastT = now;
					rawCol = safe(rawCol + vC * dt);
					rawRow = safe(rawRow + vR * dt);
					const decay = Math.pow(FRICTION_PER_16MS, dt / 16.67);
					vC *= decay;
					vR *= decay;
					render();
					if (Math.abs(vC) > 0.00005 || Math.abs(vR) > 0.00005) {
						animRAF = requestAnimationFrame(frame);
					} else {
						targetCol = Math.round(rawCol);
						targetRow = Math.round(rawRow);
						stepChaining = true;
						animRAF = undefined;
					}
				}
				animRAF = requestAnimationFrame(frame);
			}

			// ---- input: keyboard ---------------------------------------------------
			window.addEventListener('keydown', (e) => {
				const step: Record<string, [number, number]> = {
					ArrowLeft: [-1, 0],
					ArrowRight: [1, 0],
					ArrowUp: [0, -1],
					ArrowDown: [0, 1],
				};
				if (step[e.key]) {
					e.preventDefault();
					stepMove(...step[e.key]);
				}
			});

			// ---- edge arrow clicks ---------------------------------------------
			document.getElementById('arrow-up')!.addEventListener('click', () => stepMove(0, -1));
			document.getElementById('arrow-down')!.addEventListener('click', () => stepMove(0, 1));
			document.getElementById('arrow-left')!.addEventListener('click', () => stepMove(-1, 0));
			document.getElementById('arrow-right')!.addEventListener('click', () => stepMove(1, 0));
			document.getElementById('nav-home')!.addEventListener('click', () => animateRawTo(0, 0));

			// logo mark: same hover behavior as the real site's Topbar logo —
			// cells randomly flip between the shimmer ("letter") state and
			// plain gray on mousemove, at the same ~45% chance per cell
			const LOGO_LETTER_CHANCE = 0.45;
			const logoCells = document.querySelectorAll<HTMLElement>('.logo-mark .px:not(.is-corner)');
			document.getElementById('nav-home')!.addEventListener('mousemove', () => {
				logoCells.forEach((cell) => {
					cell.classList.toggle('is-letter', Math.random() < LOGO_LETTER_CHANCE);
				});
			});

			// ---- "Work" nav: jumble the visible panels, then rearrange into a
			// work-only view (every case study + the other live sites). Clicking
			// again toggles back to the normal mixed field.
			document.getElementById('nav-work')!.addEventListener('click', (e) => {
				e.preventDefault();
				toggleWorkMode();
			});

			function toggleWorkMode() {
				cancelAnim();
				const jitterEls = slots.map((s) => s.wrap);
				const baseTransforms = jitterEls.map((el) => el.style.transform);
				const JUMBLE_MS = 480;
				const start = performance.now();
				function jumble(now: number) {
					const t = clamp((now - start) / JUMBLE_MS, 0, 1);
					const wobble = Math.sin(t * Math.PI); // ramps up then back down to 0
					for (let i = 0; i < jitterEls.length; i++) {
						const jx = Math.sin(i * 13.1 + 1) * 220 * wobble;
						const jy = Math.sin(i * 7.7 + 3) * 160 * wobble;
						const jr = Math.sin(i * 5.3 + 2) * 50 * wobble;
						jitterEls[i].style.transform = `${baseTransforms[i]} translate(${jx}px, ${jy}px) rotate(${jr}deg)`;
					}
					if (t < 1) {
						requestAnimationFrame(jumble);
					} else {
						for (let i = 0; i < jitterEls.length; i++) jitterEls[i].style.transform = baseTransforms[i];
						mode = mode === 'work' ? 'default' : 'work';
						rawCol = 0;
						rawRow = 0;
						stepChaining = false;
						for (const s of slots) s.key = '';
						render();
					}
				}
				requestAnimationFrame(jumble);
			}

			let stepChaining = false;
			let targetCol = 0;
			let targetRow = 0;

			function stepMove(dc: number, dr: number) {
				const baseCol = stepChaining ? targetCol : Math.round(rawCol);
				const baseRow = stepChaining ? targetRow : Math.round(rawRow);
				animateRawTo(baseCol + dc, baseRow + dr);
				stepChaining = true;
			}

			function cancelAnim() {
				if (animRAF) cancelAnimationFrame(animRAF);
				animRAF = undefined;
			}

			function animateRawTo(nextCol: number, nextRow: number) {
				cancelAnim();
				stepChaining = true;
				targetCol = nextCol;
				targetRow = nextRow;
				const fromCol = rawCol;
				const fromRow = rawRow;
				const dCol = nextCol - fromCol;
				const dRow = nextRow - fromRow;
				const duration = 320;
				const start = performance.now();
				function tick(now: number) {
					const t = clamp((now - start) / duration, 0, 1);
					const eased = 1 - Math.pow(1 - t, 3);
					rawCol = fromCol + dCol * eased;
					rawRow = fromRow + dRow * eased;
					render();
					if (t < 1) {
						animRAF = requestAnimationFrame(tick);
					} else {
						rawCol = nextCol;
						rawRow = nextRow;
						render();
						animRAF = undefined;
					}
				}
				animRAF = requestAnimationFrame(tick);
			}

			// ---- nav pill stub links --------------------------------------------
			document.querySelectorAll('#nav a[data-stub]').forEach((a) => {
				a.addEventListener('click', (e) => {
					e.preventDefault();
					a.classList.add('flash');
					setTimeout(() => a.classList.remove('flash'), 250);
					console.log(`stub nav → ${(a as HTMLElement).dataset.stub}`);
				});
			});

			// ---- boot sequence: blank -> home text fades in -> neighbors fade in ---
			// A one-time reveal on first load, not something that replays every
			// time you navigate back to home. Position everything immediately
			// (so transforms/sizes are correct from frame one), but hold every
			// panel's own surface at opacity 0 and fade them in on a timer —
			// independent of the per-frame distance-based opacity that
			// panel-wrap already handles, so dragging mid-intro can't conflict
			// with it.
			for (const slot of slots) slot.surface.style.opacity = '0';
			render();

			const homeSlot = slots.find((s) => s.dc === 0 && s.dr === 0)!;
			const neighborSlots = slots.filter((s) => s !== homeSlot);

			function fadeOpacity(els: HTMLDivElement[], duration: number, onDone?: () => void) {
				const start = performance.now();
				function frame(now: number) {
					const t = clamp((now - start) / duration, 0, 1);
					for (const el of els) el.style.opacity = String(t);
					if (t < 1) {
						requestAnimationFrame(frame);
					} else {
						for (const el of els) el.style.opacity = '';
						onDone?.();
					}
				}
				requestAnimationFrame(frame);
			}

			// Home's own reveal: the surface itself is visible immediately (it
			// has no box, nothing to hide), and the label rises up from below
			// while fading in — slow, so it reads as a deliberate entrance, not
			// a quick fade. The "NYC" word runs through a quick reel of NYC
			// landmark emoji alongside it, landing on the real word right as
			// the reveal finishes.
			homeSlot.surface.style.opacity = '1';
			const homeLabel = homeSlot.surface.querySelector<HTMLElement>('.home-label');
			const nycWord = homeSlot.surface.querySelector<HTMLElement>('.nyc-word');
			const REVEAL_MS = 1700;

			function revealHomeLabel(onDone: () => void) {
				if (!homeLabel) {
					onDone();
					return;
				}
				homeLabel.style.opacity = '0';
				homeLabel.style.transform = 'translateY(44px)';
				const start = performance.now();
				function frame(now: number) {
					const t = clamp((now - start) / REVEAL_MS, 0, 1);
					const eased = 1 - Math.pow(1 - t, 3);
					homeLabel!.style.opacity = String(eased);
					homeLabel!.style.transform = `translateY(${(1 - eased) * 44}px)`;
					if (t < 1) {
						requestAnimationFrame(frame);
					} else {
						homeLabel!.style.opacity = '';
						homeLabel!.style.transform = '';
						onDone();
					}
				}
				requestAnimationFrame(frame);
			}

			if (nycWord) {
				const frameMs = Math.round((REVEAL_MS * 0.7) / NYC_EMOJIS.length);
				let i = 0;
				function cycle() {
					if (i < NYC_EMOJIS.length) {
						nycWord!.textContent = NYC_EMOJIS[i];
						i++;
						setTimeout(cycle, frameMs);
					} else {
						nycWord!.textContent = 'NYC';
					}
				}
				cycle();
			}

			revealHomeLabel(() => {
				fadeOpacity(
					neighborSlots.map((s) => s.surface),
					650
				);
			});
		</script>
	</body>
</html>
