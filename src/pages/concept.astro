---
// Low-fidelity prototype: sphere/orbit navigation mechanic.
// Wireframe only — no visual design. Goal is to prove the interaction
// model: a field of panels sitting on true spherical coordinates (each
// panel is a small mesh of tiles, not a rigid flat rectangle, so its own
// edges visibly curve away), navigated with resistance-then-hard-lock
// dragging. Both axes loop forever — no dead ends.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>concept — orbit nav</title>
		<meta name="robots" content="noindex" />
		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				overflow: hidden;
				background: #fff;
				font-family: system-ui, -apple-system, sans-serif;
				color: #111;
				touch-action: none;
			}

			#stage {
				position: fixed;
				inset: 0;
				perspective: 1600px;
				perspective-origin: 50% 50%;
				cursor: grab;
			}
			#stage.grabbing {
				cursor: grabbing;
			}

			#field {
				position: absolute;
				inset: 0;
				transform-style: preserve-3d;
			}

			.tile {
				position: absolute;
				top: 50%;
				left: 50%;
				background: #f2f2f2;
				border: 1px solid #e2e2e2;
				will-change: transform, opacity;
				pointer-events: none;
			}
			.tile.home {
				background: #fafafa;
				border-color: #ececec;
			}

			.content {
				position: absolute;
				top: 50%;
				left: 50%;
				width: 50vw;
				max-width: 720px;
				height: 64vh;
				max-height: 520px;
				border: 1.5px dashed #bbb;
				background: rgba(246, 246, 246, 0.35);
				border-radius: 10px;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 8px;
				text-align: center;
				padding: 24px;
				will-change: transform, opacity;
				pointer-events: none;
			}
			.content.home {
				background: rgba(255, 255, 255, 0.6);
				border-style: solid;
				border-color: #ddd;
			}
			.content .type {
				font-size: 11px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #999;
			}
			.content .label {
				font-size: 18px;
				color: #444;
				max-width: 80%;
			}
			.content.home .label {
				font-size: clamp(22px, 3vw, 34px);
				color: #111;
				font-weight: 500;
				line-height: 1.25;
			}
			.content .coord {
				position: absolute;
				bottom: 8px;
				right: 10px;
				font-size: 10px;
				color: #ccc;
			}

			/* edge affordance arrows */
			.edge-arrow {
				position: fixed;
				z-index: 30;
				background: none;
				border: none;
				cursor: pointer;
				color: #999;
				padding: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: opacity 150ms;
			}
			.edge-arrow:hover {
				color: #111;
			}
			.edge-arrow svg {
				width: 22px;
				height: 22px;
			}
			#arrow-up {
				top: 18px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-down {
				bottom: 96px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-left {
				left: 18px;
				top: 50%;
				transform: translateY(-50%);
			}
			#arrow-right {
				right: 18px;
				top: 50%;
				transform: translateY(-50%);
			}

			/* floating nav pill, Mobbin-style, fixed bottom center */
			#nav {
				position: fixed;
				bottom: 28px;
				left: 50%;
				transform: translateX(-50%);
				z-index: 40;
				display: flex;
				align-items: center;
				gap: 4px;
				padding: 8px;
				background: rgba(255, 255, 255, 0.85);
				backdrop-filter: blur(12px);
				border: 1px solid #e5e5e5;
				border-radius: 999px;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
			}
			#nav button.dot {
				width: 34px;
				height: 34px;
				border-radius: 999px;
				border: none;
				background: #f0f0f0;
				cursor: pointer;
				font-size: 12px;
				color: #666;
			}
			#nav a {
				padding: 8px 16px;
				border-radius: 999px;
				text-decoration: none;
				color: #333;
				font-size: 14px;
				transition: background 120ms;
			}
			#nav a:hover {
				background: #f0f0f0;
			}
			#nav a.flash {
				background: #111;
				color: #fff;
			}

			#hint {
				position: fixed;
				top: 18px;
				left: 18px;
				font-size: 11px;
				color: #bbb;
				z-index: 30;
				max-width: 230px;
				line-height: 1.5;
			}

			#minimap {
				position: fixed;
				bottom: 96px;
				right: 24px;
				z-index: 30;
				display: grid;
				grid-template-columns: repeat(6, 6px);
				grid-auto-rows: 6px;
				gap: 4px;
			}
			#minimap .cell {
				width: 6px;
				height: 6px;
				border-radius: 999px;
				background: #e5e5e5;
			}
			#minimap .cell.active {
				background: #111;
			}
		</style>
	</head>
	<body>
		<div id="hint">
			drag / scroll / swipe to look around · arrow keys work too<br />
			loops forever both ways · panels lock into place, with a little give as you leave one
		</div>

		<div id="stage">
			<div id="field"></div>
		</div>

		<button class="edge-arrow" id="arrow-up" aria-label="pan up">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 19V5M5 12l7-7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-down" aria-label="pan down">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 5v14M5 12l7 7 7-7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-left" aria-label="pan left">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M19 12H5M12 5l-7 7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-right" aria-label="pan right">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M5 12h14M12 5l7 7-7 7" /></svg
			>
		</button>

		<div id="minimap"></div>

		<nav id="nav">
			<button class="dot" id="nav-home" title="recenter">◎</button>
			<a href="#" data-stub="/work">Work</a>
			<a href="#" data-stub="/ideas">Ideas</a>
			<a href="#" data-stub="/about">About</a>
		</nav>

		<script>
			// ---- content model -------------------------------------------------
			// A torus: both axes loop forever. Row 0 / col 0 is "home".
			const COLS = 6;
			const ROWS = 3;
			type Panel = { type: string; label: string };

			const rowsByIndex: Panel[][] = [
				[
					{ type: 'home', label: 'Humayun Rashid is a designer & founder in NYC.' },
					{ type: 'case study', label: 'Sublime Security' },
					{ type: 'link', label: 'rendr.app ↗' },
					{ type: 'image', label: 'Untitled study, 03' },
					{ type: 'case study', label: 'Atrium' },
					{ type: 'video', label: 'Reel — process' },
				],
				[
					{ type: 'about', label: 'About — the longer version' },
					{ type: 'ideas', label: 'Ideas — writing & notes' },
					{ type: 'work', label: 'Work — full index' },
					{ type: 'image', label: 'Desk, 2026' },
					{ type: 'video', label: 'Talk — five users' },
					{ type: 'case study', label: 'Principles' },
				],
				[
					{ type: 'image', label: 'Sketch, pass 1' },
					{ type: 'experiment', label: 'Pack hover takeover' },
					{ type: 'image', label: 'Type test' },
					{ type: 'video', label: 'Motion study' },
					{ type: 'link', label: 'dribbble ↗' },
					{ type: 'image', label: 'Color study' },
				],
			];

			function mod(n: number, m: number) {
				return ((n % m) + m) % m;
			}
			function contentAt(col: number, row: number): Panel {
				return rowsByIndex[mod(row, ROWS)][mod(col, COLS)];
			}
			function safe(n: number): number {
				return Number.isFinite(n) ? n : 0;
			}
			function clamp(v: number, lo: number, hi: number) {
				return Math.min(hi, Math.max(lo, v));
			}

			// ---- true spherical placement -----------------------------------------
			// Every point in the field — a panel's own center, and every tile inside
			// it — is placed by longitude/latitude on an actual sphere, not by a
			// flat grid position plus a rigid rotate. That's what makes a panel's
			// own edges visibly bow away, and keeps the same curvature true for
			// whichever content is scrolled into any given spot.
			const SPHERE_R = 1900; // px
			const DEG_PER_COL = 34; // longitude degrees between adjacent panel centers
			const DEG_PER_ROW = 26; // latitude degrees between adjacent panel centers
			const PANEL_SPAN_LON = 15; // degrees a single panel's own mesh spans
			const PANEL_SPAN_LAT = 11;

			function sphereTransform(lonDeg: number, latDeg: number, extra = ''): string {
				const lon = (clamp(lonDeg, -85, 85) * Math.PI) / 180;
				const lat = (clamp(latDeg, -85, 85) * Math.PI) / 180;
				const x = SPHERE_R * Math.sin(lon) * Math.cos(lat);
				const y = SPHERE_R * Math.sin(lat);
				const z = SPHERE_R * (Math.cos(lon) * Math.cos(lat) - 1);
				return `translate(-50%, -50%) translate3d(${x}px, ${y}px, ${z}px) rotateY(${-lonDeg}deg) rotateX(${latDeg}deg) ${extra}`;
			}

			function panelSize() {
				return {
					w: Math.min(window.innerWidth * 0.5, 720),
					h: Math.min(window.innerHeight * 0.64, 520),
				};
			}

			// ---- state -----------------------------------------------------------
			// rawCol/rawRow are the "true" unbounded drag position. panCol/panRow
			// (what's actually rendered) are rawCol/rawRow pushed through a
			// resistance curve — see applyResistance — so motion is continuous
			// everywhere but reluctant to leave a centered panel and quick to
			// cross the gap to the next one.
			let rawCol = 0;
			let rawRow = 0;
			let dragging = false;
			let startX = 0,
				startY = 0,
				startRawCol = 0,
				startRawRow = 0;
			let velX = 0,
				velY = 0,
				lastMoveT = 0,
				lastDx = 0,
				lastDy = 0;
			let animRAF: number | undefined;

			const DRAG_SENSITIVITY = 1 / 420;
			const WHEEL_SENSITIVITY = 1 / 900;

			// resistance: an ease-in-out applied within each unit interval, so
			// dragging away from an integer (a centered panel) starts slow —
			// "locked, with a little give" — then moves quickly through the
			// middle toward the next integer.
			function easeInOutCubic(t: number): number {
				return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
			}
			function applyResistance(raw: number): number {
				const base = Math.floor(raw);
				const frac = raw - base;
				return base + easeInOutCubic(frac);
			}

			const field = document.getElementById('field') as HTMLDivElement;
			const stage = document.getElementById('stage') as HTMLDivElement;

			// Only a cross of 5 panels is ever rendered: center + one neighbor in
			// each cardinal direction. No diagonals, no grid.
			const TILE_COLS = 6;
			const TILE_ROWS = 4;
			const MESH_SCALE = 1.14; // tiles span slightly beyond the content box

			type Slot = {
				content: HTMLDivElement;
				tiles: HTMLDivElement[];
				key: string;
				dc: number;
				dr: number;
			};
			const slots: Slot[] = [];
			function makeSlot(dc: number, dr: number): Slot {
				const content = document.createElement('div');
				content.className = 'content';
				content.innerHTML = `<div class="type"></div><div class="label"></div><div class="coord"></div>`;
				const tiles: HTMLDivElement[] = [];
				for (let i = 0; i < TILE_COLS * TILE_ROWS; i++) {
					const tile = document.createElement('div');
					tile.className = 'tile';
					field.appendChild(tile);
					tiles.push(tile);
				}
				field.appendChild(content); // content painted after its tiles, on top
				return { content, tiles, key: '', dc, dr };
			}
			slots.push(makeSlot(-1, 0), makeSlot(0, 0), makeSlot(1, 0), makeSlot(0, -1), makeSlot(0, 1));

			function render() {
				const centerColInt = Math.round(applyResistance(rawCol));
				const centerRowInt = Math.round(applyResistance(rawRow));
				const panCol = applyResistance(rawCol);
				const panRow = applyResistance(rawRow);
				const { w: panelW, h: panelH } = panelSize();
				const tileW = (panelW * MESH_SCALE) / TILE_COLS;
				const tileH = (panelH * MESH_SCALE) / TILE_ROWS;

				for (const slot of slots) {
					const c = centerColInt + slot.dc;
					const r = centerRowInt + slot.dr;
					const key = `${c},${r}`;
					if (slot.key !== key) {
						const item = contentAt(c, r);
						const isHome = item.type === 'home';
						slot.content.classList.toggle('home', isHome);
						slot.content.querySelector('.type')!.textContent = item.type;
						slot.content.querySelector('.label')!.textContent = item.label;
						slot.content.querySelector('.coord')!.textContent = `${c},${r}`;
						for (const tile of slot.tiles) tile.classList.toggle('home', isHome);
						slot.key = key;
					}

					const dCol = c - panCol;
					const dRow = r - panRow;
					const dist = Math.sqrt(dCol * dCol + dRow * dRow);
					const scale = clamp(1.15 - dist * 0.5, 0.4, 1.15);
					const opacity = clamp(1 - dist * 0.55, 0, 1);
					const lon = dCol * DEG_PER_COL;
					const lat = dRow * DEG_PER_ROW;

					slot.content.style.transform = sphereTransform(lon, lat, `scale(${scale})`);
					slot.content.style.opacity = String(opacity);
					slot.content.style.width = `${panelW}px`;
					slot.content.style.height = `${panelH}px`;
					slot.content.style.zIndex = String(Math.round(2000 - dist * 10));

					let ti = 0;
					for (let ty = 0; ty < TILE_ROWS; ty++) {
						for (let tx = 0; tx < TILE_COLS; tx++) {
							const tile = slot.tiles[ti++];
							const localU = (tx + 0.5) / TILE_COLS - 0.5; // -0.5..0.5
							const localV = (ty + 0.5) / TILE_ROWS - 0.5;
							const tileLon = lon + localU * PANEL_SPAN_LON;
							const tileLat = lat + localV * PANEL_SPAN_LAT;
							tile.style.width = `${tileW}px`;
							tile.style.height = `${tileH}px`;
							tile.style.transform = sphereTransform(tileLon, tileLat, `scale(${scale})`);
							tile.style.opacity = String(opacity * 0.85);
							tile.style.zIndex = String(Math.round(1000 - dist * 10));
						}
					}
				}
				renderMinimap(centerColInt, centerRowInt);
			}

			function renderMinimap(centerColInt: number, centerRowInt: number) {
				const mm = document.getElementById('minimap')!;
				mm.innerHTML = '';
				for (let r = 0; r < ROWS; r++) {
					for (let c = 0; c < COLS; c++) {
						const cell = document.createElement('div');
						cell.className = 'cell';
						if (mod(r, ROWS) === mod(centerRowInt, ROWS) && mod(c, COLS) === mod(centerColInt, COLS)) {
							cell.classList.add('active');
						}
						mm.appendChild(cell);
					}
				}
			}

			window.addEventListener('resize', render);

			// ---- input: drag (mouse + touch via pointer events) -----------------
			stage.addEventListener('pointerdown', (e) => {
				dragging = true;
				stage.classList.add('grabbing');
				stage.setPointerCapture(e.pointerId);
				startX = e.clientX;
				startY = e.clientY;
				startRawCol = rawCol;
				startRawRow = rawRow;
				velX = velY = 0;
				lastDx = lastDy = 0;
				lastMoveT = performance.now();
				cancelAnim();
			});

			stage.addEventListener('pointermove', (e) => {
				if (!dragging) return;
				const dx = e.clientX - startX;
				const dy = e.clientY - startY;
				const now = performance.now();
				const dt = Math.max(16, now - lastMoveT);
				velX = (dx - lastDx) / dt;
				velY = (dy - lastDy) / dt;
				lastDx = dx;
				lastDy = dy;
				lastMoveT = now;
				rawCol = safe(startRawCol - dx * DRAG_SENSITIVITY);
				rawRow = safe(startRawRow - dy * DRAG_SENSITIVITY);
				render();
			});

			function endDrag() {
				if (!dragging) return;
				dragging = false;
				stage.classList.remove('grabbing');
				const vCol = -velX * DRAG_SENSITIVITY;
				const vRow = -velY * DRAG_SENSITIVITY;
				lockToNearest(vCol, vRow);
			}
			stage.addEventListener('pointerup', endDrag);
			stage.addEventListener('pointercancel', endDrag);
			stage.addEventListener('pointerleave', () => {
				if (dragging) endDrag();
			});

			// ---- input: wheel / trackpad -----------------------------------------
			let wheelSettleTimeout: number | undefined;
			stage.addEventListener(
				'wheel',
				(e) => {
					e.preventDefault();
					cancelAnim();
					rawCol = safe(rawCol + e.deltaX * WHEEL_SENSITIVITY);
					rawRow = safe(rawRow + e.deltaY * WHEEL_SENSITIVITY);
					render();
					clearTimeout(wheelSettleTimeout);
					wheelSettleTimeout = window.setTimeout(() => lockToNearest(0, 0), 110);
				},
				{ passive: false }
			);

			// ---- hard lock on release, with a fling override ----------------------
			// Snaps to the nearest panel — a decisive, brief animation so the
			// arriving panel visibly settles into focus. A fast flick (velocity
			// past FLING_MIN) is biased to advance to the next panel even from a
			// short drag, like a swipe gesture.
			const FLING_MIN = 0.35; // grid units / ms, in *display* terms
			const FLING_BIAS = 0.5;
			function lockToNearest(vCol: number, vRow: number) {
				const biasCol = Math.abs(vCol) > FLING_MIN ? clamp(vCol, -1, 1) * FLING_BIAS : 0;
				const biasRow = Math.abs(vRow) > FLING_MIN ? clamp(vRow, -1, 1) * FLING_BIAS : 0;
				const targetCol = Math.round(rawCol + biasCol);
				const targetRow = Math.round(rawRow + biasRow);
				animateRawTo(targetCol, targetRow);
			}

			// ---- input: keyboard ---------------------------------------------------
			window.addEventListener('keydown', (e) => {
				const step: Record<string, [number, number]> = {
					ArrowLeft: [-1, 0],
					ArrowRight: [1, 0],
					ArrowUp: [0, -1],
					ArrowDown: [0, 1],
				};
				if (step[e.key]) {
					e.preventDefault();
					stepMove(...step[e.key]);
				}
			});

			// ---- edge arrow clicks ---------------------------------------------
			document.getElementById('arrow-up')!.addEventListener('click', () => stepMove(0, -1));
			document.getElementById('arrow-down')!.addEventListener('click', () => stepMove(0, 1));
			document.getElementById('arrow-left')!.addEventListener('click', () => stepMove(-1, 0));
			document.getElementById('arrow-right')!.addEventListener('click', () => stepMove(1, 0));
			document.getElementById('nav-home')!.addEventListener('click', () => animateRawTo(0, 0));

			// true only while chaining discrete arrow/click steps, so rapid key
			// repeats build on the intended target rather than a live, still-
			// animating rawCol; false the rest of the time, where a fresh step
			// should snap off the actual current (rounded) spot
			let stepChaining = false;
			let targetCol = 0;
			let targetRow = 0;

			function stepMove(dc: number, dr: number) {
				const baseCol = stepChaining ? targetCol : Math.round(rawCol);
				const baseRow = stepChaining ? targetRow : Math.round(rawRow);
				animateRawTo(baseCol + dc, baseRow + dr);
				stepChaining = true;
			}

			function cancelAnim() {
				if (animRAF) cancelAnimationFrame(animRAF);
				animRAF = undefined;
			}

			function animateRawTo(nextCol: number, nextRow: number) {
				cancelAnim();
				stepChaining = true;
				targetCol = nextCol;
				targetRow = nextRow;
				const fromCol = rawCol;
				const fromRow = rawRow;
				const dCol = nextCol - fromCol;
				const dRow = nextRow - fromRow;
				const duration = 320;
				const start = performance.now();
				function tick(now: number) {
					const t = clamp((now - start) / duration, 0, 1);
					const eased = 1 - Math.pow(1 - t, 3); // ease-out cubic
					rawCol = fromCol + dCol * eased;
					rawRow = fromRow + dRow * eased;
					render();
					if (t < 1) {
						animRAF = requestAnimationFrame(tick);
					} else {
						rawCol = nextCol;
						rawRow = nextRow;
						render();
						animRAF = undefined;
					}
				}
				animRAF = requestAnimationFrame(tick);
			}

			// ---- nav pill stub links --------------------------------------------
			document.querySelectorAll('#nav a[data-stub]').forEach((a) => {
				a.addEventListener('click', (e) => {
					e.preventDefault();
					a.classList.add('flash');
					setTimeout(() => a.classList.remove('flash'), 250);
					console.log(`stub nav → ${(a as HTMLElement).dataset.stub}`);
				});
			});

			render();
		</script>
	</body>
</html>
