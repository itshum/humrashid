---
// Low-fidelity prototype: sphere/orbit navigation mechanic.
// Testing real content formats now: a Safari-style browser panel (live
// iframe + hover-to-visit), a Mobbin-style card (media block + headline +
// subtext), and a Polaroid-style photo panel with camera metadata. Panels
// vary in size by content kind. Positioning is still a true sphere
// (longitude/latitude per panel), with resistance-then-hard-lock dragging
// and an infinite loop on both axes.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>concept — orbit nav</title>
		<meta name="robots" content="noindex" />
		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				overflow: hidden;
				background: #fff;
				font-family: system-ui, -apple-system, sans-serif;
				color: #111;
				touch-action: none;
			}

			#stage {
				position: fixed;
				inset: 0;
				perspective: 1600px;
				perspective-origin: 50% 50%;
				cursor: grab;
			}
			#stage.grabbing {
				cursor: grabbing;
			}

			#field {
				position: absolute;
				inset: 0;
				transform-style: preserve-3d;
			}

			/* outer wrapper: JS-controlled sphere position/rotation/scale only */
			.panel-wrap {
				position: absolute;
				top: 50%;
				left: 50%;
				will-change: transform, opacity;
			}

			/* inner surface: carries the idle float + shadow, composes with the
			   outer transform instead of fighting it for the same property */
			.panel-surface {
				width: 100%;
				height: 100%;
				border-radius: 14px;
				animation: floaty 6s ease-in-out infinite;
				transition: box-shadow 300ms ease;
			}
			@keyframes floaty {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-8px);
				}
			}

			/* ---- home ---- */
			.k-home .panel-surface {
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 24px;
			}
			.k-home .home-label {
				font-size: clamp(22px, 3vw, 34px);
				color: #111;
				font-weight: 500;
				line-height: 1.25;
			}

			/* ---- card: Mobbin-style — media block, then headline + subtext below ---- */
			.k-card .panel-surface {
				display: flex;
				flex-direction: column;
				gap: 14px;
				pointer-events: auto;
			}
			.card-media {
				flex: 1;
				border-radius: 12px;
				background: #ececec;
				background-size: cover;
				background-position: center;
				position: relative;
			}
			.card-media .tag {
				position: absolute;
				top: 10px;
				left: 10px;
				background: rgba(0, 0, 0, 0.55);
				color: #fff;
				font-size: 10px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 3px 9px;
				border-radius: 999px;
			}
			.card-text {
				padding: 0 2px;
			}
			.card-title {
				font-size: 17px;
				font-weight: 600;
				color: #111;
				margin-bottom: 4px;
			}
			.card-subtitle {
				font-size: 13px;
				color: #999;
				line-height: 1.4;
			}

			/* ---- browser: Safari chrome + live iframe + hover-to-visit ---- */
			.k-browser .panel-surface {
				display: flex;
				flex-direction: column;
				background: #fff;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid #e2e2e2;
				pointer-events: auto;
			}
			.browser-chrome {
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 10px 12px;
				background: #f4f4f4;
				border-bottom: 1px solid #e6e6e6;
			}
			.browser-dots {
				display: flex;
				gap: 6px;
			}
			.browser-dots span {
				width: 9px;
				height: 9px;
				border-radius: 999px;
				background: #ddd;
			}
			.browser-url {
				flex: 1;
				background: #fff;
				border: 1px solid #e6e6e6;
				border-radius: 6px;
				padding: 3px 10px;
				font-size: 11px;
				color: #999;
				text-align: center;
			}
			.browser-body {
				position: relative;
				flex: 1;
				background: #fafafa;
			}
			.browser-body iframe {
				width: 100%;
				height: 100%;
				border: 0;
				display: block;
				pointer-events: none; /* the iframe never steals the drag */
			}
			.browser-visit {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(255, 255, 255, 0);
				opacity: 0;
				transition: opacity 200ms, background 200ms;
				text-decoration: none;
				pointer-events: none;
			}
			.k-browser .panel-surface:hover .browser-visit {
				opacity: 1;
				background: rgba(255, 255, 255, 0.55);
				pointer-events: auto;
			}
			.browser-visit-icon {
				width: 52px;
				height: 52px;
				border-radius: 999px;
				background: #111;
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
				transform: scale(0.85);
				transition: transform 200ms;
			}
			.k-browser .panel-surface:hover .browser-visit-icon {
				transform: scale(1);
			}

			/* ---- video: looping muted clip, same card shell as .k-card ---- */
			.k-video .panel-surface {
				display: flex;
				flex-direction: column;
				gap: 14px;
				pointer-events: auto;
			}
			.video-media {
				flex: 1;
				border-radius: 12px;
				overflow: hidden;
				position: relative;
				background: #000;
			}
			.video-media video {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.video-badge {
				position: absolute;
				top: 10px;
				left: 10px;
				background: rgba(0, 0, 0, 0.55);
				color: #fff;
				font-size: 10px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 3px 9px;
				border-radius: 999px;
			}

			/* ---- photo: polaroid-style frame + camera metadata caption ---- */
			.k-photo .panel-surface {
				background: #fff;
				border-radius: 4px;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
				padding: 14px 14px 0;
				display: flex;
				flex-direction: column;
			}
			.photo-image {
				flex: 1;
				border-radius: 2px;
			}
			.photo-caption {
				padding: 12px 4px 16px;
			}
			.photo-meta-camera {
				font-size: 12px;
				color: #666;
				font-weight: 500;
			}
			.photo-meta-line {
				font-size: 11px;
				color: #aaa;
				margin-top: 2px;
			}

			.coord {
				position: absolute;
				bottom: 6px;
				right: 8px;
				font-size: 9px;
				color: #ccc;
				z-index: 5;
			}

			/* edge affordance arrows */
			.edge-arrow {
				position: fixed;
				z-index: 30;
				background: none;
				border: none;
				cursor: pointer;
				color: #999;
				padding: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: opacity 150ms;
			}
			.edge-arrow:hover {
				color: #111;
			}
			.edge-arrow svg {
				width: 22px;
				height: 22px;
			}
			#arrow-up {
				top: 18px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-down {
				bottom: 96px;
				left: 50%;
				transform: translateX(-50%);
			}
			#arrow-left {
				left: 18px;
				top: 50%;
				transform: translateY(-50%);
			}
			#arrow-right {
				right: 18px;
				top: 50%;
				transform: translateY(-50%);
			}

			/* floating nav pill, Mobbin-style, fixed bottom center */
			#nav {
				position: fixed;
				bottom: 28px;
				left: 50%;
				transform: translateX(-50%);
				z-index: 40;
				display: flex;
				align-items: center;
				gap: 4px;
				padding: 8px;
				background: rgba(255, 255, 255, 0.85);
				backdrop-filter: blur(12px);
				border: 1px solid #e5e5e5;
				border-radius: 999px;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
			}
			#nav button.dot {
				width: 34px;
				height: 34px;
				border-radius: 999px;
				border: none;
				background: #f0f0f0;
				cursor: pointer;
				font-size: 12px;
				color: #666;
			}
			#nav a {
				padding: 8px 16px;
				border-radius: 999px;
				text-decoration: none;
				color: #333;
				font-size: 14px;
				transition: background 120ms;
			}
			#nav a:hover {
				background: #f0f0f0;
			}
			#nav a.flash {
				background: #111;
				color: #fff;
			}

			#hint {
				position: fixed;
				top: 18px;
				left: 18px;
				font-size: 11px;
				color: #bbb;
				z-index: 30;
				max-width: 230px;
				line-height: 1.5;
			}

			#minimap {
				position: fixed;
				bottom: 96px;
				right: 24px;
				z-index: 30;
				display: grid;
				grid-template-columns: repeat(6, 6px);
				grid-auto-rows: 6px;
				gap: 4px;
			}
			#minimap .cell {
				width: 6px;
				height: 6px;
				border-radius: 999px;
				background: #e5e5e5;
			}
			#minimap .cell.active {
				background: #111;
			}
		</style>
	</head>
	<body>
		<div id="hint">
			drag / scroll / swipe to look around · arrow keys work too<br />
			loops forever both ways · flows freely, with just a hint of resistance passing center
		</div>

		<div id="stage">
			<div id="field"></div>
		</div>

		<button class="edge-arrow" id="arrow-up" aria-label="pan up">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 19V5M5 12l7-7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-down" aria-label="pan down">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M12 5v14M5 12l7 7 7-7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-left" aria-label="pan left">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M19 12H5M12 5l-7 7 7 7" /></svg
			>
		</button>
		<button class="edge-arrow" id="arrow-right" aria-label="pan right">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M5 12h14M12 5l7 7-7 7" /></svg
			>
		</button>

		<div id="minimap"></div>

		<nav id="nav">
			<button class="dot" id="nav-home" title="recenter">◎</button>
			<a href="#" data-stub="/work">Work</a>
			<a href="#" data-stub="/ideas">Ideas</a>
			<a href="#" data-stub="/about">About</a>
		</nav>

		<script>
			// ---- content model -------------------------------------------------
			// A torus: both axes loop forever. Row 0 / col 0 is "home". Every
			// item now carries its own kind + size — panels are no longer
			// uniform, they vary by what they're showing.
			const COLS = 6;
			const ROWS = 3;

			type Sized = { w: number; h: number };
			type HomeItem = Sized & { kind: 'home'; title: string };
			type CardItem = Sized & { kind: 'card'; tag: string; title: string; subtitle: string; seed: string };
			type BrowserItem = Sized & { kind: 'browser'; url: string; display: string };
			type PhotoItem = Sized & { kind: 'photo'; tone: string; camera: string; meta: string };
			type VideoItem = Sized & { kind: 'video'; title: string; subtitle: string };
			type Item = HomeItem | CardItem | BrowserItem | PhotoItem | VideoItem;

			const SM: Sized = { w: 280, h: 220 };
			const MD: Sized = { w: 380, h: 300 };
			const LG: Sized = { w: 520, h: 380 };
			const BROWSER: Sized = { w: 560, h: 380 };
			const PHOTO: Sized = { w: 300, h: 400 };
			const VIDEO: Sized = { w: 420, h: 320 };

			// a couple of small, freely-embeddable public sample clips (CC0/MDN
			// demo assets) — stand-ins to test the video-panel format, not final
			// content
			const CLIP_A = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4';
			const CLIP_B = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/friday.mp4';

			function card(tag: string, title: string, subtitle: string, seed: string, size: Sized): CardItem {
				return { kind: 'card', tag, title, subtitle, seed, ...size };
			}

			const rowsByIndex: Item[][] = [
				[
					{ kind: 'home', title: 'Humayun Rashid is a designer & founder in NYC.', ...LG },
					card('case study', 'Sublime Security', 'Quarantine digests & phishing simulations for the fastest-growing email security startup in the US.', 'sublime', MD),
					{ kind: 'browser', url: 'https://rendr.app', display: 'rendr.app', ...BROWSER },
					{ kind: 'photo', tone: '#d8d2c4', camera: 'Fujifilm X100V', meta: 'Brooklyn, NY · Sep 2024', ...PHOTO },
					card('case study', 'Atrium', 'A quiet home for books and articles worth remembering.', 'atrium', MD),
					{ kind: 'video', title: 'Reel — process', subtitle: 'A short cut of how the Sublime rebrand came together.', ...VIDEO },
				],
				[
					card('about', 'About — the longer version', 'A decade of B2B SaaS and eCommerce design, and what I care about now.', 'about-me', LG),
					card('ideas', 'Ideas — writing & notes', 'Short essays on onboarding, empty states, and saying no.', 'ideas-notes', MD),
					{ kind: 'video', title: 'Talk — five users', subtitle: 'A clip from a workshop on user interviews.', ...VIDEO },
					{ kind: 'photo', tone: '#c9d0c6', camera: 'Kodak Gold 200', meta: 'Prospect Park · Jun 2024', ...PHOTO },
					{ kind: 'browser', url: 'https://www.humrashid.com', display: 'humrashid.com', ...BROWSER },
					card('writing', 'Principles', 'A running list of rules I design by.', 'principles', SM),
				],
				[
					{ kind: 'photo', tone: '#dcd6cf', camera: 'iPhone 15 Pro', meta: 'Lower Manhattan · Mar 2024', ...PHOTO },
					card('experiment', 'Pack hover takeover', 'A hover state that takes over the whole viewport.', 'pack-hover', MD),
					card('image', 'Type test', 'Testing a condensed grotesk at display sizes.', 'type-test', SM),
					{ kind: 'browser', url: 'https://example.com', display: 'example.com', ...BROWSER },
					card('link', 'dribbble ↗', 'Shots and works-in-progress.', 'dribbble', SM),
					card('image', 'Color study', 'Palette exploration for the Atrium footer.', 'color-study', SM),
				],
			];

			function mod(n: number, m: number) {
				return ((n % m) + m) % m;
			}
			function hashCode(s: string): number {
				let h = 0;
				for (let i = 0; i < s.length; i++) h = (h << 5) - h + s.charCodeAt(i);
				return h;
			}
			function itemAt(col: number, row: number): Item {
				return rowsByIndex[mod(row, ROWS)][mod(col, COLS)];
			}
			function safe(n: number): number {
				return Number.isFinite(n) ? n : 0;
			}
			function clamp(v: number, lo: number, hi: number) {
				return Math.min(hi, Math.max(lo, v));
			}

			// ---- true spherical placement -----------------------------------------
			// Tighter spacing than before — the point is for neighboring panels
			// to visibly peek in at the top/bottom/left/right edges of the
			// viewport at rest, so it reads as "there's more this way" rather
			// than an empty field around one centered panel.
			const SPHERE_R = 1150; // px
			const DEG_PER_COL = 20; // longitude degrees between adjacent panel centers
			const DEG_PER_ROW = 16; // latitude degrees between adjacent panel centers

			function sphereTransform(lonDeg: number, latDeg: number, extra = ''): string {
				const lon = (clamp(lonDeg, -85, 85) * Math.PI) / 180;
				const lat = (clamp(latDeg, -85, 85) * Math.PI) / 180;
				const x = SPHERE_R * Math.sin(lon) * Math.cos(lat);
				const y = SPHERE_R * Math.sin(lat);
				const z = SPHERE_R * (Math.cos(lon) * Math.cos(lat) - 1);
				// rotate so each panel's own surface normal points radially
				// outward from the sphere's center — the surface bulges toward
				// the viewer at the front pole and curves away at the edges,
				// like the front half of a globe, not a bowl caving inward.
				return `translate(-50%, -50%) translate3d(${x}px, ${y}px, ${z}px) rotateY(${lonDeg}deg) rotateX(${-latDeg}deg) ${extra}`;
			}

			// ---- state -----------------------------------------------------------
			let rawCol = 0;
			let rawRow = 0;
			let dragging = false;
			let startX = 0,
				startY = 0,
				startRawCol = 0,
				startRawRow = 0;
			let velX = 0,
				velY = 0,
				lastMoveT = 0,
				lastDx = 0,
				lastDy = 0;
			let animRAF: number | undefined;

			const DRAG_SENSITIVITY = 1 / 420;
			const WHEEL_SENSITIVITY = 1 / 900;

			// Only a light detent at each integer, not a hard lock — RESISTANCE_MIX
			// close to 0 would be pure free-flowing linear motion; keep it low so
			// you feel just the slightest hesitation passing a centered panel,
			// then it's back to plain, direct tracking.
			const RESISTANCE_MIX = 0.22;
			function easeInOutCubic(t: number): number {
				return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
			}
			function applyResistance(raw: number): number {
				const base = Math.floor(raw);
				const frac = raw - base;
				const eased = easeInOutCubic(frac);
				return base + frac + (eased - frac) * RESISTANCE_MIX;
			}

			const field = document.getElementById('field') as HTMLDivElement;
			const stage = document.getElementById('stage') as HTMLDivElement;

			// Only a cross of 5 panels is ever rendered: center + one neighbor in
			// each cardinal direction. No diagonals, no grid.
			type Slot = { wrap: HTMLDivElement; surface: HTMLDivElement; key: string; dc: number; dr: number };
			const slots: Slot[] = [];
			function makeSlot(dc: number, dr: number): Slot {
				const wrap = document.createElement('div');
				wrap.className = 'panel-wrap';
				const surface = document.createElement('div');
				surface.className = 'panel-surface';
				wrap.appendChild(surface);
				field.appendChild(wrap);
				return { wrap, surface, key: '', dc, dr };
			}
			slots.push(makeSlot(-1, 0), makeSlot(0, 0), makeSlot(1, 0), makeSlot(0, -1), makeSlot(0, 1));

			function buildSurface(item: Item): string {
				if (item.kind === 'home') {
					return `<div class="home-label">${item.title}</div>`;
				}
				if (item.kind === 'card') {
					const bg = `https://picsum.photos/seed/${encodeURIComponent(item.seed)}/${item.w * 2}/${Math.round((item.h - 90) * 2)}`;
					return `
						<div class="card-media" style="background-image:url('${bg}')"><span class="tag">${item.tag}</span></div>
						<div class="card-text">
							<div class="card-title">${item.title}</div>
							<div class="card-subtitle">${item.subtitle}</div>
						</div>`;
				}
				if (item.kind === 'video') {
					const src = Math.abs(hashCode(item.title)) % 2 === 0 ? CLIP_A : CLIP_B;
					return `
						<div class="video-media">
							<video autoplay muted loop playsinline src="${src}"></video>
							<span class="video-badge">video</span>
						</div>
						<div class="card-text">
							<div class="card-title">${item.title}</div>
							<div class="card-subtitle">${item.subtitle}</div>
						</div>`;
				}
				if (item.kind === 'browser') {
					return `
						<div class="browser-chrome">
							<div class="browser-dots"><span></span><span></span><span></span></div>
							<div class="browser-url">${item.display}</div>
						</div>
						<div class="browser-body">
							<iframe src="${item.url}" loading="lazy" referrerpolicy="no-referrer"></iframe>
							<a class="browser-visit" href="${item.url}" target="_blank" rel="noopener">
								<span class="browser-visit-icon">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M7 17L17 7M17 7H9M17 7V15" />
									</svg>
								</span>
							</a>
						</div>`;
				}
				// photo
				return `
					<div class="photo-image" style="background:${item.tone}"></div>
					<div class="photo-caption">
						<div class="photo-meta-camera">${item.camera}</div>
						<div class="photo-meta-line">${item.meta}</div>
					</div>`;
			}

			function render() {
				const panCol = applyResistance(rawCol);
				const panRow = applyResistance(rawRow);
				const centerColInt = Math.round(panCol);
				const centerRowInt = Math.round(panRow);

				for (const slot of slots) {
					const c = centerColInt + slot.dc;
					const r = centerRowInt + slot.dr;
					const key = `${c},${r}`;
					if (slot.key !== key) {
						const item = itemAt(c, r);
						slot.surface.innerHTML = buildSurface(item) + `<div class="coord">${c},${r}</div>`;
						slot.wrap.className = `panel-wrap k-${item.kind}`;
						slot.wrap.style.width = `${item.w}px`;
						slot.wrap.style.height = `${item.h}px`;
						slot.key = key;
					}

					const dCol = c - panCol;
					const dRow = r - panRow;
					const dist = Math.sqrt(dCol * dCol + dRow * dRow);
					// gentler falloff than before — neighbors should still read
					// clearly as "there's more this way", not fade to near-nothing
					const scale = clamp(1.08 - dist * 0.28, 0.62, 1.08);
					const opacity = clamp(1 - dist * 0.32, 0.35, 1);
					const lon = dCol * DEG_PER_COL;
					const lat = dRow * DEG_PER_ROW;

					slot.wrap.style.transform = sphereTransform(lon, lat, `scale(${scale})`);
					slot.wrap.style.opacity = String(opacity);
					slot.wrap.style.zIndex = String(Math.round(2000 - dist * 10));

					// floating depth: very subtle — a hint of lift, not a heavy
					// drop shadow. The hover-to-visit affordance on browser
					// panels is untouched.
					const lift = clamp(1 - dist, 0, 1);
					slot.surface.style.boxShadow = `0 ${5 * lift + 2}px ${16 * lift + 5}px rgba(0,0,0,${0.03 + 0.05 * lift})`;
				}
				renderMinimap(centerColInt, centerRowInt);
			}

			function renderMinimap(centerColInt: number, centerRowInt: number) {
				const mm = document.getElementById('minimap')!;
				mm.innerHTML = '';
				for (let r = 0; r < ROWS; r++) {
					for (let c = 0; c < COLS; c++) {
						const cell = document.createElement('div');
						cell.className = 'cell';
						if (mod(r, ROWS) === mod(centerRowInt, ROWS) && mod(c, COLS) === mod(centerColInt, COLS)) {
							cell.classList.add('active');
						}
						mm.appendChild(cell);
					}
				}
			}

			// ---- input: drag (mouse + touch via pointer events) -----------------
			// Listens on #stage, but panels are pointer-events:auto (so hover/
			// click work on browser panels) — pointerdown on a panel still
			// bubbles up to this handler since nothing stops propagation.
			stage.addEventListener('pointerdown', (e) => {
				dragging = true;
				stage.classList.add('grabbing');
				stage.setPointerCapture(e.pointerId);
				startX = e.clientX;
				startY = e.clientY;
				startRawCol = rawCol;
				startRawRow = rawRow;
				velX = velY = 0;
				lastDx = lastDy = 0;
				lastMoveT = performance.now();
				cancelAnim();
			});

			stage.addEventListener('pointermove', (e) => {
				if (!dragging) return;
				const dx = e.clientX - startX;
				const dy = e.clientY - startY;
				const now = performance.now();
				const dt = Math.max(16, now - lastMoveT);
				velX = (dx - lastDx) / dt;
				velY = (dy - lastDy) / dt;
				lastDx = dx;
				lastDy = dy;
				lastMoveT = now;
				rawCol = safe(startRawCol - dx * DRAG_SENSITIVITY);
				rawRow = safe(startRawRow - dy * DRAG_SENSITIVITY);
				render();
			});

			function endDrag() {
				if (!dragging) return;
				dragging = false;
				stage.classList.remove('grabbing');
				const vCol = -velX * DRAG_SENSITIVITY;
				const vRow = -velY * DRAG_SENSITIVITY;
				startCoast(vCol, vRow);
			}
			stage.addEventListener('pointerup', endDrag);
			stage.addEventListener('pointercancel', endDrag);
			stage.addEventListener('pointerleave', () => {
				if (dragging) endDrag();
			});

			// ---- input: wheel / trackpad -----------------------------------------
			stage.addEventListener(
				'wheel',
				(e) => {
					e.preventDefault();
					cancelAnim();
					rawCol = safe(rawCol + e.deltaX * WHEEL_SENSITIVITY);
					rawRow = safe(rawRow + e.deltaY * WHEEL_SENSITIVITY);
					render();
				},
				{ passive: false }
			);

			// ---- free momentum coast on release — no forced snap ------------------
			// Dragging is direct 1:1 tracking (through the light detent above);
			// letting go just carries that motion on with friction until it
			// naturally comes to rest, wherever that is — it is not pulled to
			// the nearest panel. Keyboard/arrow controls still jump exactly one
			// panel via animateRawTo, since those are deliberate discrete actions.
			const FRICTION_PER_16MS = 0.9;
			function startCoast(vCol: number, vRow: number) {
				cancelAnim();
				let vC = clamp(vCol, -2.5, 2.5);
				let vR = clamp(vRow, -2.5, 2.5);
				let lastT = performance.now();
				function frame(now: number) {
					const dt = Math.min(48, now - lastT);
					lastT = now;
					rawCol = safe(rawCol + vC * dt);
					rawRow = safe(rawRow + vR * dt);
					const decay = Math.pow(FRICTION_PER_16MS, dt / 16.67);
					vC *= decay;
					vR *= decay;
					render();
					if (Math.abs(vC) > 0.00005 || Math.abs(vR) > 0.00005) {
						animRAF = requestAnimationFrame(frame);
					} else {
						targetCol = Math.round(rawCol);
						targetRow = Math.round(rawRow);
						stepChaining = true;
						animRAF = undefined;
					}
				}
				animRAF = requestAnimationFrame(frame);
			}

			// ---- input: keyboard ---------------------------------------------------
			window.addEventListener('keydown', (e) => {
				const step: Record<string, [number, number]> = {
					ArrowLeft: [-1, 0],
					ArrowRight: [1, 0],
					ArrowUp: [0, -1],
					ArrowDown: [0, 1],
				};
				if (step[e.key]) {
					e.preventDefault();
					stepMove(...step[e.key]);
				}
			});

			// ---- edge arrow clicks ---------------------------------------------
			document.getElementById('arrow-up')!.addEventListener('click', () => stepMove(0, -1));
			document.getElementById('arrow-down')!.addEventListener('click', () => stepMove(0, 1));
			document.getElementById('arrow-left')!.addEventListener('click', () => stepMove(-1, 0));
			document.getElementById('arrow-right')!.addEventListener('click', () => stepMove(1, 0));
			document.getElementById('nav-home')!.addEventListener('click', () => animateRawTo(0, 0));

			let stepChaining = false;
			let targetCol = 0;
			let targetRow = 0;

			function stepMove(dc: number, dr: number) {
				const baseCol = stepChaining ? targetCol : Math.round(rawCol);
				const baseRow = stepChaining ? targetRow : Math.round(rawRow);
				animateRawTo(baseCol + dc, baseRow + dr);
				stepChaining = true;
			}

			function cancelAnim() {
				if (animRAF) cancelAnimationFrame(animRAF);
				animRAF = undefined;
			}

			function animateRawTo(nextCol: number, nextRow: number) {
				cancelAnim();
				stepChaining = true;
				targetCol = nextCol;
				targetRow = nextRow;
				const fromCol = rawCol;
				const fromRow = rawRow;
				const dCol = nextCol - fromCol;
				const dRow = nextRow - fromRow;
				const duration = 320;
				const start = performance.now();
				function tick(now: number) {
					const t = clamp((now - start) / duration, 0, 1);
					const eased = 1 - Math.pow(1 - t, 3);
					rawCol = fromCol + dCol * eased;
					rawRow = fromRow + dRow * eased;
					render();
					if (t < 1) {
						animRAF = requestAnimationFrame(tick);
					} else {
						rawCol = nextCol;
						rawRow = nextRow;
						render();
						animRAF = undefined;
					}
				}
				animRAF = requestAnimationFrame(tick);
			}

			// ---- nav pill stub links --------------------------------------------
			document.querySelectorAll('#nav a[data-stub]').forEach((a) => {
				a.addEventListener('click', (e) => {
					e.preventDefault();
					a.classList.add('flash');
					setTimeout(() => a.classList.remove('flash'), 250);
					console.log(`stub nav → ${(a as HTMLElement).dataset.stub}`);
				});
			});

			render();
		</script>
	</body>
</html>
